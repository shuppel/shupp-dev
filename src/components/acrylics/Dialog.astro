---
interface Props { id: string; title: string; class?: string; }
const { id, title, class: className = '' } = Astro.props;
---
<dialog id={id} class:list={['ac-dialog', className]} aria-labelledby={`${id}-title`}>
  <div class="dialog-top"><span class="eyebrow">ACRYLICS / SHUPP.DEV</span><form method="dialog"><button class="close-button" aria-label={`Close ${title}`}>✕</button></form></div>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</dialog>
