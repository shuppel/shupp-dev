---
// Small pixel glyphs for the reading pages, drawn on a grid so they sit with
// the game's 16px sprites. Each glyph is rows of characters: '#' is the main
// colour (currentColor), '+' is the accent, anything else is empty. Rendered
// as crisp SVG rects so they stay sharp at any size.

type GlyphName = 'diamond' | 'nebula' | 'protostar' | 'star' | 'galaxy' | 'clock' | 'quill' | 'eye' | 'arrow' | 'back' | 'braces' | 'link' | 'spark';

interface Props {
  name: GlyphName;
  size?: number;
  label?: string;
  class?: string;
}

const GLYPHS: Record<GlyphName, string[]> = {
  diamond: [
    '...#...',
    '..#+#..',
    '.#+++#.',
    '#+++++#',
    '.#+++#.',
    '..#+#..',
    '...#...',
  ],
  nebula: [
    '..+..#..',
    '.#.##.+.',
    '#.#..#..',
    '.#.++.#.',
    '..#++#.#',
    '#..##.#.',
    '.+....#.',
    '...#+...',
  ],
  protostar: [
    '...+....',
    '...#....',
    '..###...',
    '+##+##+.',
    '..###...',
    '...#....',
    '...+....',
    '........',
  ],
  star: [
    '...#....',
    '...#....',
    '..#+#...',
    '##+++##.',
    '.#+++#..',
    '.#+.+#..',
    '#.....#.',
    '........',
  ],
  galaxy: [
    '..####..',
    '.#....#.',
    '#..++..#',
    '#.+##+.#',
    '#.+##+.#',
    '#..++..#',
    '.#....#.',
    '..####..',
  ],
  clock: [
    '..####..',
    '.#....#.',
    '#...+..#',
    '#...+..#',
    '#...++.#',
    '#......#',
    '.#....#.',
    '..####..',
  ],
  quill: [
    '......##',
    '.....#+#',
    '....#+#.',
    '...#+#..',
    '..#+#...',
    '.#+#....',
    '.##.....',
    '#.......',
  ],
  eye: [
    '........',
    '..####..',
    '.#.++.#.',
    '#.+##+.#',
    '#.+##+.#',
    '.#.++.#.',
    '..####..',
    '........',
  ],
  arrow: [
    '....#...',
    '....##..',
    '#######.',
    '########',
    '#######.',
    '....##..',
    '....#...',
  ],
  back: [
    '...#....',
    '..##....',
    '.#######',
    '########',
    '.#######',
    '..##....',
    '...#....',
  ],
  braces: [
    '.##..##.',
    '.#....#.',
    '.#....#.',
    '#..++..#',
    '.#....#.',
    '.#....#.',
    '.##..##.',
  ],
  link: [
    '........',
    '.###....',
    '#...#...',
    '#..+#+..',
    '..+#..#.',
    '...#...#',
    '....###.',
    '........',
  ],
  spark: [
    '..#..',
    '..+..',
    '#+++#',
    '..+..',
    '..#..',
  ],
};

const { name, size = 16, label, class: className } = Astro.props;
const rows = GLYPHS[name];
const w = Math.max(...rows.map((r) => r.length));
const h = rows.length;
const cells: { x: number; y: number; accent: boolean }[] = [];
rows.forEach((row, y) =>
  [...row].forEach((c, x) => {
    if (c === '#' || c === '+') cells.push({ x, y, accent: c === '+' });
  }),
);
---

<svg
  class:list={['px-glyph', className]}
  width={size}
  height={Math.round((size * h) / w)}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {cells.map((c) => (
    <rect x={c.x} y={c.y} width="1" height="1" fill={c.accent ? 'var(--px-accent, currentColor)' : 'currentColor'} />
  ))}
</svg>
