---
import DiagramFrame from './DiagramFrame.astro';
---

<DiagramFrame
  title="Paged address translation"
  caption="The virtual page number indexes the page table; the offset passes through untouched. A cleared present bit means the page lives in the backing store — the access traps to the OS, which fetches the page and retries."
>
  <svg viewBox="0 0 800 330" role="img" aria-label="Flow diagram of a virtual address being translated through a page table into a physical address">
    <defs>
      <marker id="at-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-head" />
      </marker>
    </defs>

    <!-- Virtual address -->
    <text x="130" y="52" class="block-title">Virtual address</text>
    <rect x="30" y="66" width="130" height="48" class="cell cell-key" />
    <rect x="160" y="66" width="100" height="48" class="cell" />
    <text x="95" y="87" class="cell-name">page #</text>
    <text x="95" y="104" class="cell-sub">high bits</text>
    <text x="210" y="87" class="cell-name">offset</text>
    <text x="210" y="104" class="cell-sub">low bits</text>

    <!-- Page table -->
    <text x="435" y="30" class="block-title">Page table</text>
    <rect x="340" y="44" width="190" height="36" class="cell" />
    <rect x="340" y="80" width="190" height="36" class="cell cell-hit" />
    <rect x="340" y="116" width="190" height="36" class="cell" />
    <rect x="340" y="152" width="190" height="36" class="cell cell-miss" />
    <text x="400" y="66" class="cell-sub">frame 7 · P=1 W=0</text>
    <text x="400" y="102" class="cell-name">frame 3 · P=1 W=1</text>
    <text x="400" y="138" class="cell-sub">frame 9 · P=1 W=1</text>
    <text x="400" y="174" class="cell-sub">— · P=0 (on disk)</text>
    <text x="490" y="102" class="cell-badge">hit</text>
    <text x="490" y="174" class="cell-badge">fault</text>

    <!-- Physical address -->
    <text x="680" y="52" class="block-title">Physical address</text>
    <rect x="580" y="66" width="130" height="48" class="cell cell-key" />
    <rect x="710" y="66" width="80" height="48" class="cell" />
    <text x="645" y="87" class="cell-name">frame #</text>
    <text x="645" y="104" class="cell-sub">from table</text>
    <text x="750" y="87" class="cell-name">offset</text>
    <text x="750" y="104" class="cell-sub">copied</text>

    <!-- page # -> table row -->
    <path d="M 260 90 C 296 90, 304 98, 336 98" class="edge" marker-end="url(#at-arrow)" />
    <text x="298" y="78" class="edge-label">index</text>

    <!-- table row -> frame # -->
    <path d="M 530 98 C 552 98, 554 90, 576 90" class="edge" marker-end="url(#at-arrow)" />

    <!-- offset -> offset (bypasses the table) -->
    <path d="M 210 114 C 210 235, 750 235, 750 118" class="edge edge-dashed" marker-end="url(#at-arrow)" />
    <text x="480" y="252" class="edge-label">offset bypasses translation</text>

    <!-- fault path -->
    <path d="M 405 188 C 405 220, 380 244, 348 262" class="edge edge-fault" marker-end="url(#at-arrow)" />
    <rect x="96" y="262" width="252" height="46" rx="8" class="fault-box" />
    <text x="222" y="282" class="fault-text">page fault: trap to OS,</text>
    <text x="222" y="299" class="fault-text">fetch from backing store, retry</text>
  </svg>
</DiagramFrame>

<style>
  .block-title {
    fill: var(--text-color);
    font-size: 14px;
    font-weight: 700;
    text-anchor: middle;
  }

  .cell {
    fill: var(--surface-muted);
    stroke: var(--color-tertiary);
    stroke-width: 1.25;
  }

  .cell-key {
    fill: var(--hover-tint);
  }

  .cell-hit {
    fill: var(--hover-tint);
    stroke-width: 2.25;
  }

  .cell-miss {
    stroke-dasharray: 4 3;
  }

  .cell-name {
    fill: var(--text-color);
    font-size: 13.5px;
    font-weight: 700;
    text-anchor: middle;
  }

  .cell-sub {
    fill: var(--text-muted);
    font-size: 11.5px;
    text-anchor: middle;
  }

  .cell-badge {
    fill: var(--text-muted);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-anchor: start;
  }

  .edge {
    fill: none;
    stroke: var(--color-tertiary);
    stroke-width: 1.75;
  }

  .edge-dashed {
    stroke-dasharray: 5 4;
  }

  .edge-fault {
    stroke-dasharray: 3 3;
  }

  .arrow-head {
    fill: var(--color-tertiary);
  }

  .edge-label {
    fill: var(--text-muted);
    font-size: 12px;
    text-anchor: middle;
  }

  .fault-box {
    fill: none;
    stroke: var(--color-tertiary);
    stroke-width: 1.25;
    stroke-dasharray: 4 3;
  }

  .fault-text {
    fill: var(--text-muted);
    font-size: 12.5px;
    text-anchor: middle;
  }
</style>
