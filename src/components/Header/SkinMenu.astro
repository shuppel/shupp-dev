---
// Appearance menu — renders the site in its own dress, in PRISM, or in VOID.
// The skin itself is applied pre-paint by the inline boot script in Layout;
// this is only the control that writes the preference and re-applies it.
const skins = [
  { id: 'site', label: 'shupp.dev', note: 'the site’s own dress' },
  { id: 'prism', label: 'Prismatic', note: 'light-first, day / redshift' },
  { id: 'void', label: 'Void', note: 'ceramic, night / day' },
];
---

<div class="skin-menu" data-skin-menu>
  <button
    type="button"
    class="skin-trigger"
    data-skin-trigger
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="skin-panel"
    aria-label="Appearance"
    title="Appearance"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="2" />
      <path d="M12 3.5 a8.5 8.5 0 0 1 0 17 z" fill="currentColor" />
    </svg>
  </button>

  <div class="skin-panel" id="skin-panel" role="menu" aria-label="Appearance" hidden>
    <p class="skin-panel-title">Appearance</p>
    {skins.map((s) => (
      <button
        type="button"
        class="skin-option"
        role="menuitemradio"
        aria-checked={s.id === 'site' ? 'true' : 'false'}
        data-skin-option={s.id}
      >
        <span class="skin-check" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
            <path d="M5.75 12.5 L10 16.75 L18.25 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="skin-label">
          <b>{s.label}</b>
          <small>{s.note}</small>
        </span>
      </button>
    ))}
    <p class="skin-panel-foot" data-skin-foot></p>
  </div>
</div>

<style>
  .skin-menu { position: relative; flex-shrink: 0; }

  /* token-driven rather than a per-theme override, so the control
     follows whichever skin is active without another rule */
  .skin-trigger {
    background: transparent;
    border: 1.5px solid color-mix(in srgb, var(--text-light) 45%, transparent);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--text-light);
  }

  .skin-trigger:hover { background-color: var(--hover-tint); }

  .skin-trigger:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* the side nav is 240px and clips its overflow, so the panel is centred
     on the trigger rather than left-aligned to it */
  .skin-panel {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    width: 206px;
    padding: 0.4rem;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--card-shadow);
  }

  .skin-panel[hidden] { display: none; }

  .skin-panel-title,
  .skin-panel-foot {
    margin: 0.35rem 0.6rem 0.5rem;
    font-family: var(--font-secondary-header);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .skin-panel-foot {
    margin: 0.5rem 0.6rem 0.3rem;
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .skin-panel-foot:empty { display: none; }

  .skin-option {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-color);
    text-align: left;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .skin-option:hover { background: var(--hover-tint); }

  .skin-option:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .skin-check {
    width: 14px;
    height: 14px;
    margin-top: 2px;
    flex-shrink: 0;
    color: var(--primary-color);
    opacity: 0;
  }

  .skin-option[aria-checked='true'] .skin-check { opacity: 1; }

  .skin-label { display: flex; flex-direction: column; min-width: 0; }
  .skin-label b { font-size: 0.82rem; font-weight: 600; }
  .skin-label small { font-size: 0.68rem; color: var(--text-muted); }

  .skin-label b { white-space: nowrap; }
  .skin-label small { line-height: 1.3; }

  /* the trigger always sits in the nav footer, so the panel always opens
     upward — including in the mobile drawer, where downward would land
     off-screen */
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const menu = document.querySelector('[data-skin-menu]');
    if (!menu) return;

    const trigger = menu.querySelector('[data-skin-trigger]') as HTMLButtonElement | null;
    const panel = menu.querySelector('.skin-panel') as HTMLElement | null;
    const foot = menu.querySelector('[data-skin-foot]') as HTMLElement | null;
    const options = Array.from(menu.querySelectorAll('[data-skin-option]')) as HTMLButtonElement[];
    const themeToggle = document.getElementById('side-nav-theme-toggle') as HTMLButtonElement | null;
    if (!trigger || !panel) return;

    const NOTE: Record<string, string> = {
      site: '',
      prism: 'Dark mode becomes PRISM’s redshift.',
      void: 'Dark mode fires VOID night; light fires it day.',
    };

    const current = (): string => localStorage.getItem('skin') || 'site';

    function sync(): void {
      const skin = current();
      options.forEach((o) => {
        o.setAttribute('aria-checked', String(o.dataset.skinOption === skin));
      });
      if (foot) foot.textContent = NOTE[skin] || '';

      /* every skin has two modes, so the one toggle always means something */
      if (themeToggle) {
        themeToggle.disabled = false;
        themeToggle.removeAttribute('aria-disabled');
        themeToggle.style.opacity = '';
        themeToggle.style.cursor = '';
        themeToggle.title = 'Toggle dark mode';
      }
    }

    function close(focusTrigger: boolean): void {
      panel!.hidden = true;
      trigger!.setAttribute('aria-expanded', 'false');
      if (focusTrigger) trigger!.focus();
    }

    function open(): void {
      panel!.hidden = false;
      trigger!.setAttribute('aria-expanded', 'true');
    }

    trigger.addEventListener('click', () => {
      if (panel.hidden) open();
      else close(false);
    });

    trigger.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        open();
        options[e.key === 'ArrowDown' ? 0 : options.length - 1]?.focus();
      }
    });

    menu.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Escape') {
        close(true);
      } else if (key === 'ArrowDown' || key === 'ArrowUp') {
        e.preventDefault();
        const i = options.indexOf(document.activeElement as HTMLButtonElement);
        const next = i < 0 ? 0 : (i + (key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
        options[next]?.focus();
      } else if (key === 'Tab') {
        close(false);
      }
    });

    document.addEventListener('pointerdown', (e) => {
      if (!panel.hidden && !menu.contains(e.target as Node)) close(false);
    });

    options.forEach((option) => {
      option.addEventListener('click', () => {
        const skin = option.dataset.skinOption as string;
        localStorage.setItem('skin', skin);
        const apply = (window as unknown as { __applySkin?: (s: string) => void }).__applySkin;
        if (apply) apply(skin);
        sync();
        close(true);
      });
    });

    sync();
  });
</script>
