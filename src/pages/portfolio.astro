---
// The portfolio as a standalone page, with a JSON twin at /portfolio.json.
// Design systems with their own page link straight to it.
import { getCollection } from 'astro:content';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import PixelGlyph from '../components/Reading/PixelGlyph.astro';
import { isFeatureEnabled } from '../config/features';
import { projectHref } from '../lib/reading/projects';

const projects = (await getCollection('projects', ({ id }) => id !== 'saas-game-ui' || isFeatureEnabled('enableSaasGameUI')))
  .sort((a, b) => b.data.projectDate.getTime() - a.data.projectDate.getTime());
const month = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', year: 'numeric' });
---

<ReadingLayout title="Portfolio" description="Selected work by Erikk Shupp: design systems, apps, podcasts and sites." terminal="The Workbench" type="website" jsonLdType="website" jsonHref="/portfolio.json">
  <section class="index-hero wrap">
    <div>
      <p class="eyebrow"><span class="status-dot"></span> The Workbench / {projects.length} projects</p>
      <h1 class="read-title">Portfolio</h1>
    </div>
    <p>Design systems, apps, shows and sites. The design systems open in their own space; everything else opens on the bench.</p>
  </section>
  <div class="wrap">
    <div class="index-grid">
      {projects.map((p) => (
        <a class="index-card panel" href={projectHref(p)}>
          <header><h3 style="font: 600 13px/1.3 var(--sans); letter-spacing: 0"><img src={p.data.completed ? '/atlas/assets/ui/icon_quest_done.png' : '/atlas/assets/ui/icon_quest_active.png'} alt="" class="px" width="16" height="16" /> {p.data.customUrl ? 'Design system' : p.data.completed ? 'Shipped' : 'In progress'}</h3><span>{month(p.data.projectDate)}</span></header>
          {p.data.image ? <div class="index-thumb"><img src={p.data.image} alt="" loading="lazy" decoding="async" /></div> : <div class="index-thumb"><img src="/atlas/assets/ui/star_map/chart.png" alt="" class="px" loading="lazy" /></div>}
          <div class="panel-body">
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </div>
          <footer><span>{p.data.technologies.slice(0, 3).join(' / ')}</span><PixelGlyph name="arrow" size={12} /></footer>
        </a>
      ))}
    </div>
  </div>
</ReadingLayout>
