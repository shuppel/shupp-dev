---
// Thoughtful App Co. as a standalone index, with a JSON twin at /thoughtful-app-co.json.
import { getCollection } from 'astro:content';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import PixelGlyph from '../components/Reading/PixelGlyph.astro';
import { APP_STATUS, appScore, appUrl } from '../lib/reading/apps';

const apps = (await getCollection('thoughtful-apps')).sort((a, b) => appScore(b) - appScore(a));
const icon = (s: string) => (s === 'prototyping' ? 'icon_quest_done' : s === 'shelved' ? 'icon_quests' : 'icon_quest_active');
---

<ReadingLayout title="Thoughtful App Co." description="A collection of app concepts and ideas - some practical, some moonshots, all thoughtfully designed" terminal="The Workbench" type="website" jsonLdType="website" jsonHref="/thoughtful-app-co.json">
  <section class="index-hero wrap">
    <div>
      <p class="eyebrow"><span class="status-dot"></span> Apps for humans / {apps.length} concepts</p>
      <h1 class="read-title">Thoughtful App Co.</h1>
    </div>
    <p>Building apps for humans. Some practical, some moonshots, all thought through. The most promising ones come first.</p>
  </section>
  <div class="wrap">
    <div class="index-grid">
      {apps.map((a) => (
        <a class="index-card panel" href={appUrl(a.id)}>
          <header><h3 style="font: 600 13px/1.3 var(--sans); letter-spacing: 0"><img src={`/atlas/assets/ui/${icon(a.data.status)}.png`} alt="" class="px" width="16" height="16" /> {APP_STATUS[a.data.status]}</h3><span>{a.data.lastUpdated.getUTCFullYear()}</span></header>
          <div class="panel-body">
            <h3>{a.data.title}</h3>
            <p>{a.data.oneLiner}</p>
          </div>
          <footer><span>{a.data.category}</span><PixelGlyph name="arrow" size={12} /></footer>
        </a>
      ))}
    </div>
    <p style="margin: 28px 0 0; font-size: 14px"><a href="/legal-notice/">Privacy policy and legal notice ↗</a></p>
  </div>
</ReadingLayout>
