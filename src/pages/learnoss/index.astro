---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon/Icon.astro';
import { features } from '../../config/features';

if (!features.enableLearnOSS) {
  return Astro.redirect('/');
}

const allCourses = await getCollection('learnoss', ({ data }) => data.visible);

// Live courses first, then in-progress, then planned; newest first within each
const statusOrder: Record<string, number> = { 'live': 0, 'in-progress': 1, 'planned': 2 };
const courses = allCourses.sort((a, b) => {
  const byStatus = (statusOrder[a.data.status] ?? 3) - (statusOrder[b.data.status] ?? 3);
  if (byStatus !== 0) return byStatus;
  return new Date(b.data.lastUpdated).getTime() - new Date(a.data.lastUpdated).getTime();
});

const pillars = [
  {
    icon: 'Notebook',
    title: 'Compiled notes',
    text: 'Openly published lecture notes, organized into study units with original summaries and key ideas — every lecture linking back to its source.',
  },
  {
    icon: 'LinkSimple',
    title: 'Linked data',
    text: 'Each course sits in a web of open resources: the original notes, official course sites, sibling university courses, and reference wikis.',
  },
  {
    icon: 'Books',
    title: 'Free books & visuals',
    text: 'Free-first book references and original diagrams for the concepts that only click when you can see them.',
  },
];

const statusLabels: Record<string, string> = {
  'live': 'Live',
  'in-progress': 'In progress',
  'planned': 'Planned',
};
---

<Layout
  title="LearnOSS — open-source learning"
  description="LearnOSS compiles openly published lecture notes, linked data, and free book references into structured learning resources. A world-class education is already on the open web — it just needs compiling."
>
  <div class="learnoss-page">
    <section class="learnoss-hero">
      <div class="hero-header">
        <Icon name="GraduationCap" size={52} weight="duotone" liquid={true} inkEffect="medium" />
        <h1>LearnOSS</h1>
      </div>
      <p class="lead">Open-source learning, compiled.</p>
      <p class="hero-text">
        Students at great universities publish their lecture notes. Professors publish free
        textbooks. Whole courses sit on the open web, unbundled and scattered. LearnOSS pulls
        those pieces together — compiled notes, linked data, book references, and visual
        explanations — into free, structured resources anyone can learn from. Always with
        attribution, always linking back to the source.
      </p>
    </section>

    <section class="pillars">
      {pillars.map(pillar => (
        <div class="pillar-card">
          <div class="pillar-icon">
            <Icon name={pillar.icon} size={30} weight="duotone" liquid={true} />
          </div>
          <h2 class="pillar-title">{pillar.title}</h2>
          <p class="pillar-text">{pillar.text}</p>
        </div>
      ))}
    </section>

    <section class="courses-section">
      <h2 class="courses-heading">
        <Icon name="Student" size={26} weight="duotone" liquid={true} />
        Courses
      </h2>
      {courses.length === 0 ? (
        <p class="empty-note">First course coming soon.</p>
      ) : (
        <div class="courses-grid">
          {courses.map(course => (
            <a href={`/learnoss/${course.id}`} class="course-card">
              <div class="card-top">
                <span class="card-icon">
                  <Icon name={course.data.heroIcon} size={30} weight="duotone" liquid={true} />
                </span>
                <span class={`status-badge status-${course.data.status}`}>
                  {statusLabels[course.data.status] ?? course.data.status}
                </span>
              </div>
              <div class="card-badges">
                <span class="card-code">{course.data.courseCode}</span>
                <span class="card-school">{course.data.school}</span>
                {course.data.term !== undefined && <span class="card-term">{course.data.term}</span>}
              </div>
              <h3 class="card-title">{course.data.title}</h3>
              <p class="card-description">{course.data.description}</p>
              <div class="card-meta">
                <span>{course.data.units.length} units</span>
                <span>·</span>
                <span>{course.data.units.reduce((n, u) => n + u.lectures.length, 0)} lectures</span>
                <span>·</span>
                <span>{course.data.books.filter(b => b.free).length} free books</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="ethos">
      <h2 class="ethos-heading">The rules LearnOSS plays by</h2>
      <ul class="ethos-list">
        <li>
          <strong>Attribution is non-negotiable.</strong> Every compilation names its sources and
          links to them prominently — the original authors did the hard part.
        </li>
        <li>
          <strong>Link, don't copy.</strong> Summaries here are original writing; the source notes
          stay canonical, and unlicensed material is never reproduced.
        </li>
        <li>
          <strong>Free-first.</strong> Book references lead with what's freely available; anything
          paid is clearly marked.
        </li>
      </ul>
    </section>
  </div>
</Layout>

<style>
  .learnoss-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  /* Hero */
  .learnoss-hero {
    margin-bottom: 3rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .learnoss-hero h1 {
    font-size: 2.75rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-color);
  }

  .lead {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-light);
    margin: 0 0 1rem;
  }

  .hero-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-light);
    max-width: 46rem;
    margin: 0;
  }

  /* Pillars */
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .pillar-card {
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    box-shadow: var(--card-shadow);
  }

  .pillar-icon {
    color: var(--primary-color);
    margin-bottom: 0.75rem;
  }

  .pillar-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 0.5rem;
  }

  .pillar-text {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-light);
    margin: 0;
  }

  /* Courses */
  .courses-section {
    margin-bottom: 3.5rem;
  }

  .courses-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 1.25rem;
  }

  .empty-note {
    color: var(--text-muted);
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .course-card {
    display: block;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    box-shadow: var(--card-shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .course-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-tertiary);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    color: var(--primary-color);
    margin-bottom: 0.85rem;
  }

  .status-badge {
    font-family: var(--font-secondary-header);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .status-live {
    color: var(--color-dark);
    background: var(--color-accent);
  }

  html.dark .status-live {
    background: var(--color-light);
  }

  .status-in-progress,
  .status-planned {
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .card-code {
    font-family: var(--font-secondary-header);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-color);
  }

  .card-school,
  .card-term {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .card-school::before,
  .card-term::before {
    content: "· ";
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-color);
    margin: 0 0 0.5rem;
  }

  .card-description {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--text-light);
    margin: 0 0 1rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.83rem;
    color: var(--text-muted);
  }

  /* Ethos */
  .ethos {
    padding: 1.75rem;
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--color-tertiary);
    border-radius: 14px;
  }

  .ethos-heading {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-color);
    margin: 0 0 1rem;
  }

  .ethos-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .ethos-list li {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--text-light);
  }

  .ethos-list li strong {
    color: var(--text-color);
  }

  .ethos-list li::marker {
    color: var(--color-tertiary);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .learnoss-page {
      padding: 3rem 1rem 4rem;
    }

    .hero-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .learnoss-hero h1 {
      font-size: 2.2rem;
    }

    .courses-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
