---

<!doctype html>
<html lang="en" data-mode="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://shupp.dev/design/prismatic" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://shupp.dev/design/prismatic" />
    <meta property="og:image" content="https://shupp.dev/images/projects/prismatic.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://shupp.dev/images/projects/prismatic.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- PRISM drop-in layer (self-imports its own fonts) -->
    <link rel="stylesheet" href="/prism/prism.css" />

    <style is:global>
      /* =====================================================================
         Showcase-only supplement. Reads PRISM role tokens; mints no brand hex.
         Helpers the drop-in layer leaves to the consumer: type roles, swatches,
         info tokens, --standing-tint, entanglement, ghost collapse, string.
         ===================================================================== */

      /* Info inherits the anchor; --standing-tint is the one sanctioned wash. */
      [data-mode="day"] {
        --standing-tint: oklch(0.74 0.125 var(--h) / 0.08);
        --info: var(--anchor);
        --info-dense: oklch(0.44 0.10 var(--h));
        --on-info: #fff;
      }
      [data-mode="night"] {
        --standing-tint: oklch(0.72 0.115 var(--hr) / 0.14);
        --info: var(--anchor);
        --info-dense: var(--anchor);
        --on-info: var(--field);
      }

      html, body { min-height: 100%; }
      body { padding-bottom: 6rem; }

      /* ---- Type roles (secondary text inherits currentColor and dims via
         opacity so it adapts to whichever ground it sits on — field or
         surface — in both modes. NOT color-mix(currentColor…): Chromium
         resolves that stale, one mode/hue behind, leaving text unreadable
         after a redshift toggle or hue drag). ------------------------------ */
      .prism-headline { font-family: var(--sans); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
      .prism-body { font-size: 15.5px; line-height: 1.55; }
      .prism-ui { font-size: 13.5px; font-weight: 500; }
      .prism-data { font-family: var(--mono); font-size: 13px; }
      .prism-eyebrow {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
        text-transform: uppercase; opacity: 0.62;
      }
      .prism-aside {
        font-family: var(--serif); font-style: italic; font-size: 16px;
        opacity: 0.72;
      }
      .prism-muted { opacity: 0.68; }

      /* Card hover — day lifts toward the light; night glows brighter (no lift). */
      .prism-card {
        transition: background var(--t-sunset) var(--e-refract),
                    box-shadow var(--t-flash) var(--t-lag) var(--e-light),
                    transform var(--t-arrive) var(--e-light),
                    color var(--t-sunset) var(--e-refract);
      }
      .prism-card.ds-lift:hover { box-shadow: var(--elev-hi); transform: translate(-2px, -3px); }
      [data-mode="night"] .prism-card.ds-lift:hover { transform: none; }

      /* Primary's dichroic edge drifts on hover (refract easing, via .prism-edge). */
      .prism-btn--primary.prism-edge:hover::before { background-position: 100% 100%; }

      /* Swatches (showcase chips). Label text stays dark ink on the light bands. */
      .prism-swatch {
        border-radius: var(--r-sm); min-height: 64px; display: flex; align-items: flex-end;
        padding: 0.5rem 0.6rem; font-family: var(--mono); font-size: 12px;
        color: var(--ink); box-shadow: var(--elev-dense);
      }
      .prism-swatch small { opacity: 0.7; }
      .ds-swatch-label { display: flex; flex-direction: column; gap: 0.1rem; }

      .prism-badge--warn { background: var(--warning-dense); color: var(--on-warning-dense); }
      .prism-btn--danger { background: var(--danger-dense); color: var(--on-danger-dense); box-shadow: var(--elev-dense); }

      /* ---- Data surface as a block grid (the drop-in's .prism-row is a block) -- */
      .prism-table {
        background: var(--surface); color: var(--ink); border-radius: var(--r-md);
        overflow: hidden; box-shadow: var(--elev-dense);
        font-family: var(--mono); font-size: 13px;
      }
      .prism-table .prism-row, .ds-thead {
        display: grid; grid-template-columns: var(--cols, 1fr 1fr 1fr); gap: 1rem; align-items: center;
      }
      .ds-thead {
        padding: 10px 10px; border-bottom: 1px solid var(--hairline);
        font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase;
        color: color-mix(in oklch, var(--ink) 60%, transparent);
      }
      .prism-table .prism-row:last-child { border-bottom: none; }
      .prism-row.lit::before { opacity: 1; }
      .prism-row.lit { background: var(--standing-tint); }
      .prism-row:focus-visible { outline: 2px solid var(--anchor); outline-offset: -2px; }

      /* ---- Entanglement dot ---- */
      .prism-dot {
        width: 14px; height: 14px; border-radius: 50%; background: var(--anchor);
        box-shadow: var(--elev-dense); transition: box-shadow var(--t-flash) var(--e-light), transform var(--t-flash) var(--e-light);
      }
      .prism-dot.lit { box-shadow: 0 0 0 4px var(--standing-tint); transform: scale(1.15); }

      /* ---- Superposition collapse (5q) ---- */
      .prism-ghost.collapsed { background: transparent; }
      .prism-ghost.collapsed::before, .prism-ghost.collapsed::after {
        animation: none; opacity: 0; transition: opacity calc(var(--q) * 5) var(--e-light);
      }

      /* ---- Strings vibrate in color, not space (cull to a few elements).
         Range sits under the eyebrow's 0.62 base so the pulse still reads dim. */
      @keyframes prism-string { 0%, 100% { opacity: 0.37; } 50% { opacity: 0.62; } }
      .prism-string { animation: prism-string var(--t-string) var(--e-refract) infinite; }

      /* ---- Holography (v0.7): showcase-side consumers of the light refs -- */

      /* The glint: one compositor layer riding the pointer. transform + a
         var()-derived gradient — the only element that moves every quantum. */
      .ds-light {
        position: fixed; left: 0; top: 0; width: 64vmax; height: 64vmax;
        margin: -32vmax 0 0 -32vmax; border-radius: 50%;
        pointer-events: none; z-index: 35; will-change: transform;
        transform: translate3d(calc(var(--lxp) * 1vw), calc(var(--lyp) * 1vh), 0);
        background: radial-gradient(closest-side,
          oklch(0.92 0.06 var(--h) / calc(var(--li) * 0.20)), transparent 70%);
        mix-blend-mode: soft-light;
      }
      [data-mode="night"] .ds-light {
        background: radial-gradient(closest-side,
          oklch(0.80 0.10 var(--hr) / calc(var(--li) * 0.30)), transparent 70%);
        mix-blend-mode: screen;
      }

      .ds-holo-mono { margin: 0.35rem 0 0; }
      .ds-holo-mono b { color: var(--anchor); font-weight: 500; }

      .ds-icon-row { display: flex; flex-wrap: wrap; gap: 1.1rem; }
      .ds-icon-tile {
        background: none; border: none; cursor: pointer; padding: 0.35rem;
        display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
        border-radius: var(--r-sm); color: inherit;
      }
      .ds-icon-tile .prism-data { opacity: 0.65; }
      .ds-icon-tile:hover .prism-data { opacity: 1; }
      .ds-icon-tile:focus-visible { outline: 2px solid var(--anchor); outline-offset: 3px; }

      .ds-paint { touch-action: none; cursor: crosshair; }
      .ds-paint:focus-visible { outline: 2px solid var(--anchor); outline-offset: 4px; }
      .ds-paint b.cursor { outline: 2px solid var(--counter); outline-offset: 1px; }

      /* =====================================================================
         Page chrome (ds-*)
         ===================================================================== */
      .ds-skip {
        position: absolute; left: -999px; top: 0; background: var(--surface); color: var(--ink);
        padding: 0.5rem 1rem; border-radius: var(--r-sm); z-index: 50;
      }
      .ds-skip:focus { left: 0.5rem; top: 0.5rem; }

      .ds-controls {
        position: sticky; top: 0; z-index: 40;
        display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
        padding: 0.85rem clamp(1rem, 4vw, 3rem);
        background: color-mix(in oklch, var(--field) 86%, transparent);
        backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%);
        border-bottom: 1px solid var(--hairline);
        transition: background var(--t-sunset) var(--e-refract), border-color var(--t-sunset) var(--e-refract);
      }
      .ds-brand {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
        color: inherit; opacity: 0.6; text-decoration: none; margin-right: auto;
      }
      .ds-brand:hover { opacity: 1; }

      .ds-hue { display: flex; align-items: center; gap: 0.6rem; }
      .ds-hue label {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
        opacity: 0.6;
      }
      .ds-hue input[type='range'] {
        -webkit-appearance: none; appearance: none; width: clamp(120px, 22vw, 240px); height: 8px;
        border-radius: 999px; outline-offset: 4px;
        background: linear-gradient(to right,
          oklch(0.72 0.16 0), oklch(0.72 0.16 60), oklch(0.72 0.16 120),
          oklch(0.72 0.16 180), oklch(0.72 0.16 240), oklch(0.72 0.16 300), oklch(0.72 0.16 360));
      }
      .ds-hue input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
        background: var(--anchor); border: 2px solid var(--surface); box-shadow: var(--elev-dense); cursor: pointer;
      }
      .ds-hue input[type='range']::-moz-range-thumb {
        width: 20px; height: 20px; border-radius: 50%; background: var(--anchor);
        border: 2px solid var(--surface); cursor: pointer;
      }
      .ds-readout { font-family: var(--mono); font-size: 13px; white-space: nowrap; }
      .ds-readout b { color: var(--anchor); font-weight: 500; }

      .ds-mode {
        font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;
        padding: 0.5rem 0.9rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: var(--surface); color: var(--ink); cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5ch;
        transition: background var(--t-sunset) var(--e-refract), color var(--t-sunset) var(--e-refract);
      }
      .ds-mode .ds-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--anchor); }

      .ds-page { max-width: 1080px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }
      .ds-hero { padding: clamp(2.5rem, 7vw, 5rem) 0 2rem; }
      .ds-hero .prism-aside { display: block; margin-top: 0.75rem; }
      .ds-hero .ds-intro { max-width: 58ch; margin-top: 1.25rem; }

      .ds-section { padding: 2.5rem 0; border-top: 1px solid var(--hairline); }
      .ds-section > header { margin-bottom: 1.5rem; }
      .ds-section h2 { font-family: var(--sans); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; margin: 0.35rem 0 0; }
      .ds-section header p { max-width: 64ch; margin: 0.5rem 0 0; opacity: 0.7; }
      .ds-section header a { color: var(--anchor); }
      .ds-law { font-family: var(--mono); font-size: 12px; opacity: 0.52; }

      .ds-grid { display: grid; gap: 1rem; }
      .ds-grid--4 { grid-template-columns: repeat(4, 1fr); }
      .ds-grid--3 { grid-template-columns: repeat(3, 1fr); }
      .ds-grid--2 { grid-template-columns: repeat(2, 1fr); }
      @media (max-width: 760px) {
        .ds-grid--4 { grid-template-columns: repeat(2, 1fr); }
        .ds-grid--3, .ds-grid--2 { grid-template-columns: 1fr; }
      }

      .ds-row-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }

      /* ---- sizes × styles sheet ---- */
      .ds-matrix {
        display: grid;
        grid-template-columns: 76px repeat(5, minmax(0, 1fr));
        gap: 0.9rem 0.75rem;
        align-items: center;
        overflow-x: auto;
      }
      .ds-mx-cell { display: flex; align-items: center; }
      .ds-mx-label {
        font-family: var(--mono); font-size: 11.5px; opacity: 0.6; white-space: nowrap;
      }
      .ds-mx-head { text-align: left; }

      .ds-tokens {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.7rem 1rem;
      }
      .ds-token {
        display: grid; grid-template-columns: 20px minmax(0, 1fr);
        grid-template-areas: 'chip name' 'chip role'; gap: 0 0.6rem; align-items: center;
      }
      .ds-token-chip {
        grid-area: chip; width: 20px; height: 20px; border-radius: 50%;
        box-shadow: var(--elev-dense);
      }
      .ds-token-name { grid-area: name; font-family: var(--mono); font-size: 11.5px; }
      .ds-token-role { grid-area: role; font-size: 10.5px; opacity: 0.6; }
      .ds-stack { display: flex; flex-direction: column; gap: 0.6rem; }

      .ds-replay {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.35rem 0.7rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: transparent; opacity: 0.7; cursor: pointer;
      }
      .ds-replay:hover { opacity: 1; border-color: var(--anchor); }

      .ds-caption { font-family: var(--mono); font-size: 12px; margin-top: 0.6rem; opacity: 0.55; }

      .ds-type-stack { display: flex; flex-direction: column; gap: 1.1rem; }
      .ds-type-stack > * { margin: 0; }
      .ds-type-meta { opacity: 0.52; font-family: var(--mono); font-size: 12px; }

      .ds-footer {
        max-width: 1080px; margin: 3rem auto 0; padding: 2rem clamp(1rem, 4vw, 3rem) 0;
        border-top: 1px solid var(--hairline); font-family: var(--mono); font-size: 13px;
        color: color-mix(in oklch, var(--on-ground) 70%, transparent);
      }
      .ds-footer a { color: var(--anchor); }
      .ds-audit { margin-top: 1rem; line-height: 1.7; }
      .ds-audit code { color: currentColor; }
    </style>
    <link rel="stylesheet" href="/prism/guide.css" />
  </head>

  <body class="prism-guide">
    <a class="ds-skip" href="#ds-main">Skip to content</a>

    <!-- The light itself — one compositor layer, driven by the reference beam -->
    <div class="ds-light" aria-hidden="true"></div>

    <!-- ===================== STICKY CONTROL BAR ========================= -->
    <div class="ds-controls" role="region" aria-label="PRISM controls">
      <a class="ds-brand" href="/portfolio">&larr; shupp.dev / portfolio</a>

      <div class="ds-hue">
        <label for="ds-hue-slider">Anchor hue</label>
        <input id="ds-hue-slider" type="range" min="0" max="360" step="1" value="185"
          aria-label="Anchor hue in OKLCH degrees" />
      </div>

      <p class="ds-readout" aria-live="polite">
        day H <b id="ds-day-h">185°</b> &rarr; redshift H <b id="ds-night-h">129°</b>
      </p>

      <button id="ds-mode-toggle" class="ds-mode" type="button" aria-pressed="false">
        <span class="ds-dot" aria-hidden="true"></span>
        <span id="ds-mode-label">Day</span>
      </button>
    </div>

    <main id="ds-main" class="ds-page">
      <!-- =========================== HERO =============================== -->
      <header class="ds-hero">
        <p class="prism-eyebrow prism-string">PRISM · v0.7 · OKLCH</p>
        <h1 class="prism-display">Prismatic</h1>
        <span class="prism-aside">Light splits at the edges; shadows carry color, not gray.</span>
        <p class="prism-body ds-intro prism-muted">
          A light-mode-first design system built on a prism-glass material model. One
          anchor hue derives the brand palette. Material density expresses permanence.
          A shared light reference ties the objects together. Start with those ideas,
          then follow the equations, style rules, components, and information patterns.
          The controls above let you inspect the same system in day and redshift modes.
        </p>
      </header>

