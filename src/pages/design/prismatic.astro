    <script is:inline>
      (function () {
        // Replays: re-trigger an entrance by reflow.
        function restart(el, cls) {
          el.classList.remove(cls);
          void el.offsetWidth;
          el.classList.add(cls);
        }
        // Superposition: ghosts move only while aria-busy holds (65q), then collapse.
        const ghosts = document.querySelectorAll('[data-ghost]');
        const busy = document.getElementById('ds-ghosts');
        let collapsed = false, timer = 0;
        document.querySelectorAll('[data-replay]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const kind = btn.dataset.replay;
            if (kind === 'stagger') restart(document.getElementById('ds-stagger'), 'prism-stagger');
            if (kind === 'enter') restart(document.getElementById('ds-enter').firstElementChild, 'prism-enter');
            if (kind === 'busy') {
              clearTimeout(timer);
              collapsed = false;
              ghosts.forEach((g) => g.classList.remove('collapsed'));
              document.getElementById('ds-collapsed').hidden = true;
              busy.setAttribute('aria-busy', 'true');
              timer = setTimeout(() => {
                busy.setAttribute('aria-busy', 'false');
                collapsed = true;
                ghosts.forEach((g) => g.classList.add('collapsed'));
                document.getElementById('ds-collapsed').hidden = false;
              }, 65 * 40);
            }
          });
        });

        // Entanglement: everything sharing a datum lights with Δt = 0.
        document.querySelectorAll('[data-pair]').forEach((el) => {
          const lit = (on) => document.querySelectorAll('[data-pair="' + el.dataset.pair + '"]')
            .forEach((n) => n.classList.toggle('lit', on));
          el.addEventListener('mouseenter', () => lit(true));
          el.addEventListener('mouseleave', () => lit(false));
        });

        // Icons: click to re-tune a display's emission band.
        const bands = ['anchor', 'near', 'far', 'counter'];
        document.querySelectorAll('[data-cycle]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const screen = btn.querySelector('.prism-screen');
            const band = bands[(bands.indexOf(screen.dataset.band) + 1) % bands.length];
            screen.dataset.band = band;
            btn.setAttribute('aria-label', btn.dataset.name + ' display — band ' + band + ', click to re-tune');
          });
        });

        // Paint display — click and drag everywhere (after Tenfold).
        const paint = document.getElementById('ds-paint');
        const cells = Array.from(paint.children);
        const COLS = 16, ROWS = 10;
        let painting = false, paintOn = true, cur = 0;
        function cellAt(e) {
          const c0 = cells[0].getBoundingClientRect();
          const col = Math.floor((e.clientX - c0.left) / (cells[1].getBoundingClientRect().left - c0.left));
          const row = Math.floor((e.clientY - c0.top) / (cells[COLS].getBoundingClientRect().top - c0.top));
          return col < 0 || col >= COLS || row < 0 || row >= ROWS ? null : cells[row * COLS + col];
        }
        paint.addEventListener('pointerdown', (e) => {
          const c = cellAt(e);
          if (!c) return;
          painting = true;
          paintOn = !c.classList.contains('on');
          c.classList.toggle('on', paintOn);
          paint.setPointerCapture(e.pointerId);
          e.preventDefault();
        });
        paint.addEventListener('pointermove', (e) => {
          const c = painting && cellAt(e);
          if (c) c.classList.toggle('on', paintOn);
        });
        ['pointerup', 'pointercancel'].forEach((t) => paint.addEventListener(t, () => { painting = false; }));
        paint.addEventListener('keydown', (e) => {
          const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -COLS, ArrowDown: COLS }[e.key];
          if (step !== undefined) {
            cells[cur].classList.remove('cursor');
            cur = Math.max(0, Math.min(cells.length - 1, cur + step));
            cells[cur].classList.add('cursor');
            e.preventDefault();
          } else if (e.key === 'Enter' || e.key === ' ') {
            cells[cur].classList.toggle('on');
            e.preventDefault();
          }
        });
        paint.addEventListener('focus', () => cells[cur].classList.add('cursor'));
        paint.addEventListener('blur', () => cells[cur].classList.remove('cursor'));
        document.getElementById('ds-paint-clear').addEventListener('click', () => cells.forEach((c) => c.classList.remove('on')));
      })();
    </script>

    <!-- The light: radiance field + reference beam, and its live monitor. -->
    <script type="module" is:inline>
      import { light } from '/prism/light.js';
      import '/prism/guide.js';

      const $ = (id) => document.getElementById(id);
      const input = $('ds-cascades');
      let shape = '';

      input.addEventListener('input', () => light.setCascades(Number(input.value)));

      // The rig: every control is one parameter of the page's light.
      for (const el of document.querySelectorAll('#ds-rig-panel [data-rig]')) {
        const key = el.dataset.rig;
        if (el.type === 'range') el.addEventListener('input', () => light.setRig({ [key]: Number(el.value) }));
        else if (el.getAttribute('role') === 'switch') el.addEventListener('click', () => {
          const on = el.getAttribute('aria-checked') !== 'true';
          el.setAttribute('aria-checked', String(on));
          light.setRig({ [key]: on });
        });
        else el.addEventListener('click', () => {
          el.parentElement.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === el)));
          light.setRig({ [key]: el.dataset.value });
        });
      }

      light.subscribe((l) => {
        $('ds-f-solves').textContent = l.solves;
        $('ds-f-frames').textContent = l.frames;
        $('ds-f-writes').textContent = l.writes;
        if (!l.radiant) return;
        const next = [l.field.join('×'), l.scale, l.maxCascades, l.cascades].join('|');
        if (next === shape) return;
        shape = next;
        $('ds-f-field').textContent = l.field.join(' × ');
        $('ds-f-texel').textContent = l.scale.toFixed(1);
        $('ds-f-status').textContent = 'WebGL2 · RGBA16F · direction-first layout · two solves per update · one context for page and stages.';
        $('ds-cascade-caption').textContent = 'Cascades at ' + innerWidth + ' × ' + innerHeight;
        input.disabled = false;
        input.max = String(l.maxCascades);
        input.value = String(l.cascades);
        $('ds-cascades-out').textContent = l.cascades;
        $('ds-cascade-rows').replaceChildren(...Array.from({ length: l.maxCascades }, (_, n) => {
          const tr = document.createElement('tr');
          if (n >= l.cascades) tr.dataset.off = '';
          const a = Math.round(l.l0 * (4 ** n - 1) / 3 * l.scale);
          const b = Math.round(l.l0 * (4 ** (n + 1) - 1) / 3 * l.scale);
          [n, (2 ** n * l.scale).toFixed(1) + ' px', (4 ** (n + 1)).toLocaleString('en-US'), a + '–' + b + ' px']
            .forEach((v) => tr.appendChild(document.createElement('td')).append(String(v)));
          return tr;
        }));
      });
    </script>
  </body>
</html>
