---
// PRISM — design-system showcase (standalone document).
// Self-contained: own <html> with data-mode, own day/night cascade. It does NOT
// use the site Layout because PRISM owns the whole viewport + its own mode model.
// Authoritative tokens: /prism/prism.tokens.json. Drop-in layer: /prism/prism.css.
const title = 'PRISM — Prismatic Design System';
const description =
  'PRISM: a light-mode-first, prism/glass design system in OKLCH. One anchor hue drives the whole palette; day and redshift (night) modes. Built by Erikk Shupp.';

// 8×8 one-bit sprites for the pixel displays ('#' = lit). Rendered at build
// time — the DOM is static; only the reference-beam CSS vars animate them.
interface Glyph {
  name: string;
  rows: string[];
}
const glyphs: Glyph[] = [
  {
    name: 'prism',
    rows: ['....#...', '...###..', '...###..', '..##.##.', '..##.##.', '.##...##', '.##...##', '########'],
  },
  {
    name: 'sun',
    rows: ['#..##..#', '...##...', '..####..', '#.####.#', '#.####.#', '..####..', '...##...', '#..##..#'],
  },
  {
    name: 'moon',
    rows: ['..####..', '.##.....', '##......', '##......', '##......', '##......', '.##.....', '..####..'],
  },
  {
    name: 'bolt',
    rows: ['...###..', '..###...', '.###....', '#####...', '..###...', '.###....', '###.....', '#.......'],
  },
  {
    name: 'eye',
    rows: ['........', '..####..', '.#....#.', '#..##..#', '#..##..#', '.#....#.', '..####..', '........'],
  },
  {
    name: 'heart',
    rows: ['........', '.##..##.', '########', '########', '.######.', '..####..', '...##...', '........'],
  },
];

// Paintable 16×10 display, seeded with a line-work prism.
const paintCols = 16;
const paintSeed: string[] = [
  '................',
  '.......##.......',
  '.......##.......',
  '......#..#......',
  '......#..#......',
  '.....#....#.....',
  '.....#....#.....',
  '....#......#....',
  '....########....',
  '................',
];
---

<!doctype html>
<html lang="en" data-mode="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://shupp.dev/design/prismatic" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://shupp.dev/design/prismatic" />
    <meta property="og:image" content="https://shupp.dev/images/projects/prismatic.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://shupp.dev/images/projects/prismatic.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- PRISM drop-in layer (self-imports its own fonts) -->
    <link rel="stylesheet" href="/prism/prism.css" />

    <style is:global>
      /* =====================================================================
         Showcase-only supplement. Reads PRISM role tokens; mints no brand hex.
         Helpers the drop-in layer leaves to the consumer: type roles, swatches,
         info tokens, --standing-tint, entanglement, ghost collapse, string.
         ===================================================================== */

      /* Info inherits the anchor; --standing-tint is the one sanctioned wash. */
      [data-mode="day"] {
        --standing-tint: oklch(0.74 0.125 var(--h) / 0.08);
        --info: var(--anchor);
        --info-dense: oklch(0.44 0.10 var(--h));
        --on-info: #fff;
      }
      [data-mode="night"] {
        --standing-tint: oklch(0.72 0.115 var(--hr) / 0.14);
        --info: var(--anchor);
        --info-dense: var(--anchor);
        --on-info: var(--field);
      }

      html, body { min-height: 100%; }
      body { padding-bottom: 6rem; }

      /* ---- Type roles (secondary text inherits currentColor and dims via
         opacity so it adapts to whichever ground it sits on — field or
         surface — in both modes. NOT color-mix(currentColor…): Chromium
         resolves that stale, one mode/hue behind, leaving text unreadable
         after a redshift toggle or hue drag). ------------------------------ */
      .prism-headline { font-family: var(--sans); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
      .prism-body { font-size: 15.5px; line-height: 1.55; }
      .prism-ui { font-size: 13.5px; font-weight: 500; }
      .prism-data { font-family: var(--mono); font-size: 13px; }
      .prism-eyebrow {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
        text-transform: uppercase; opacity: 0.62;
      }
      .prism-aside {
        font-family: var(--serif); font-style: italic; font-size: 16px;
        opacity: 0.72;
      }
      .prism-muted { opacity: 0.68; }

      /* Card hover — day lifts toward the light; night glows brighter (no lift). */
      .prism-card {
        transition: background var(--t-sunset) var(--e-refract),
                    box-shadow var(--t-flash) var(--t-lag) var(--e-light),
                    transform var(--t-arrive) var(--e-light),
                    color var(--t-sunset) var(--e-refract);
      }
      .prism-card.ds-lift:hover { box-shadow: var(--elev-hi); transform: translate(-2px, -3px); }
      [data-mode="night"] .prism-card.ds-lift:hover { transform: none; }

      /* Primary's dichroic edge drifts on hover (refract easing, via .prism-edge). */
      .prism-btn--primary.prism-edge:hover::before { background-position: 100% 100%; }

      /* Swatches (showcase chips). Label text stays dark ink on the light bands. */
      .prism-swatch {
        border-radius: var(--r-sm); min-height: 64px; display: flex; align-items: flex-end;
        padding: 0.5rem 0.6rem; font-family: var(--mono); font-size: 12px;
        color: var(--ink); box-shadow: var(--elev-dense);
      }
      .prism-swatch small { opacity: 0.7; }
      .ds-swatch-label { display: flex; flex-direction: column; gap: 0.1rem; }

      .prism-badge--warn { background: var(--warning-dense); color: var(--on-warning-dense); }
      .prism-btn--danger { background: var(--danger-dense); color: var(--on-danger-dense); box-shadow: var(--elev-dense); }

      /* ---- Data surface as a block grid (the drop-in's .prism-row is a block) -- */
      .prism-table {
        background: var(--surface); color: var(--ink); border-radius: var(--r-md);
        overflow: hidden; box-shadow: var(--elev-dense);
        font-family: var(--mono); font-size: 13px;
      }
      .prism-table .prism-row, .ds-thead {
        display: grid; grid-template-columns: var(--cols, 1fr 1fr 1fr); gap: 1rem; align-items: center;
      }
      .ds-thead {
        padding: 10px 10px; border-bottom: 1px solid var(--hairline);
        font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase;
        color: color-mix(in oklch, var(--ink) 60%, transparent);
      }
      .prism-table .prism-row:last-child { border-bottom: none; }
      .prism-row.lit::before { opacity: 1; }
      .prism-row.lit { background: var(--standing-tint); }
      .prism-row:focus-visible { outline: 2px solid var(--anchor); outline-offset: -2px; }

      /* ---- Entanglement dot ---- */
      .prism-dot {
        width: 14px; height: 14px; border-radius: 50%; background: var(--anchor);
        box-shadow: var(--elev-dense); transition: box-shadow var(--t-flash) var(--e-light), transform var(--t-flash) var(--e-light);
      }
      .prism-dot.lit { box-shadow: 0 0 0 4px var(--standing-tint); transform: scale(1.15); }

      /* ---- Superposition collapse (5q) ---- */
      .prism-ghost.collapsed { background: transparent; }
      .prism-ghost.collapsed::before, .prism-ghost.collapsed::after {
        animation: none; opacity: 0; transition: opacity calc(var(--q) * 5) var(--e-light);
      }

      /* ---- Strings vibrate in color, not space (cull to a few elements).
         Range sits under the eyebrow's 0.62 base so the pulse still reads dim. */
      @keyframes prism-string { 0%, 100% { opacity: 0.37; } 50% { opacity: 0.62; } }
      .prism-string { animation: prism-string var(--t-string) var(--e-refract) infinite; }

      /* ---- Holography (v0.7): showcase-side consumers of the light refs -- */

      /* The glint: one compositor layer riding the pointer. transform + a
         var()-derived gradient — the only element that moves every quantum. */
      .ds-light {
        position: fixed; left: 0; top: 0; width: 64vmax; height: 64vmax;
        margin: -32vmax 0 0 -32vmax; border-radius: 50%;
        pointer-events: none; z-index: 35; will-change: transform;
        transform: translate3d(calc(var(--lxp) * 1vw), calc(var(--lyp) * 1vh), 0);
        background: radial-gradient(closest-side,
          oklch(0.92 0.06 var(--h) / calc(var(--li) * 0.20)), transparent 70%);
        mix-blend-mode: soft-light;
      }
      [data-mode="night"] .ds-light {
        background: radial-gradient(closest-side,
          oklch(0.80 0.10 var(--hr) / calc(var(--li) * 0.30)), transparent 70%);
        mix-blend-mode: screen;
      }

      .ds-holo-mono { margin: 0.35rem 0 0; }
      .ds-holo-mono b { color: var(--anchor); font-weight: 500; }

      .ds-icon-row { display: flex; flex-wrap: wrap; gap: 1.1rem; }
      .ds-icon-tile {
        background: none; border: none; cursor: pointer; padding: 0.35rem;
        display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
        border-radius: var(--r-sm); color: inherit;
      }
      .ds-icon-tile .prism-data { opacity: 0.65; }
      .ds-icon-tile:hover .prism-data { opacity: 1; }
      .ds-icon-tile:focus-visible { outline: 2px solid var(--anchor); outline-offset: 3px; }

      .ds-paint { touch-action: none; cursor: crosshair; }
      .ds-paint:focus-visible { outline: 2px solid var(--anchor); outline-offset: 4px; }
      .ds-paint b.cursor { outline: 2px solid var(--counter); outline-offset: 1px; }

      /* =====================================================================
         Page chrome (ds-*)
         ===================================================================== */
      .ds-skip {
        position: absolute; left: -999px; top: 0; background: var(--surface); color: var(--ink);
        padding: 0.5rem 1rem; border-radius: var(--r-sm); z-index: 50;
      }
      .ds-skip:focus { left: 0.5rem; top: 0.5rem; }

      .ds-controls {
        position: sticky; top: 0; z-index: 40;
        display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
        padding: 0.85rem clamp(1rem, 4vw, 3rem);
        background: color-mix(in oklch, var(--field) 86%, transparent);
        backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%);
        border-bottom: 1px solid var(--hairline);
        transition: background var(--t-sunset) var(--e-refract), border-color var(--t-sunset) var(--e-refract);
      }
      .ds-brand {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
        color: inherit; opacity: 0.6; text-decoration: none; margin-right: auto;
      }
      .ds-brand:hover { opacity: 1; }

      .ds-hue { display: flex; align-items: center; gap: 0.6rem; }
      .ds-hue label {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase;
        opacity: 0.6;
      }
      .ds-hue input[type='range'] {
        -webkit-appearance: none; appearance: none; width: clamp(120px, 22vw, 240px); height: 8px;
        border-radius: 999px; outline-offset: 4px;
        background: linear-gradient(to right,
          oklch(0.72 0.16 0), oklch(0.72 0.16 60), oklch(0.72 0.16 120),
          oklch(0.72 0.16 180), oklch(0.72 0.16 240), oklch(0.72 0.16 300), oklch(0.72 0.16 360));
      }
      .ds-hue input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
        background: var(--anchor); border: 2px solid var(--surface); box-shadow: var(--elev-dense); cursor: pointer;
      }
      .ds-hue input[type='range']::-moz-range-thumb {
        width: 20px; height: 20px; border-radius: 50%; background: var(--anchor);
        border: 2px solid var(--surface); cursor: pointer;
      }
      .ds-readout { font-family: var(--mono); font-size: 13px; white-space: nowrap; }
      .ds-readout b { color: var(--anchor); font-weight: 500; }

      .ds-mode {
        font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;
        padding: 0.5rem 0.9rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: var(--surface); color: var(--ink); cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5ch;
        transition: background var(--t-sunset) var(--e-refract), color var(--t-sunset) var(--e-refract);
      }
      .ds-mode .ds-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--anchor); }

      .ds-page { max-width: 1080px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }
      .ds-hero { padding: clamp(2.5rem, 7vw, 5rem) 0 2rem; }
      .ds-hero .prism-aside { display: block; margin-top: 0.75rem; }
      .ds-hero .ds-intro { max-width: 58ch; margin-top: 1.25rem; }

      .ds-section { padding: 2.5rem 0; border-top: 1px solid var(--hairline); }
      .ds-section > header { margin-bottom: 1.5rem; }
      .ds-section h2 { font-family: var(--sans); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; margin: 0.35rem 0 0; }
      .ds-section header p { max-width: 64ch; margin: 0.5rem 0 0; opacity: 0.7; }
      .ds-section header a { color: var(--anchor); }
      .ds-law { font-family: var(--mono); font-size: 12px; opacity: 0.52; }

      .ds-grid { display: grid; gap: 1rem; }
      .ds-grid--4 { grid-template-columns: repeat(4, 1fr); }
      .ds-grid--3 { grid-template-columns: repeat(3, 1fr); }
      .ds-grid--2 { grid-template-columns: repeat(2, 1fr); }
      @media (max-width: 760px) {
        .ds-grid--4 { grid-template-columns: repeat(2, 1fr); }
        .ds-grid--3, .ds-grid--2 { grid-template-columns: 1fr; }
      }

      .ds-row-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
      .ds-stack { display: flex; flex-direction: column; gap: 0.6rem; }

      .ds-replay {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.35rem 0.7rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: transparent; opacity: 0.7; cursor: pointer;
      }
      .ds-replay:hover { opacity: 1; border-color: var(--anchor); }

      .ds-caption { font-family: var(--mono); font-size: 12px; margin-top: 0.6rem; opacity: 0.55; }

      .ds-type-stack { display: flex; flex-direction: column; gap: 1.1rem; }
      .ds-type-stack > * { margin: 0; }
      .ds-type-meta { opacity: 0.52; font-family: var(--mono); font-size: 12px; }

      .ds-footer {
        max-width: 1080px; margin: 3rem auto 0; padding: 2rem clamp(1rem, 4vw, 3rem) 0;
        border-top: 1px solid var(--hairline); font-family: var(--mono); font-size: 13px;
        color: color-mix(in oklch, var(--on-ground) 70%, transparent);
      }
      .ds-footer a { color: var(--anchor); }
      .ds-audit { margin-top: 1rem; line-height: 1.7; }
      .ds-audit code { color: currentColor; }
    </style>
  </head>

  <body>
    <a class="ds-skip" href="#ds-main">Skip to content</a>

    <!-- The light itself — one compositor layer, driven by the reference beam -->
    <div class="ds-light" aria-hidden="true"></div>

    <!-- ===================== STICKY CONTROL BAR ========================= -->
    <div class="ds-controls" role="region" aria-label="PRISM controls">
      <a class="ds-brand" href="/portfolio">&larr; shupp.dev / portfolio</a>

      <div class="ds-hue">
        <label for="ds-hue-slider">Anchor hue</label>
        <input id="ds-hue-slider" type="range" min="0" max="360" step="1" value="185"
          aria-label="Anchor hue in OKLCH degrees" />
      </div>

      <p class="ds-readout" aria-live="polite">
        day H <b id="ds-day-h">185°</b> &rarr; redshift H <b id="ds-night-h">129°</b>
      </p>

      <button id="ds-mode-toggle" class="ds-mode" type="button" aria-pressed="false">
        <span class="ds-dot" aria-hidden="true"></span>
        <span id="ds-mode-label">Day</span>
      </button>
    </div>

    <main id="ds-main" class="ds-page">
      <!-- =========================== HERO =============================== -->
      <header class="ds-hero">
        <p class="prism-eyebrow prism-string">PRISM · v0.7 · OKLCH</p>
        <h1 class="prism-display">Prismatic</h1>
        <span class="prism-aside">Light splits at the edges; shadows carry color, not gray.</span>
        <p class="prism-body ds-intro prism-muted">
          A light-mode-first design system built on a prism-glass material model. One
          anchor hue drives the entire palette — rotate it and the whole system
          re-derives. Two modes: day, and redshift (night) as a wavelength shift, not a
          darkness. Drag the hue. Flip the mode. Move the pointer — you are the light
          source, and every edge, cast and glint on this page follows. Nothing breaks.
        </p>
      </header>

      <!-- ========================= DISPERSION =========================== -->
      <section class="ds-section" aria-labelledby="ds-dispersion">
        <header>
          <span class="ds-law">LAW 1–2 · COLOR</span>
          <h2 id="ds-dispersion">Dispersion</h2>
          <p>
            Brand bands sit at fixed angular offsets from the anchor (+0, &minus;35, +75,
            &minus;140), all held in L&nbsp;0.70&ndash;0.78 / C&nbsp;0.11&ndash;0.14 so
            contrast survives any rotation. Field and ink take the cast — never neutral gray.
          </p>
        </header>

        <div class="ds-grid ds-grid--4" aria-label="Brand bands">
          <div class="prism-swatch" style="background: var(--anchor);"><span class="ds-swatch-label">anchor<small>+0°</small></span></div>
          <div class="prism-swatch" style="background: var(--near);"><span class="ds-swatch-label">near<small>&minus;35°</small></span></div>
          <div class="prism-swatch" style="background: var(--far);"><span class="ds-swatch-label">far<small>+75°</small></span></div>
          <div class="prism-swatch" style="background: var(--counter);"><span class="ds-swatch-label">counter<small>&minus;140°</small></span></div>
        </div>

        <div class="ds-grid ds-grid--4" style="margin-top: 1rem;" aria-label="Role tokens">
          <div class="prism-swatch" style="background: var(--field);"><span class="ds-swatch-label">field<small>ground</small></span></div>
          <div class="prism-swatch" style="background: var(--surface);"><span class="ds-swatch-label">surface<small>raised</small></span></div>
          <div class="prism-swatch" style="background: var(--ink); color: var(--surface);"><span class="ds-swatch-label">ink<small>text</small></span></div>
          <div class="prism-swatch" style="background: var(--dense); color: var(--on-dense);"><span class="ds-swatch-label">dense<small>immovable</small></span></div>
        </div>
      </section>

      <!-- ========================== DENSITY ============================= -->
      <section class="ds-section" aria-labelledby="ds-density">
        <header>
          <span class="ds-law">LAW 5 · DENSITY</span>
          <h2 id="ds-density">Density — permanence condenses light into pigment</h2>
          <p>
            The more permanent a component, the more its color condenses: transient lives on
            the edge and glow; standing earns a tinted wash and a 1px border; immovable is
            opaque pigment with near-zero shadow. Destructive actions live in the immovable
            tier — no spectral play.
          </p>
        </header>

        <div class="ds-grid ds-grid--3">
          <div class="prism-card ds-lift">
            <p class="prism-eyebrow">Transient</p>
            <p class="prism-body" style="color: var(--ink-soft); margin: 0.4rem 0 1rem;">Seconds. Edge + spectral glow only.</p>
            <button class="prism-btn prism-btn--primary prism-edge" type="button">Primary action</button>
          </div>

          <div class="prism-card" style="border: 1px solid var(--hairline); background: var(--standing-tint); box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">Standing</p>
            <p class="prism-body" style="color: var(--ink-soft); margin: 0.4rem 0 1rem;">Session. Tinted wash + 1px border, short shadow.</p>
            <button class="prism-btn" type="button" style="box-shadow: var(--elev-dense);">Secondary</button>
          </div>

          <div class="prism-card" style="background: var(--dense); color: var(--on-dense); box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">Immovable</p>
            <p class="prism-body" style="opacity: 0.85; margin: 0.4rem 0 1rem;">Structural. Opaque pigment, compact, no spectra.</p>
            <div class="ds-row-actions">
              <button class="prism-btn prism-btn--dense" type="button">Save</button>
              <button class="prism-btn prism-btn--dense prism-btn--danger" type="button">Delete</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================= SEMANTICS ============================ -->
      <section class="ds-section" aria-labelledby="ds-semantics">
        <header>
          <span class="ds-law">LAW 4 · SEMANTICS ARE PHYSICS</span>
          <h2 id="ds-semantics">Semantics — fixed wavelengths</h2>
          <p>
            success&nbsp;152°, danger&nbsp;27°, warning&nbsp;75° are pinned in both modes —
            they never rotate with the brand. Info alone inherits the anchor. Only the shade
            adapts at night. State is never hue-only: badges carry words.
          </p>
        </header>

        <div class="ds-grid ds-grid--4">
          <div class="prism-card ds-stack" style="box-shadow: var(--elev-dense);">
            <span class="prism-swatch" style="background: var(--success);">success<small> 152°</small></span>
            <span class="prism-badge prism-badge--ok">✓ Approved</span>
          </div>
          <div class="prism-card ds-stack" style="box-shadow: var(--elev-dense);">
            <span class="prism-swatch" style="background: var(--danger);">danger<small> 27°</small></span>
            <span class="prism-badge prism-badge--no">✕ Rejected</span>
          </div>
          <div class="prism-card ds-stack" style="box-shadow: var(--elev-dense);">
            <span class="prism-swatch" style="background: var(--warning);">warning<small> 75°</small></span>
            <span class="prism-badge prism-badge--warn">! Pending</span>
          </div>
          <div class="prism-card ds-stack" style="box-shadow: var(--elev-dense);">
            <span class="prism-swatch" style="background: var(--info);">info<small> = anchor</small></span>
            <span class="prism-badge" style="background: var(--info-dense); color: var(--on-info);">i Info</span>
          </div>
        </div>
      </section>

      <!-- ========================= ELEVATION ============================ -->
      <section class="ds-section" aria-labelledby="ds-elevation">
        <header>
          <span class="ds-law">LAW 6–7 · ELEVATION</span>
          <h2 id="ds-elevation">Elevation — cast floats, hairline grounds</h2>
          <p>
            Day shadows are 3-layer chromatic casts thrown along the light axis (135° at
            rest — move the pointer and every cast on the page swings away from it);
            night shadows are axis-free halos. No black shadows, ever. Inside data, casts are forbidden —
            elevation collapses to 1px hairlines, and refraction enters only as a 2px seam on
            the hovered row. A cast now <em>means</em> "floats above the data."
          </p>
        </header>

        <div class="ds-grid ds-grid--2" style="align-items: start;">
          <div class="prism-card ds-lift prism-edge">
            <p class="prism-eyebrow">Floating card</p>
            <p class="prism-body" style="margin: 0.5rem 0 0; color: var(--ink-soft);">
              Full cast (day) / halo (night). Hover to lift — at night it glows brighter
              instead, because there's nothing to lift toward.
            </p>
          </div>

          <div>
            <div class="prism-table" role="table" aria-label="Dense data (hairline elevation)" style="--cols: 1fr 1fr 1fr;">
              <div class="ds-thead" role="row">
                <span role="columnheader">Run</span><span role="columnheader">Hue</span><span role="columnheader">State</span>
              </div>
              <div class="prism-row" role="row" tabindex="0"><span>0xA1</span><span>185°</span><span>ok</span></div>
              <div class="prism-row" role="row" tabindex="0" aria-selected="true"><span>0xA2</span><span>150°</span><span>ok</span></div>
              <div class="prism-row" role="row" tabindex="0"><span>0xA3</span><span>027°</span><span>fail</span></div>
              <div class="prism-row" role="row" tabindex="0"><span>0xA4</span><span>075°</span><span>warn</span></div>
            </div>
            <p class="ds-caption">No cast inside the table. Hover a row → 2px left seam.</p>
          </div>
        </div>
      </section>

      <!-- =========================== MOTION ============================= -->
      <section class="ds-section" aria-labelledby="ds-motion">
        <header>
          <span class="ds-law">LAW 8–15 · MOTION + QUANTUM</span>
          <h2 id="ds-motion">Motion — quantized, massless, causal</h2>
          <p>
            q&nbsp;=&nbsp;40ms; every duration is an integer multiple. Two easings, no springs.
            Properties animate brightness → form → shadow, and the shadow trails its object by
            2q. Unknown state is superposed; entangled elements break the lag.
          </p>
        </header>

        <div class="ds-grid ds-grid--2">
          <!-- Stagger -->
          <div class="prism-card" style="box-shadow: var(--elev-dense);">
            <div class="ds-row-actions" style="justify-content: space-between;">
              <p class="prism-eyebrow">Group entrance · 1q/child, cap 6</p>
              <button class="ds-replay" data-replay="stagger" type="button">Replay</button>
            </div>
            <div id="ds-stagger" class="prism-stagger ds-grid ds-grid--3" style="margin-top: 1rem;">
              <span class="prism-swatch" style="background: var(--anchor);"></span>
              <span class="prism-swatch" style="background: var(--near);"></span>
              <span class="prism-swatch" style="background: var(--far);"></span>
              <span class="prism-swatch" style="background: var(--counter);"></span>
              <span class="prism-swatch" style="background: var(--info-dense);"></span>
              <span class="prism-swatch" style="background: var(--dense);"></span>
            </div>
          </div>

          <!-- Superposition -->
          <div class="prism-card" style="box-shadow: var(--elev-dense);">
            <div class="ds-row-actions" style="justify-content: space-between;">
              <p class="prism-eyebrow">Superposition · collapse 5q</p>
              <button class="ds-replay" data-replay="collapse" type="button">Observe</button>
            </div>
            <div class="ds-stack" style="margin-top: 1rem;">
              <div class="prism-ghost" data-ghost style="height: 1.4rem;"></div>
              <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 80%;"></div>
              <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 60%;"></div>
            </div>
            <div id="ds-collapsed" hidden style="margin-top: 1rem;">
              <p class="prism-data">↳ run 0xA2 · hue 150° · status ok</p>
            </div>
          </div>

          <!-- Entanglement -->
          <div class="prism-card" style="box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">Entanglement · Δt = 0 on shared datum</p>
            <p class="prism-body" style="color: var(--ink-soft); margin: 0.4rem 0 1rem;">
              Hover a dot or its row — both light instantly. Unrelated neighbors still lag 2q.
            </p>
            <div class="ds-row-actions" style="gap: 1.25rem; margin-bottom: 1rem;">
              <span class="prism-dot" data-pair="r1" tabindex="0" aria-label="datum r1"></span>
              <span class="prism-dot" data-pair="r2" tabindex="0" aria-label="datum r2"></span>
              <span class="prism-dot" data-pair="r3" tabindex="0" aria-label="datum r3"></span>
            </div>
            <div class="prism-table" role="table" style="--cols: 1fr 1fr;">
              <div class="prism-row" role="row" data-pair="r1"><span>r1</span><span>185°</span></div>
              <div class="prism-row" role="row" data-pair="r2"><span>r2</span><span>150°</span></div>
              <div class="prism-row" role="row" data-pair="r3"><span>r3</span><span>027°</span></div>
            </div>
          </div>

          <!-- Light order -->
          <div class="prism-card" style="box-shadow: var(--elev-dense);">
            <div class="ds-row-actions" style="justify-content: space-between;">
              <p class="prism-eyebrow">Light order · enter from −10,−12</p>
              <button class="ds-replay" data-replay="enter" type="button">Replay</button>
            </div>
            <div id="ds-enter" style="margin-top: 1rem;">
              <div class="prism-card prism-edge" style="margin: 0;">
                <p class="prism-body" style="margin: 0;">Arrives from the light source, decelerates, then its shadow settles 2q behind.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ========================= REDSHIFT ============================= -->
      <section class="ds-section" aria-labelledby="ds-redshift">
        <header>
          <span class="ds-law">LAW 16–19 · REDSHIFT</span>
          <h2 id="ds-redshift">Redshift — night is a wavelength, not a darkness</h2>
          <p>
            Toggle the mode (top right). Night mints zero new colors: dense→field,
            field→surface, edge↔fill, cast→halo, filled display→outline. The hue slides toward
            the long-wavelength end via <code class="prism-data">redshift(h)</code>. Sunsets
            refract over 25q — never snap.
          </p>
        </header>

        <div class="ds-grid ds-grid--2" style="align-items: start;">
          <div class="prism-card prism-edge">
            <p class="prism-eyebrow">Figure / ground swap</p>
            <p class="prism-body" style="color: var(--ink-soft); margin: 0.5rem 0 0;">
              In day this card is paper on a near-white field with a dichroic edge. In night
              the field goes dark, this surface becomes the paper figure, and the edge inverts
              to quiet while the body carries the spectrum.
            </p>
          </div>
          <div class="prism-card ds-stack" style="box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">Conserved palette</p>
            <div class="ds-grid ds-grid--4">
              <span class="prism-swatch" style="background: var(--anchor);"></span>
              <span class="prism-swatch" style="background: var(--near);"></span>
              <span class="prism-swatch" style="background: var(--far);"></span>
              <span class="prism-swatch" style="background: var(--counter);"></span>
            </div>
            <p class="ds-caption">Same bands, recomputed from <code class="prism-data">--hr</code> at night.</p>
          </div>
        </div>
      </section>

      <!-- =========================== TYPE ============================== -->
      <section class="ds-section" aria-labelledby="ds-type">
        <header>
          <span class="ds-law">LAW 20 · TYPE</span>
          <h2 id="ds-type">Type — five roles, line work on top</h2>
          <p>
            Display is constructed line work (Tilt&nbsp;Prism), allowed only ≥40px — below
            that it falls back to Instrument&nbsp;Sans 600. Day fills it; night outlines it.
          </p>
        </header>

        <div class="prism-card ds-type-stack" style="box-shadow: var(--elev-dense);">
          <div>
            <span class="ds-type-meta">display · line work · ≥40px</span>
            <p class="prism-display">Refraction</p>
          </div>
          <div>
            <span class="ds-type-meta">headline · Instrument Sans 600</span>
            <p class="prism-headline">Light splits into spectra at the boundary.</p>
          </div>
          <div>
            <span class="ds-type-meta">body · Sans 400</span>
            <p class="prism-body" style="margin: 0;">The near-white field does the work. Color appears only at edges and in shadows.</p>
          </div>
          <div>
            <span class="ds-type-meta">data · Spline Sans Mono</span>
            <p class="prism-data" style="margin: 0;">--h: 185 → --hr: 129 · q = 40ms · AA ≥ 4.5:1</p>
          </div>
          <div>
            <span class="ds-type-meta">aside · Instrument Serif italic · one phrase</span>
            <p class="prism-aside" style="margin: 0;">the human voice, used sparingly.</p>
          </div>
        </div>
      </section>

      <!-- ======================== HOLOGRAPHY ============================ -->
      <section class="ds-section" aria-labelledby="ds-holography">
        <header>
          <span class="ds-law">LAW 21 · HOLOGRAPHY</span>
          <h2 id="ds-holography">Holography — one light, cascaded by reference</h2>
          <p>
            The pointer is the light source, and the whole page is the hologram. Six
            registered custom properties on the root — cast angle, cast vector, intensity,
            position — form the <em>reference beam</em>; every dichroic edge, chromatic
            cast, glint and tilt derives from them in pure CSS <code class="prism-data">calc()</code>.
            The driver writes the root at most once per frame, and only when a value
            crosses its quantum (Δ3° angle, Δ0.02 vector) — most frames write nothing,
            and the typed properties refract between quanta on their own. No element is
            ever touched by JavaScript.
          </p>
        </header>

        <div class="ds-grid ds-grid--2" style="align-items: start;">
          <div class="ds-stack">
            <div class="ds-grid ds-grid--2">
              <div class="prism-holo">
                <p class="prism-eyebrow">Foil</p>
                <p class="prism-ui" style="margin-top: 0.4rem;">Spectrum = <span class="prism-data">--la</span></p>
              </div>
              <div class="prism-holo">
                <p class="prism-eyebrow">Glint</p>
                <p class="prism-ui" style="margin-top: 0.4rem;">Highlight = <span class="prism-data">--lxp/--lyp</span></p>
              </div>
            </div>
            <p class="ds-caption">
              Foil chips: gradient angle, glint position and ±3° tilt are all var() reads.
              Zero per-element JS — add a thousand of these and the frame cost is unchanged.
            </p>
          </div>

          <div class="prism-card" style="box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">Reference monitor · live</p>
            <p class="prism-data ds-holo-mono" aria-live="off">
              --la <b id="ds-ref-la">135</b>° · --lv <b id="ds-ref-v">0.71, 0.71</b> · --li <b id="ds-ref-li">0.35</b>
            </p>
            <p class="prism-data ds-holo-mono">
              frames <b id="ds-ref-frames">0</b> · write batches <b id="ds-ref-writes">0</b> · quanta Δ3° / Δ0.02 / Δ2%
            </p>
            <p class="prism-body prism-muted" style="margin-top: 0.9rem;">
              This readout is the entire runtime contract: the beam is written, the cascade
              does the rest. Write batches never exceed frames, and once the pointer settles
              they stop — quantization makes still frames free. At night the casts are
              already halos, so only the glint and the foil answer the light: physics
              conserved.
            </p>
          </div>
        </div>
      </section>

      <!-- ===================== ICONS & DISPLAYS ========================= -->
      <section class="ds-section" aria-labelledby="ds-displays">
        <header>
          <span class="ds-law">LAW 22 · ICONS &amp; DISPLAYS</span>
          <h2 id="ds-displays">Icons &amp; displays — quantized light on tiny screens</h2>
          <p>
            After Ink &amp; Switch's <a href="https://www.inkandswitch.com/project/tenfold/playground/">Tenfold</a>:
            icons live on coarse 8×8 displays that <em>emit</em> rather than print, so the
            glass stays dark in both modes and only the wavelength changes. Click an icon to
            re-tune its band (anchor → near → far → counter). And in Tenfold's spirit —
            click and drag everywhere: the big display is paintable.
          </p>
        </header>

        <div class="ds-grid ds-grid--2" style="align-items: start;">
          <div>
            <div class="ds-icon-row" aria-label="Icon displays">
              {glyphs.map((g) => (
                <button
                  class="ds-icon-tile"
                  type="button"
                  data-cycle
                  data-name={g.name}
                  aria-label={`${g.name} display — band anchor, click to re-tune`}
                >
                  <span class="prism-screen" data-band="anchor" aria-hidden="true">
                    {g.rows.join('').split('').map((c) => (
                      <b class={c === '#' ? 'on' : undefined}></b>
                    ))}
                  </span>
                  <span class="prism-data">{g.name}</span>
                </button>
              ))}
            </div>
            <p class="ds-caption">
              One-bit sprites, static DOM. The sheen crossing each screen is the same
              reference beam — no display owns a listener.
            </p>
          </div>

          <div>
            <div
              id="ds-paint"
              class="prism-screen ds-paint"
              data-band="anchor"
              style={`--cols: ${paintCols}; --px-size: 16px; --px-gap: 3px;`}
              role="application"
              tabindex="0"
              aria-label="Paint display. Drag to paint pixels; drag from a lit pixel to erase. Arrow keys move the cursor, Enter or Space toggles a pixel."
            >
              {paintSeed.join('').split('').map((c) => (
                <b class={c === '#' ? 'on' : undefined}></b>
              ))}
            </div>
            <div class="ds-row-actions" style="margin-top: 0.6rem;">
              <button id="ds-paint-clear" class="ds-replay" type="button">Clear</button>
              <p class="ds-caption" style="margin: 0;">16×10 · pixels emit the current anchor band.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="ds-footer">
      <p>
        PRISM v0.7 · all color OKLCH · tokens:
        <a href="/prism/prism.tokens.json">prism.tokens.json</a> · layer:
        <a href="/prism/prism.css">prism.css</a>
      </p>
      <div class="ds-audit">
        <strong>Contrast audit (WCAG AA, body ink on field):</strong><br />
        Verified across hues <code>{`{20, 60, 90, 150, 185, 260, 310}`}</code> in both modes via
        <code>scripts/prism-contrast-audit.mjs</code>. The yellow-green band
        (<code>60–90°</code>) is the known risk zone; <code>--ink</code> holds AA there because
        its lightness (L&nbsp;0.28 day / paper-dark night) keeps the ratio above 4.5:1 across the
        wheel — no ink-darkening fix was required. See the script output for per-hue ratios.
      </div>
    </footer>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const slider = document.getElementById('ds-hue-slider');
        const dayH = document.getElementById('ds-day-h');
        const nightH = document.getElementById('ds-night-h');
        const modeBtn = document.getElementById('ds-mode-toggle');
        const modeLabel = document.getElementById('ds-mode-label');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

        // Redshift: slide hue toward the long-wavelength (red) end. Spectral hues
        // (45–300) descend toward red (45); non-spectral pinks (300–360) wrap forward.
        function prismRedshift(h, k = 0.4) {
          if (h <= 45) return h;
          if (h > 300) return Math.round((h + (385 - h) * k) % 360);
          return Math.round(h - (h - 45) * k);
        }

        function applyHue(h) {
          root.style.setProperty('--h', h);
          const hr = prismRedshift(h);
          root.style.setProperty('--hr', hr);
          dayH.textContent = h + '°';
          nightH.textContent = hr + '°';
        }

        slider.addEventListener('input', function (e) { applyHue(parseInt(e.target.value, 10)); });
        applyHue(parseInt(slider.value, 10));

        // Mode toggle — refract over 25q (1000ms); never snap.
        modeBtn.addEventListener('click', function () {
          const next = root.dataset.mode === 'night' ? 'day' : 'night';
          root.dataset.mode = next;
          modeLabel.textContent = next === 'night' ? 'Redshift' : 'Day';
          modeBtn.setAttribute('aria-pressed', String(next === 'night'));
        });

        // Replay helper: re-trigger an entrance animation by reflow.
        function replay(el) {
          el.style.animation = 'none';
          el.querySelectorAll('*').forEach(function (n) { n.style.animation = 'none'; });
          void el.offsetWidth; // force reflow
          el.style.animation = '';
          el.querySelectorAll('*').forEach(function (n) { n.style.animation = ''; });
        }

        document.querySelectorAll('[data-replay]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const kind = btn.getAttribute('data-replay');
            if (kind === 'stagger') replay(document.getElementById('ds-stagger'));
            if (kind === 'enter') {
              const host = document.getElementById('ds-enter').firstElementChild;
              host.classList.remove('prism-enter');
              void host.offsetWidth;
              host.classList.add('prism-enter');
            }
            if (kind === 'collapse') collapse();
          });
        });

        // Superposition collapse + reset (toggles on the Observe button).
        const ghosts = document.querySelectorAll('[data-ghost]');
        const collapsed = document.getElementById('ds-collapsed');
        let isCollapsed = false;
        function collapse() {
          isCollapsed = !isCollapsed;
          ghosts.forEach(function (g) { g.classList.toggle('collapsed', isCollapsed); });
          collapsed.hidden = !isCollapsed;
          const btn = document.querySelector('[data-replay="collapse"]');
          if (btn) btn.textContent = isCollapsed ? 'Superpose' : 'Observe';
        }

        // Entanglement: light all elements sharing a datum with Δt = 0.
        function setLit(pair, on) {
          document.querySelectorAll('[data-pair="' + pair + '"]').forEach(function (el) {
            el.classList.toggle('lit', on);
          });
        }
        document.querySelectorAll('[data-pair]').forEach(function (el) {
          const pair = el.getAttribute('data-pair');
          el.addEventListener('mouseenter', function () { setLit(pair, true); });
          el.addEventListener('mouseleave', function () { setLit(pair, false); });
          el.addEventListener('focus', function () { setLit(pair, true); });
          el.addEventListener('blur', function () { setLit(pair, false); });
        });

        // ===== HOLOGRAPHY — reference-cascade light driver =====
        // The pointer is the light. Six registered refs on :root are the ONLY
        // thing this driver ever writes — one rAF-batched write per frame at
        // most, and a ref is written only when it crosses its quantum, so most
        // pointer frames write nothing. Everything downstream is var()/calc().
        const holo = { la: 135, lvx: 0.7071, lvy: 0.7071, li: 0.35, lxp: 30, lyp: 20 };
        let contLa = 135; // unwound angle: 359°→1° must not spin the page backwards
        let lpx = 0, lpy = 0, lraf = 0, frames = 0, writes = 0;
        const refEls = {
          la: document.getElementById('ds-ref-la'),
          v: document.getElementById('ds-ref-v'),
          li: document.getElementById('ds-ref-li'),
          frames: document.getElementById('ds-ref-frames'),
          writes: document.getElementById('ds-ref-writes'),
        };

        function quant(v, step) { return Math.round(Math.round(v / step) * step * 100) / 100; }

        function lightFrame() {
          lraf = 0; frames++;
          const w = window.innerWidth, hgt = window.innerHeight;
          let dx = w / 2 - lpx, dy = hgt / 2 - lpy; // cast direction: away from the light
          const len = Math.hypot(dx, dy) || 1;
          dx /= len; dy /= len;
          const ang = (Math.atan2(dx, -dy) * 180 / Math.PI + 360) % 360;
          const delta = ((ang - (((contLa % 360) + 360) % 360) + 540) % 360) - 180;
          contLa += delta;
          const next = {
            la: quant(contLa, 3),
            lvx: quant(dx, 0.02),
            lvy: quant(dy, 0.02),
            li: quant(Math.min(1, 0.2 + (len / Math.max(w, hgt)) * 0.9), 0.05),
            lxp: quant((lpx / w) * 100, 2),
            lyp: quant((lpy / hgt) * 100, 2),
          };
          let changed = false;
          for (const k in next) {
            if (next[k] !== holo[k]) {
              holo[k] = next[k];
              root.style.setProperty('--' + k, String(next[k]));
              changed = true;
            }
          }
          if (changed) writes++; // one batched write, ≤1 per frame
          if (changed && refEls.la) {
            refEls.la.textContent = String(((Math.round(holo.la) % 360) + 360) % 360);
            refEls.v.textContent = holo.lvx.toFixed(2) + ', ' + holo.lvy.toFixed(2);
            refEls.li.textContent = holo.li.toFixed(2);
            refEls.frames.textContent = String(frames);
            refEls.writes.textContent = String(writes);
          }
        }

        if (!reduce.matches) {
          window.addEventListener('pointermove', function (e) {
            lpx = e.clientX; lpy = e.clientY;
            if (!lraf) lraf = requestAnimationFrame(lightFrame);
          }, { passive: true });
        }

        // ===== ICONS — click to re-tune a display's emission band =====
        const bands = ['anchor', 'near', 'far', 'counter'];
        document.querySelectorAll('[data-cycle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const screen = btn.querySelector('.prism-screen');
            const band = bands[(bands.indexOf(screen.getAttribute('data-band')) + 1) % bands.length];
            screen.setAttribute('data-band', band);
            btn.setAttribute('aria-label', btn.getAttribute('data-name') + ' display — band ' + band + ', click to re-tune');
          });
        });

        // ===== PAINT DISPLAY — click and drag everywhere (after Tenfold) =====
        const paint = document.getElementById('ds-paint');
        if (paint) {
          const cells = Array.prototype.slice.call(paint.children);
          const COLS = 16, ROWS = 10;
          let painting = false, paintOn = true, cur = 0;

          function cellAt(e) {
            const c0 = cells[0].getBoundingClientRect();
            const pitchX = cells[1].getBoundingClientRect().left - c0.left;
            const pitchY = cells[COLS].getBoundingClientRect().top - c0.top;
            const col = Math.floor((e.clientX - c0.left) / pitchX);
            const row = Math.floor((e.clientY - c0.top) / pitchY);
            if (col < 0 || col >= COLS || row < 0 || row >= ROWS) return null;
            return cells[row * COLS + col];
          }
          paint.addEventListener('pointerdown', function (e) {
            const c = cellAt(e);
            if (!c) return;
            painting = true;
            paintOn = !c.classList.contains('on');
            c.classList.toggle('on', paintOn);
            paint.setPointerCapture(e.pointerId);
            e.preventDefault();
          });
          paint.addEventListener('pointermove', function (e) {
            if (!painting) return;
            const c = cellAt(e);
            if (c) c.classList.toggle('on', paintOn);
          });
          ['pointerup', 'pointercancel'].forEach(function (t) {
            paint.addEventListener(t, function () { painting = false; });
          });
          // keyboard path: arrows move a cursor pixel, Enter/Space toggles it
          paint.addEventListener('keydown', function (e) {
            const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -COLS, ArrowDown: COLS }[e.key];
            if (step !== undefined) {
              cells[cur].classList.remove('cursor');
              cur = Math.max(0, Math.min(cells.length - 1, cur + step));
              cells[cur].classList.add('cursor');
              e.preventDefault();
            } else if (e.key === 'Enter' || e.key === ' ') {
              cells[cur].classList.toggle('on');
              e.preventDefault();
            }
          });
          paint.addEventListener('focus', function () { cells[cur].classList.add('cursor'); });
          paint.addEventListener('blur', function () { cells[cur].classList.remove('cursor'); });
          document.getElementById('ds-paint-clear').addEventListener('click', function () {
            cells.forEach(function (c) { c.classList.remove('on'); });
          });
        }
      })();
    </script>
  </body>
</html>
