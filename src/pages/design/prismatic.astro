---
import DesignHead from '../../components/SEO/DesignHead.astro';
import { ACCEPTANCE, ANTI_PATTERNS, EVENTS, MATERIALS, RIG } from '../../data/prism';
// PRISM — design-system showcase (standalone document).
// Self-contained: own <html> with data-mode, own day/night cascade. It does NOT
// use the site Layout because PRISM owns the whole viewport + its own mode model.
// Tokens: /prism/prism.tokens.json · material: /prism/prism.css · light: /prism/light.js
// Light rules (materials, events, rig) live in src/data/prism.ts → /prism/PRISM.md.
const title = 'Prismatic — An OKLCH Color & UI Design System';
const description = 'Explore Prismatic: one hue becomes an OKLCH palette, glass-like UI, and a passive radiance-cascades light with materials, light events and a light rig.';
const sentence = (t: string) => t[0].toUpperCase() + t.slice(1) + '.';

// 8×8 one-bit sprites for the pixel displays ('#' = lit). Rendered at build
// time — the DOM is static; only the reference-beam CSS vars animate them.
interface Glyph {
  name: string;
  rows: string[];
}
const glyphs: Glyph[] = [
  { name: 'prism', rows: ['....#...', '...###..', '...###..', '..##.##.', '..##.##.', '.##...##', '.##...##', '########'] },
  { name: 'sun', rows: ['#..##..#', '...##...', '..####..', '#.####.#', '#.####.#', '..####..', '...##...', '#..##..#'] },
  { name: 'moon', rows: ['..####..', '.##.....', '##......', '##......', '##......', '##......', '.##.....', '..####..'] },
  { name: 'bolt', rows: ['...###..', '..###...', '.###....', '#####...', '..###...', '.###....', '###.....', '#.......'] },
  { name: 'eye', rows: ['........', '..####..', '.#....#.', '#..##..#', '#..##..#', '.#....#.', '..####..', '........'] },
  { name: 'heart', rows: ['........', '.##..##.', '########', '########', '.######.', '..####..', '...##...', '........'] },
];

// Paintable 16×10 display, seeded with a line-work prism.
const paintCols = 16;
const paintSeed: string[] = [
  '................',
  '.......##.......',
  '.......##.......',
  '......#..#......',
  '......#..#......',
  '.....#....#.....',
  '.....#....#.....',
  '....#......#....',
  '....########....',
  '................',
];

// Cascade table for a 1440×900 viewport — mirrors resize() in /prism/light.js;
// the page script replaces it with the reader's own viewport.
function cascadeRows(vw: number, vh: number) {
  const scale = Math.max(2, Math.max(vw, vh) / 320);
  const diag = Math.hypot(vw, vh) / scale;
  let count = 3;
  while ((4 ** count - 1) / 3 < diag) count++;
  return Array.from({ length: count }, (_, n) => [
    String(n),
    `${(2 ** n * scale).toFixed(1)} px`,
    (4 ** (n + 1)).toLocaleString('en-US'),
    `${Math.round(((4 ** n - 1) / 3) * scale)}–${Math.round(((4 ** (n + 1) - 1) / 3) * scale)} px`,
  ]);
}
const cascades = cascadeRows(1440, 900);
---

<!doctype html>
<html lang="en" data-mode="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <DesignHead title={title} description={description} path="/design/prismatic/" image="/images/social/prismatic-card.png" imageAlt="Prismatic: one hue, a whole spectrum. Four color bands and a glass-like component on a pale ground." />

    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/markdown" title="PRISM rules for agents" href="/prism/PRISM.md" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- PRISM drop-in layer (self-imports its own fonts) -->
    <link rel="stylesheet" href="/prism/prism.css" />

    <link rel="stylesheet" href="/prism/guide.css" />
  </head>

  <body class="prism-guide">
    <a class="ds-skip" href="#ds-main">Skip to content</a>

    <!-- ===================== STICKY CONTROL BAR ========================= -->
    <div class="ds-controls" role="region" aria-label="PRISM controls">
      <a class="ds-brand" href="/portfolio">&larr; shupp.dev / portfolio</a>
      <div class="ds-hue">
        <label for="ds-hue-slider">Anchor hue</label>
        <input id="ds-hue-slider" type="range" min="0" max="360" step="1" value="185" aria-label="Anchor hue in OKLCH degrees" />
      </div>
      <p class="ds-readout" aria-live="polite">day H <b id="ds-day-h">185°</b> &rarr; redshift H <b id="ds-night-h">129°</b></p>
      <button id="ds-mode-toggle" class="ds-mode" type="button" aria-pressed="false">
        <span class="ds-dot" aria-hidden="true"></span>
        <span id="ds-mode-label">Day</span>
      </button>
    </div>

    <main id="ds-main" class="ds-page">
      <!-- =========================== HERO =============================== -->
      <header class="ds-hero">
        <p class="prism-eyebrow">PRISM · v0.9 · OKLCH · Passive light</p>
        <h1 class="prism-display">Prismatic</h1>
        <span class="prism-aside">Light splits at the edges; shadows carry color, not gray.</span>
        <p class="prism-body ds-intro prism-muted">
          A light-mode-first design system. One hue derives the palette, density chooses a material,
          and one light falls across every object. The light rests where the rig puts it and moves
          only when something happens. Set it in the <a href="#ds-rig">light rig</a>, play with it in
          the <a href="#ds-play">playground</a>, or compare variants in the <a href="/design/prismatic/lab">lab</a>.
        </p>
      </header>

      <nav class="guide-index" aria-label="Prismatic chapters">
        <p class="prism-eyebrow">Read the system / from idea to interface</p>
        <ol>
          <li><a href="#concepts"><span>01</span><strong>Core concepts</strong><small>Hue, density, light.</small></a></li>
          <li><a href="#model"><span>02</span><strong>Objects &amp; mathematics</strong><small>Materials, events, the solve.</small></a></li>
          <li><a href="#style-guide"><span>03</span><strong>Style guide</strong><small>Color, type, motion, geometry.</small></a></li>
          <li><a href="#components"><span>04</span><strong>Components</strong><small>Density, rig, playground.</small></a></li>
          <li><a href="#information"><span>05</span><strong>Information patterns</strong><small>A reading order for light.</small></a></li>
          <li><a href="#use"><span>06</span><strong>Build with it</strong><small>Recipe, limits, source.</small></a></li>
        </ol>
      </nav>

      <!-- ===================== 01 CORE CONCEPTS ========================= -->
      <section id="concepts" class="guide-chapter" aria-labelledby="concepts-title">
        <header>
          <div><p class="prism-eyebrow">01 / Core concepts</p><h2 id="concepts-title">One hue. One light. Three densities.</h2></div>
          <p>The identity test: rotate the hue and the system stays recognizable. You still see chromatic edges, density that signals permanence, and one light source for every object.</p>
        </header>
        <div class="guide-concepts">
          <article class="prism-card">
            <p class="prism-eyebrow">I1 / Derive the spectrum</p>
            <div class="guide-bands" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <h3>One hue, four bands.</h3>
            <p>The anchor is a parameter, not a swatch. Fixed offsets derive the brand bands. Success, warning, and danger keep their own hues.</p>
          </article>
          <article class="prism-card" data-light="standing" style="box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">I2 / Density is optical depth</p>
            <h3>Permanence stops light.</h3>
            <p>Transient glass passes most light, standing surfaces filter it, and immovable pigment blocks it. Permanence shows in the shadow.</p>
            <p class="guide-contract">T: transient 0.6 → standing 0.3 → immovable 0.05</p>
          </article>
          <article class="prism-card">
            <p class="prism-eyebrow">I3 / Share the light</p>
            <div class="prism-holo" aria-hidden="true"></div>
            <h3>One light, at rest.</h3>
            <p>The light rests where the rig puts it and moves for a story beat or an action, never for the pointer. Shadows are solved from it; edges and foil read the same reference.</p>
          </article>
        </div>
      </section>

      <!-- ================= 02 OBJECTS & MATHEMATICS ==================== -->
      <section id="model" class="guide-chapter" aria-labelledby="model-title">
        <header>
          <div><p class="prism-eyebrow">02 / Objects &amp; mathematics</p><h2 id="model-title">The light is solved, not drawn.</h2></div>
          <p>Objects take finite values. Materials and events are lookup tables, not taste. Each formula below is the code that runs on this page.</p>
        </header>

        <div class="guide-table-wrap">
          <table class="guide-table">
            <caption>Object = (mode, density → material, role, size) + events, lit by one radiance field</caption>
            <thead><tr><th scope="col">Axis</th><th scope="col">Values</th><th scope="col">Controls</th></tr></thead>
            <tbody>
              <tr><th scope="row">Mode</th><td>day | night</td><td>Figure and ground, shadow or glow, filled or outlined display type. Night is occlusion first.</td></tr>
              <tr><th scope="row">Density</th><td>transient | standing | immovable</td><td>Chooses the material: glass, frosted, pigment (T = 0.6 | 0.3 | 0.05).</td></tr>
              <tr><th scope="row">Material</th><td>{Object.keys(MATERIALS).length} kinds · <code class="prism-data">data-material</code></td><td>How the object treats light, when density is not enough to say it.</td></tr>
              <tr><th scope="row">Event</th><td>{Object.keys(EVENTS).length} kinds · <code class="prism-data">data-light-event</code></td><td>What an action does to light. Each settles within its listed q.</td></tr>
              <tr><th scope="row">Role</th><td>brand | info | success | warning | danger</td><td>Brand and info follow the anchor. The others are fixed hues.</td></tr>
              <tr><th scope="row">Size</th><td>button xs–xl · badge, chip sm–lg</td><td>Padding and type scale. The 1.5px edge stays fixed.</td></tr>
            </tbody>
          </table>
        </div>

        <div class="ds-grid ds-grid--2" style="align-items: start; margin-top: 1rem;">
          <div class="guide-table-wrap" style="margin: 0;">
            <table class="guide-table ds-lookup">
              <caption>LAW 22 · Materials: how an object treats light</caption>
              <thead><tr><th scope="col">Material</th><th scope="col">T</th><th scope="col">Does</th></tr></thead>
              <tbody>
                {Object.entries(MATERIALS).map(([k, m]) => <tr><th scope="row">{k}</th><td>{m.T}</td><td>{sentence(m.does)}<small>{m.use}</small></td></tr>)}
              </tbody>
            </table>
          </div>
          <div class="guide-table-wrap" style="margin: 0;">
            <table class="guide-table ds-lookup">
              <caption>LAW 23 · Light events: what actions do to light</caption>
              <thead><tr><th scope="col">Event</th><th scope="col">On</th><th scope="col">Does</th></tr></thead>
              <tbody>
                {Object.entries(EVENTS).map(([k, e]) => <tr><th scope="row">{k}</th><td>{e.on}</td><td>{sentence(e.does)}<small>{e.held ? 'held' : e.q ? e.q + 'q' : 'passive'}</small></td></tr>)}
              </tbody>
            </table>
          </div>
        </div>
        <p class="ds-caption">See every material and event live in the <a href="/design/prismatic/lab">light lab</a>.</p>

        <section class="ds-section" aria-labelledby="ds-radiance">
          <header>
            <span class="ds-law">LAW 21 · RADIANCE</span>
            <h3 id="ds-radiance">Radiance cascades: the penumbra hypothesis at work</h3>
            <p>
              A shadow is sharp at its occluder and softens with distance. Near light therefore
              needs many probes and few directions; far light needs few probes and many directions.
              Each cascade halves the probe grid, quadruples the rays, and reaches four times farther.
              Merged from the top down, the cascades solve the whole field in a fixed number of
              passes. The method is Alexander Sannikov's; see <a href="https://radiance.wiki/">radiance.wiki</a>.
            </p>
          </header>
          <div class="ds-grid ds-grid--2" style="align-items: start;">
            <div class="guide-table-wrap" style="margin: 0;">
              <table class="guide-table ds-cascades">
                <caption id="ds-cascade-caption">Cascades at 1440 × 900</caption>
                <thead><tr><th scope="col">n</th><th scope="col">Probe spacing</th><th scope="col">Rays / probe</th><th scope="col">Interval</th></tr></thead>
                <tbody id="ds-cascade-rows">
                  {cascades.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
            <div class="prism-card" data-light="standing" style="box-shadow: var(--elev-dense);">
              <p class="prism-eyebrow">Field monitor · live</p>
              <p class="prism-data ds-mono">field <b id="ds-f-field">—</b> texels · 1 texel = <b id="ds-f-texel">—</b> px</p>
              <p class="prism-data ds-mono">solves <b id="ds-f-solves">0</b> · frames <b id="ds-f-frames">0</b> · ref writes <b id="ds-f-writes">0</b></p>
              <label class="ds-range">
                <span class="prism-eyebrow">Cascades</span>
                <input id="ds-cascades" type="range" min="1" max={cascades.length} value={cascades.length} disabled />
                <output id="ds-cascades-out" for="ds-cascades">{cascades.length}</output>
              </label>
              <p class="prism-body prism-muted">
                Remove cascades and the light stops at the top interval. The field is re-solved only when the
                rig, a light event, the scroll, or the hue changes. At rest the loop sleeps: the frame count stops.
              </p>
              <p class="ds-caption" id="ds-f-status">Needs WebGL2. Without it, the six light refs still drive edges, casts, and foil.</p>
            </div>
          </div>
        </section>

        <div class="guide-equations">
          <article class="prism-card">
            <h3>Cascades scale geometrically.</h3>
            <code>spacingₙ = 2ⁿ · raysₙ = 4ⁿ⁺¹<br />intervalₙ = L₀ · [(4ⁿ − 1)/3, (4ⁿ⁺¹ − 1)/3)</code>
            <p>Units are field texels with L₀ = 1. Each cascade stores 4·W·H rays, so memory stays constant. Cascades are added until one interval covers the viewport diagonal.</p>
          </article>
          <article class="prism-card">
            <h3>Intervals merge front to back.</h3>
            <code>L(a→c) = L(a→b) + T(a→b) · L(b→c) · v = f / f_open<br />b = 1 − e^(−f₀(1 − v)) · g = min(b) · day = max(0.8, 1 − 0.16(g·w + 1.6(b − g)))<br />night = min(0.22, 0.22(1 − e^(−(0.6·f₀v + play))))</code>
            <p>A parent ray averages its four children, bilinearly from the nearest upper probes. Solving with and without objects gives visibility v, which cancels the merge's ringing. The neutral part of a shadow leans to the far band (w); light a filter lets through keeps its hue. Play light (spots, bands, emitters) tinges by day and glows by night.</p>
          </article>
          <article class="prism-card">
            <h3>Color is a derived coordinate.</h3>
            <code>Hᵢ = wrap(H + Δᵢ, 360°) · colorᵢ = oklch(Lᵢ Cᵢ Hᵢ)<br />day Δ = 0, −35, +75, −140 · night Δ = 0, −25, +55, −95 on R(H)<br />R(h) = h ≤ 45 ? h : h ≤ 300 ? h − 0.4(h − 45) : (h + 0.4(385 − h)) mod 360</code>
            <p id="guide-hue-equation" class="guide-contract">Day: H = 185° → bands 185°, 150°, 260°, 45°</p>
          </article>
          <article class="prism-card">
            <h3>Light and time are quantized.</h3>
            <code>Δsource = 1 probe · Δangle = 3° · Δvector = 0.02<br />q = 40ms · flash 3q · arrive 6q · settle 10q · mode 25q</code>
            <p>Every light event lists its duration in q; held states last as long as their state. Press-in is the one exception at 1.5q. Reduced motion resolves timed events at once and keeps held states.</p>
          </article>
        </div>
      </section>

      <!-- ======================= 03 STYLE GUIDE ======================== -->
      <section id="style-guide" class="guide-chapter" aria-labelledby="style-guide-title">
        <header>
          <div><p class="prism-eyebrow">03 / Style guide</p><h2 id="style-guide-title">Make the vocabulary consistent.</h2></div>
          <p>Color, type, motion, and geometry turn the optical idea into repeatable choices.</p>
        </header>

        <section class="ds-section" aria-labelledby="ds-color">
          <header>
            <span class="ds-law">LAW 1–2 · COLOR</span>
            <h3 id="ds-color">Bands, roles, fixed semantics</h3>
            <p>
              Day bands hold L 0.70–0.78 and C 0.11–0.14. Success (152°), danger (27°), and warning (75°)
              never rotate; info follows the anchor. Status always carries a word. Check each foreground
              on its actual ground in both modes.
            </p>
          </header>
          <div class="ds-grid ds-grid--4" aria-label="Brand bands">
            <div class="prism-swatch" style="background: var(--anchor);"><span class="ds-swatch-label">anchor<small data-band-offset="0">+0°</small></span></div>
            <div class="prism-swatch" style="background: var(--near);"><span class="ds-swatch-label">near<small data-band-offset="1">&minus;35°</small></span></div>
            <div class="prism-swatch" style="background: var(--far);"><span class="ds-swatch-label">far<small data-band-offset="2">+75°</small></span></div>
            <div class="prism-swatch" style="background: var(--counter);"><span class="ds-swatch-label">counter<small data-band-offset="3">&minus;140°</small></span></div>
          </div>
          <div class="ds-grid ds-grid--4" style="margin-top: 1rem;" aria-label="Role tokens">
            <div class="prism-swatch" style="background: var(--field); color: var(--on-ground);"><span class="ds-swatch-label">field<small>ground</small></span></div>
            <div class="prism-swatch" style="background: var(--surface);"><span class="ds-swatch-label">surface<small>raised</small></span></div>
            <div class="prism-swatch" style="background: var(--ink); color: var(--surface);"><span class="ds-swatch-label">ink<small>text</small></span></div>
            <div class="prism-swatch" style="background: var(--dense); color: var(--on-dense);"><span class="ds-swatch-label">dense<small>immovable</small></span></div>
          </div>
          <div class="ds-row-actions" style="margin-top: 1.25rem;" aria-label="Semantic badges">
            <span class="prism-badge prism-badge--ok">✓ Approved · 152°</span>
            <span class="prism-badge prism-badge--no">✕ Rejected · 27°</span>
            <span class="prism-badge prism-badge--warn">! Pending · 75°</span>
            <span class="prism-badge prism-badge--info">i Info · anchor</span>
          </div>
        </section>

        <section class="ds-section" aria-labelledby="ds-type">
          <header>
            <span class="ds-law">LAW 20 · TYPE</span>
            <h3 id="ds-type">Seven roles, line work on top</h3>
            <p>Use Tilt Prism only at 40px or larger, and Instrument Sans 600 below that. Day fills display type; night outlines it.</p>
          </header>
          <div class="prism-card ds-type-stack" style="box-shadow: var(--elev-dense);">
            <div><span class="ds-type-meta">display · Tilt Prism · ≥40px</span><p class="prism-display">Refraction</p></div>
            <div><span class="ds-type-meta">headline · Instrument Sans 600</span><p class="prism-headline">Light splits into spectra at the boundary.</p></div>
            <div><span class="ds-type-meta">body · Sans 400</span><p class="prism-body">The reading ground stays quiet. Color concentrates at edges, status, and dense actions.</p></div>
            <div><span class="ds-type-meta">data · Spline Sans Mono</span><p class="prism-data">--h: 185 → --hr: 129 · q = 40ms · AA ≥ 4.5:1</p></div>
            <div><span class="ds-type-meta">ui · Sans 500 · 13.5px</span><p class="prism-ui">Inspect release · Save changes</p></div>
            <div><span class="ds-type-meta">eyebrow · Mono · 12px</span><p class="prism-eyebrow">04 / Component family</p></div>
            <div><span class="ds-type-meta">aside · Instrument Serif italic · one phrase</span><p class="prism-aside">the human voice, used sparingly.</p></div>
          </div>
        </section>

        <section class="ds-section" aria-labelledby="ds-motion">
          <header>
            <span class="ds-law">LAW 8–15 · MOTION</span>
            <h3 id="ds-motion">Quantized, massless, causal</h3>
            <p>Brightness leads, form follows, and the shadow trails by 2q. Objects enter from the light. Unknown state is superposed, and moves only while busy.</p>
          </header>
          <div class="ds-grid ds-grid--3">
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
                <p class="prism-eyebrow">Stagger · 1q, cap 6</p>
                <button class="ds-replay" data-replay="stagger" type="button">Replay</button>
              </div>
              <div id="ds-stagger" class="prism-stagger ds-grid ds-grid--3" style="margin-top: 1rem;">
                <span class="prism-swatch" style="background: var(--anchor);"></span>
                <span class="prism-swatch" style="background: var(--near);"></span>
                <span class="prism-swatch" style="background: var(--far);"></span>
                <span class="prism-swatch" style="background: var(--counter);"></span>
                <span class="prism-swatch" style="background: var(--info-dense);"></span>
                <span class="prism-swatch" style="background: var(--dense);"></span>
              </div>
            </div>
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
                <p class="prism-eyebrow">Superposition · while busy</p>
                <button class="ds-replay" data-replay="busy" type="button">Load</button>
              </div>
              <div class="ds-stack" id="ds-ghosts" aria-busy="false" style="margin-top: 1rem;">
                <div class="prism-ghost" data-ghost style="height: 1.4rem;"></div>
                <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 80%;"></div>
                <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 60%;"></div>
              </div>
              <p id="ds-collapsed" class="prism-data" hidden style="margin-top: 1rem;">↳ run 0xA2 · hue 150° · status ok</p>
            </div>
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
                <p class="prism-eyebrow">Enter from the light</p>
                <button class="ds-replay" data-replay="enter" type="button">Replay</button>
              </div>
              <div id="ds-enter" style="margin-top: 1rem;">
                <div class="prism-card prism-edge" style="margin: 0; padding: 16px;">
                  <p class="prism-ui">Arrives along −(lvx, lvy); its shadow settles 2q later.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="guide-table-wrap">
          <table class="guide-table">
            <caption>Geometry / choose the family before the size</caption>
            <thead><tr><th scope="col">Family</th><th scope="col">Values</th><th scope="col">Rule</th></tr></thead>
            <tbody>
              <tr><th scope="row">Radius</th><td>10 / 16 / 24px</td><td>Control / foil / surface. Button sizes step 7–14px.</td></tr>
              <tr><th scope="row">Boundary</th><td>1.5px edge · 1px hairline · 2px seam</td><td>Keep the roles distinct; heavier edges flatten hierarchy.</td></tr>
              <tr><th scope="row">Spacing</th><td>1rem · 1.5rem · 2.5–3rem</td><td>Component gap, group gap, section space.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ======================= 04 COMPONENTS ========================= -->
      <section id="components" class="guide-chapter" aria-labelledby="components-title">
        <header>
          <div><p class="prism-eyebrow">04 / Components</p><h2 id="components-title">The rules become a family.</h2></div>
