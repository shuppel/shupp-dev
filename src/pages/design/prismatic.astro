---
import DesignHead from '../../components/SEO/DesignHead.astro';
// PRISM — design-system showcase (standalone document).
// Self-contained: own <html> with data-mode, own day/night cascade. It does NOT
// use the site Layout because PRISM owns the whole viewport + its own mode model.
// Tokens: /prism/prism.tokens.json · material: /prism/prism.css · light: /prism/light.js
const title = 'Prismatic — An OKLCH Color & UI Design System';
const description = 'Explore Prismatic: one hue becomes an OKLCH palette, glass-like UI, and a live radiance-cascades light field. Interactive principles, math, and tokens.';

// 8×8 one-bit sprites for the pixel displays ('#' = lit). Rendered at build
// time — the DOM is static; only the reference-beam CSS vars animate them.
interface Glyph {
  name: string;
  rows: string[];
}
const glyphs: Glyph[] = [
  { name: 'prism', rows: ['....#...', '...###..', '...###..', '..##.##.', '..##.##.', '.##...##', '.##...##', '########'] },
  { name: 'sun', rows: ['#..##..#', '...##...', '..####..', '#.####.#', '#.####.#', '..####..', '...##...', '#..##..#'] },
  { name: 'moon', rows: ['..####..', '.##.....', '##......', '##......', '##......', '##......', '.##.....', '..####..'] },
  { name: 'bolt', rows: ['...###..', '..###...', '.###....', '#####...', '..###...', '.###....', '###.....', '#.......'] },
  { name: 'eye', rows: ['........', '..####..', '.#....#.', '#..##..#', '#..##..#', '.#....#.', '..####..', '........'] },
  { name: 'heart', rows: ['........', '.##..##.', '########', '########', '.######.', '..####..', '...##...', '........'] },
];

// Paintable 16×10 display, seeded with a line-work prism.
const paintCols = 16;
const paintSeed: string[] = [
  '................',
  '.......##.......',
  '.......##.......',
  '......#..#......',
  '......#..#......',
  '.....#....#.....',
  '.....#....#.....',
  '....#......#....',
  '....########....',
  '................',
];

// Cascade table for a 1440×900 viewport — mirrors resize() in /prism/light.js;
// the page script replaces it with the reader's own viewport.
function cascadeRows(vw: number, vh: number) {
  const scale = Math.max(2, Math.max(vw, vh) / 320);
  const diag = Math.hypot(vw, vh) / scale;
  let count = 3;
  while ((4 ** count - 1) / 3 < diag) count++;
  return Array.from({ length: count }, (_, n) => [
    String(n),
    `${(2 ** n * scale).toFixed(1)} px`,
    (4 ** (n + 1)).toLocaleString('en-US'),
    `${Math.round(((4 ** n - 1) / 3) * scale)}–${Math.round(((4 ** (n + 1) - 1) / 3) * scale)} px`,
  ]);
}
const cascades = cascadeRows(1440, 900);
---

<!doctype html>
<html lang="en" data-mode="day">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <DesignHead title={title} description={description} path="/design/prismatic/" image="/images/social/prismatic-card.png" imageAlt="Prismatic: one hue, a whole spectrum. Four color bands and a glass-like component on a pale ground." />

    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- PRISM drop-in layer (self-imports its own fonts) -->
    <link rel="stylesheet" href="/prism/prism.css" />

    <style is:global>
      /* Showcase-only supplement. Reads PRISM role tokens; mints no brand hex. */

      /* Info inherits the anchor; --standing-tint is the one sanctioned wash. */
      [data-mode="day"] {
        --standing-tint: oklch(0.74 0.125 var(--h) / 0.08);
        --info: var(--anchor);
        --info-dense: oklch(0.44 0.10 var(--h));
        --on-info: #fff;
      }
      [data-mode="night"] {
        --standing-tint: oklch(0.72 0.115 var(--hr) / 0.14);
        --info: var(--anchor);
        --info-dense: var(--anchor);
        --on-info: var(--field);
      }

      html, body { min-height: 100%; }
      body { padding-bottom: 6rem; }

      /* Type roles. Secondary text dims via opacity, not color-mix(currentColor…),
         which Chromium resolves one mode/hue stale after a toggle or hue drag. */
      .prism-headline { font-family: var(--sans); font-size: 24px; font-weight: 600; letter-spacing: -0.02em; }
      .prism-body { font-size: 15.5px; line-height: 1.55; }
      .prism-ui { font-size: 13.5px; font-weight: 500; }
      .prism-data { font-family: var(--mono); font-size: 13px; }
      .prism-eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.62; }
      .prism-aside { font-family: var(--serif); font-style: italic; font-size: 16px; opacity: 0.72; }
      .prism-muted { opacity: 0.68; }

      /* Card hover — day lifts toward the light; night glows brighter (no lift). */
      .prism-card {
        transition: background var(--t-sunset) var(--e-refract),
                    box-shadow var(--t-flash) var(--t-lag) var(--e-light),
                    transform var(--t-arrive) var(--e-light),
                    color var(--t-sunset) var(--e-refract);
      }
      .prism-card.ds-lift:hover { box-shadow: var(--elev-hi); transform: translate(-2px, -3px); }
      [data-mode="night"] .prism-card.ds-lift:hover { transform: none; }
      .prism-btn--primary.prism-edge:hover::before { background-position: 100% 100%; }

      .prism-swatch {
        border-radius: var(--r-sm); min-height: 64px; display: flex; align-items: flex-end;
        padding: 0.5rem 0.6rem; font-family: var(--mono); font-size: 12px;
        color: var(--ink); box-shadow: var(--elev-dense);
      }
      .prism-swatch small { opacity: 0.7; }
      .ds-swatch-label { display: flex; flex-direction: column; gap: 0.1rem; }

      .prism-badge--warn { background: var(--warning-dense); color: var(--on-warning-dense); }
      .prism-badge--info { background: var(--info-dense); color: var(--on-info); }
      .prism-btn--danger { background: var(--danger-dense); color: var(--on-danger-dense); box-shadow: var(--elev-dense); }

      /* Data surface as a block grid */
      .prism-table {
        background: var(--surface); color: var(--ink); border-radius: var(--r-md);
        overflow: hidden; box-shadow: var(--elev-dense); font-family: var(--mono); font-size: 13px;
      }
      .prism-table .prism-row, .ds-thead { display: grid; grid-template-columns: var(--cols, 1fr 1fr 1fr); gap: 1rem; align-items: center; }
      .ds-thead {
        padding: 10px; border-bottom: 1px solid var(--hairline);
        font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase;
        color: color-mix(in oklch, var(--ink) 60%, transparent);
      }
      .prism-table .prism-row:last-child { border-bottom: none; }
      .prism-row.lit::before { opacity: 1; }
      .prism-row.lit { background: var(--standing-tint); }
      .prism-row:focus-visible { outline: 2px solid var(--anchor); outline-offset: -2px; }

      /* Entanglement dot */
      .prism-dot {
        width: 14px; height: 14px; border-radius: 50%; background: var(--anchor); box-shadow: var(--elev-dense);
        transition: box-shadow var(--t-flash) var(--e-light), transform var(--t-flash) var(--e-light);
      }
      .prism-dot.lit { box-shadow: 0 0 0 4px var(--standing-tint); transform: scale(1.15); }

      /* Superposition collapse (5q) */
      .prism-ghost.collapsed { background: transparent; }
      .prism-ghost.collapsed::before, .prism-ghost.collapsed::after {
        animation: none; opacity: 0; transition: opacity calc(var(--q) * 5) var(--e-light);
      }

      /* Strings vibrate in color, not space. */
      @keyframes prism-string { 0%, 100% { opacity: 0.37; } 50% { opacity: 0.62; } }
      .prism-string { animation: prism-string var(--t-string) var(--e-refract) infinite; }

      /* Radiance monitor */
      .ds-mono { margin: 0.35rem 0 0; }
      .ds-mono b, .ds-range output { color: var(--anchor); font-weight: 500; }
      .ds-range { display: flex; align-items: center; gap: 0.75rem; margin: 1.1rem 0 0.9rem; }
      .ds-range input { flex: 1; accent-color: var(--anchor); }
      .ds-range output { font-family: var(--mono); font-size: 13px; min-width: 1.5ch; }
      .ds-cascades td, .ds-cascades th { font-family: var(--mono); font-size: 12.5px; padding: 0.55rem 1rem; }
      .ds-cascades tr[data-off] { opacity: 0.35; }

      /* Icons & displays */
      .ds-icon-row { display: flex; flex-wrap: wrap; gap: 1.1rem; }
      .ds-icon-tile {
        background: none; border: none; cursor: pointer; padding: 0.35rem;
        display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
        border-radius: var(--r-sm); color: inherit;
      }
      .ds-icon-tile .prism-data { opacity: 0.65; }
      .ds-icon-tile:hover .prism-data { opacity: 1; }
      .ds-icon-tile:focus-visible { outline: 2px solid var(--anchor); outline-offset: 3px; }
      .ds-paint { touch-action: none; cursor: crosshair; }
      .ds-paint:focus-visible { outline: 2px solid var(--anchor); outline-offset: 4px; }
      .ds-paint b.cursor { outline: 2px solid var(--counter); outline-offset: 1px; }

      /* Page chrome (ds-*) */
      .ds-skip {
        position: absolute; left: -999px; top: 0; background: var(--surface); color: var(--ink);
        padding: 0.5rem 1rem; border-radius: var(--r-sm); z-index: 50;
      }
      .ds-skip:focus { left: 0.5rem; top: 0.5rem; }

      .ds-controls {
        position: sticky; top: 0; z-index: 40;
        display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem;
        padding: 0.85rem clamp(1rem, 4vw, 3rem);
        background: color-mix(in oklch, var(--field) 86%, transparent);
        backdrop-filter: blur(10px) saturate(140%); -webkit-backdrop-filter: blur(10px) saturate(140%);
        border-bottom: 1px solid var(--hairline);
        transition: background var(--t-sunset) var(--e-refract), border-color var(--t-sunset) var(--e-refract);
      }
      .ds-brand {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
        color: inherit; opacity: 0.6; text-decoration: none; margin-right: auto;
      }
      .ds-brand:hover { opacity: 1; }
      .ds-hue { display: flex; align-items: center; gap: 0.6rem; }
      .ds-hue label { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
      .ds-hue input[type='range'] {
        -webkit-appearance: none; appearance: none; width: clamp(120px, 22vw, 240px); height: 8px;
        border-radius: 999px; outline-offset: 4px;
        background: linear-gradient(to right,
          oklch(0.72 0.16 0), oklch(0.72 0.16 60), oklch(0.72 0.16 120),
          oklch(0.72 0.16 180), oklch(0.72 0.16 240), oklch(0.72 0.16 300), oklch(0.72 0.16 360));
      }
      .ds-hue input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
        background: var(--anchor); border: 2px solid var(--surface); box-shadow: var(--elev-dense); cursor: pointer;
      }
      .ds-hue input[type='range']::-moz-range-thumb {
        width: 20px; height: 20px; border-radius: 50%; background: var(--anchor);
        border: 2px solid var(--surface); cursor: pointer;
      }
      .ds-readout { font-family: var(--mono); font-size: 13px; white-space: nowrap; }
      .ds-readout b { color: var(--anchor); font-weight: 500; }
      .ds-mode {
        font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em;
        padding: 0.5rem 0.9rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: var(--surface); color: var(--ink); cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5ch;
        transition: background var(--t-sunset) var(--e-refract), color var(--t-sunset) var(--e-refract);
      }
      .ds-mode .ds-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--anchor); }

      .ds-page { max-width: 1080px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 3rem); }
      .ds-hero { padding: clamp(2.5rem, 7vw, 5rem) 0 2rem; }
      .ds-hero .prism-aside { display: block; margin-top: 0.75rem; }
      .ds-hero .ds-intro { max-width: 56ch; margin-top: 1.25rem; }

      .ds-section { padding: 2.5rem 0; border-top: 1px solid var(--hairline); }
      .ds-section > header { margin-bottom: 1.5rem; }
      .ds-section header p { max-width: 64ch; margin: 0.5rem 0 0; }
      .ds-section header a { color: var(--anchor); }
      .ds-law { font-family: var(--mono); font-size: 12px; }

      .ds-grid { display: grid; gap: 1rem; }
      .ds-grid--4 { grid-template-columns: repeat(4, 1fr); }
      .ds-grid--3 { grid-template-columns: repeat(3, 1fr); }
      .ds-grid--2 { grid-template-columns: repeat(2, 1fr); }
      @media (max-width: 760px) {
        .ds-grid--4 { grid-template-columns: repeat(2, 1fr); }
        .ds-grid--3, .ds-grid--2 { grid-template-columns: 1fr; }
      }
      .ds-row-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
      .ds-stack { display: flex; flex-direction: column; gap: 0.6rem; }

      /* sizes × styles sheet */
      .ds-matrix {
        display: grid; grid-template-columns: 76px repeat(5, minmax(0, 1fr));
        gap: 0.9rem 0.75rem; align-items: center; overflow-x: auto;
      }
      .ds-mx-cell { display: flex; align-items: center; }
      .ds-mx-label { font-family: var(--mono); font-size: 11.5px; opacity: 0.6; white-space: nowrap; }

      .ds-replay {
        font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 0.35rem 0.7rem; border-radius: var(--r-sm); border: 1px solid var(--hairline);
        background: transparent; color: inherit; opacity: 0.7; cursor: pointer;
      }
      .ds-replay:hover { opacity: 1; border-color: var(--anchor); }
      .ds-caption { font-family: var(--mono); font-size: 12px; margin-top: 0.6rem; }

      .ds-type-stack { display: flex; flex-direction: column; gap: 1.1rem; }
      .ds-type-stack > * { margin: 0; }
      .ds-type-meta { font-family: var(--mono); font-size: 12px; }

      .ds-footer {
        max-width: 1080px; margin: 3rem auto 0; padding: 2rem clamp(1rem, 4vw, 3rem) 0;
        border-top: 1px solid var(--hairline); font-family: var(--mono); font-size: 13px;
        color: color-mix(in oklch, var(--on-ground) 70%, transparent);
      }
      .ds-footer a { color: var(--anchor); }
      .ds-footer p + p { margin-top: 1rem; line-height: 1.7; }
      .ds-footer code { color: currentColor; }
    </style>
    <link rel="stylesheet" href="/prism/guide.css" />
  </head>

  <body class="prism-guide">
    <a class="ds-skip" href="#ds-main">Skip to content</a>

    <!-- ===================== STICKY CONTROL BAR ========================= -->
    <div class="ds-controls" role="region" aria-label="PRISM controls">
      <a class="ds-brand" href="/portfolio">&larr; shupp.dev / portfolio</a>
      <div class="ds-hue">
        <label for="ds-hue-slider">Anchor hue</label>
        <input id="ds-hue-slider" type="range" min="0" max="360" step="1" value="185" aria-label="Anchor hue in OKLCH degrees" />
      </div>
      <p class="ds-readout" aria-live="polite">day H <b id="ds-day-h">185°</b> &rarr; redshift H <b id="ds-night-h">129°</b></p>
      <button id="ds-mode-toggle" class="ds-mode" type="button" aria-pressed="false">
        <span class="ds-dot" aria-hidden="true"></span>
        <span id="ds-mode-label">Day</span>
      </button>
    </div>

    <main id="ds-main" class="ds-page">
      <!-- =========================== HERO =============================== -->
      <header class="ds-hero">
        <p class="prism-eyebrow prism-string">PRISM · v0.8 · OKLCH · Radiance cascades</p>
        <h1 class="prism-display">Prismatic</h1>
        <span class="prism-aside">Light splits at the edges; shadows carry color, not gray.</span>
        <p class="prism-body ds-intro prism-muted">
          A light-mode-first design system. One hue derives the palette, density sets how much light
          an object stops, and a single light falls across every object. That light is solved live
          with radiance cascades. Move the pointer to move it.
        </p>
      </header>

      <nav class="guide-index" aria-label="Prismatic chapters">
        <p class="prism-eyebrow">Read the system / from idea to interface</p>
        <ol>
          <li><a href="#concepts"><span>01</span><strong>Core concepts</strong><small>Hue, density, light.</small></a></li>
          <li><a href="#model"><span>02</span><strong>Objects &amp; mathematics</strong><small>The light is solved.</small></a></li>
          <li><a href="#style-guide"><span>03</span><strong>Style guide</strong><small>Color, type, motion, geometry.</small></a></li>
          <li><a href="#components"><span>04</span><strong>Components</strong><small>Density, then role, then size.</small></a></li>
          <li><a href="#information"><span>05</span><strong>Information patterns</strong><small>A reading order for light.</small></a></li>
          <li><a href="#use"><span>06</span><strong>Build with it</strong><small>Recipe, limits, source.</small></a></li>
        </ol>
      </nav>

      <!-- ===================== 01 CORE CONCEPTS ========================= -->
      <section id="concepts" class="guide-chapter" aria-labelledby="concepts-title">
        <header>
          <div><p class="prism-eyebrow">01 / Core concepts</p><h2 id="concepts-title">One hue. One light. Three densities.</h2></div>
          <p>The identity test: rotate the hue and the system stays recognizable. You still see chromatic edges, density that signals permanence, and one light source for every object.</p>
        </header>
        <div class="guide-concepts">
          <article class="prism-card">
            <p class="prism-eyebrow">I1 / Derive the spectrum</p>
            <div class="guide-bands" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <h3>One hue, four bands.</h3>
            <p>The anchor is a parameter, not a swatch. Fixed offsets derive the brand bands. Success, warning, and danger keep their own hues.</p>
          </article>
          <article class="prism-card" data-light="standing" style="box-shadow: var(--elev-dense);">
            <p class="prism-eyebrow">I2 / Density is optical depth</p>
            <h3>Permanence stops light.</h3>
            <p>Transient glass passes most light, standing surfaces filter it, and immovable pigment blocks it. Permanence shows in the shadow.</p>
            <p class="guide-contract">T: transient 0.6 → standing 0.3 → immovable 0.05</p>
          </article>
          <article class="prism-card">
            <p class="prism-eyebrow">I3 / Share the light</p>
            <div class="prism-holo" aria-hidden="true"></div>
            <h3>One light, solved.</h3>
            <p>The pointer emits four band-colored sources. Field shadows are computed from them, and edges and foil read the same reference.</p>
          </article>
        </div>
      </section>

      <!-- ================= 02 OBJECTS & MATHEMATICS ==================== -->
      <section id="model" class="guide-chapter" aria-labelledby="model-title">
        <header>
          <div><p class="prism-eyebrow">02 / Objects &amp; mathematics</p><h2 id="model-title">The light is solved, not drawn.</h2></div>
          <p>Objects take finite values. Hue, light, and time vary continuously within them. Each formula below is the code that runs on this page.</p>
        </header>

        <div class="guide-table-wrap">
          <table class="guide-table">
            <caption>Object = (mode, density, role, size), lit by one radiance field</caption>
            <thead><tr><th scope="col">Axis</th><th scope="col">Values</th><th scope="col">Controls</th></tr></thead>
            <tbody>
              <tr><th scope="row">Mode</th><td>day | night</td><td>Figure and ground, shadow or glow, filled or outlined display type.</td></tr>
              <tr><th scope="row">Density</th><td>transient | standing | immovable</td><td>Edge, wash, fill, and transmittance T = 0.6 | 0.3 | 0.05.</td></tr>
              <tr><th scope="row">Role</th><td>brand | info | success | warning | danger</td><td>Brand and info follow the anchor. The others are fixed hues.</td></tr>
              <tr><th scope="row">Size</th><td>button xs–xl · badge, chip sm–lg</td><td>Padding and type scale. The 1.5px edge stays fixed.</td></tr>
            </tbody>
          </table>
        </div>

        <section class="ds-section" aria-labelledby="ds-radiance">
          <header>
            <span class="ds-law">LAW 21 · RADIANCE</span>
            <h3 id="ds-radiance">Radiance cascades: the penumbra hypothesis at work</h3>
            <p>
              A shadow is sharp at its occluder and softens with distance. Near light therefore
              needs many probes and few directions; far light needs few probes and many directions.
              Each cascade halves the probe grid, quadruples the rays, and reaches four times farther.
              Merged from the top down, the cascades solve the whole field in a fixed number of
              passes. The method is Alexander Sannikov's; see <a href="https://radiance.wiki/">radiance.wiki</a>.
            </p>
          </header>
          <div class="ds-grid ds-grid--2" style="align-items: start;">
            <div class="guide-table-wrap" style="margin: 0;">
              <table class="guide-table ds-cascades">
                <caption id="ds-cascade-caption">Cascades at 1440 × 900</caption>
                <thead><tr><th scope="col">n</th><th scope="col">Probe spacing</th><th scope="col">Rays / probe</th><th scope="col">Interval</th></tr></thead>
                <tbody id="ds-cascade-rows">
                  {cascades.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
            <div class="prism-card" data-light="standing" style="box-shadow: var(--elev-dense);">
              <p class="prism-eyebrow">Field monitor · live</p>
              <p class="prism-data ds-mono">field <b id="ds-f-field">—</b> texels · 1 texel = <b id="ds-f-texel">—</b> px</p>
              <p class="prism-data ds-mono">solves <b id="ds-f-solves">0</b> · frames <b id="ds-f-frames">0</b> · ref writes <b id="ds-f-writes">0</b></p>
              <label class="ds-range">
                <span class="prism-eyebrow">Cascades</span>
                <input id="ds-cascades" type="range" min="1" max={cascades.length} value={cascades.length} disabled />
                <output id="ds-cascades-out" for="ds-cascades">{cascades.length}</output>
              </label>
              <p class="prism-body prism-muted">
                Remove cascades and the light stops at the top interval. The field is re-solved only when a
                source crosses a probe, the page scrolls, or the hue changes. At rest it costs nothing.
              </p>
              <p class="ds-caption" id="ds-f-status">Needs WebGL2. Without it, the six light refs still drive edges, casts, and foil.</p>
            </div>
          </div>
        </section>

        <div class="guide-equations">
          <article class="prism-card">
            <h3>Cascades scale geometrically.</h3>
            <code>spacingₙ = 2ⁿ · raysₙ = 4ⁿ⁺¹<br />intervalₙ = L₀ · [(4ⁿ − 1)/3, (4ⁿ⁺¹ − 1)/3)</code>
            <p>Units are field texels with L₀ = 1. Each cascade stores 4·W·H rays, so memory stays constant. Cascades are added until one interval covers the viewport diagonal.</p>
          </article>
          <article class="prism-card">
            <h3>Intervals merge front to back.</h3>
            <code>L(a→c) = L(a→b) + T(a→b) · L(b→c) · T(card) = 0.6 | 0.3 | 0.05<br />v = f / f_open · day = 1 − 0.16·(1 − e^(−f₀(1 − v))) · night = 0.22·(1 − e^(−f₀v))</code>
            <p>A parent ray averages its four children, sampled bilinearly from the nearest upper probes. The field is solved twice, with and without cards, so visibility v cancels the merge's ringing. f₀ is the exact open-field fluence of the sources, and day shadows lean toward the far band.</p>
          </article>
          <article class="prism-card">
            <h3>Color is a derived coordinate.</h3>
            <code>Hᵢ = wrap(H + Δᵢ, 360°) · colorᵢ = oklch(Lᵢ Cᵢ Hᵢ)<br />day Δ = 0, −35, +75, −140 · night Δ = 0, −25, +55, −95 on R(H)<br />R(h) = h ≤ 45 ? h : h ≤ 300 ? h − 0.4(h − 45) : (h + 0.4(385 − h)) mod 360</code>
            <p id="guide-hue-equation" class="guide-contract">Day: H = 185° → bands 185°, 150°, 260°, 45°</p>
          </article>
          <article class="prism-card">
            <h3>Light and time are quantized.</h3>
            <code>Δsource = 1 probe · Δangle = 3° · Δvector = 0.02<br />q = 40ms · flash 3q · arrive 6q · settle 10q · mode 25q</code>
            <p>CSS light refs are written at most once per frame. Press-in is the one exception at 1.5q. Reduced motion holds the light at rest and removes transitions.</p>
          </article>
        </div>
      </section>

      <!-- ======================= 03 STYLE GUIDE ======================== -->
      <section id="style-guide" class="guide-chapter" aria-labelledby="style-guide-title">
        <header>
          <div><p class="prism-eyebrow">03 / Style guide</p><h2 id="style-guide-title">Make the vocabulary consistent.</h2></div>
          <p>Color, type, motion, and geometry turn the optical idea into repeatable choices.</p>
        </header>

        <section class="ds-section" aria-labelledby="ds-color">
          <header>
            <span class="ds-law">LAW 1–2 · COLOR</span>
            <h3 id="ds-color">Bands, roles, fixed semantics</h3>
            <p>
              Day bands hold L 0.70–0.78 and C 0.11–0.14. Success (152°), danger (27°), and warning (75°)
              never rotate; info follows the anchor. Status always carries a word. Check each foreground
              on its actual ground in both modes.
            </p>
          </header>
          <div class="ds-grid ds-grid--4" aria-label="Brand bands">
            <div class="prism-swatch" style="background: var(--anchor);"><span class="ds-swatch-label">anchor<small data-band-offset="0">+0°</small></span></div>
            <div class="prism-swatch" style="background: var(--near);"><span class="ds-swatch-label">near<small data-band-offset="1">&minus;35°</small></span></div>
            <div class="prism-swatch" style="background: var(--far);"><span class="ds-swatch-label">far<small data-band-offset="2">+75°</small></span></div>
            <div class="prism-swatch" style="background: var(--counter);"><span class="ds-swatch-label">counter<small data-band-offset="3">&minus;140°</small></span></div>
          </div>
          <div class="ds-grid ds-grid--4" style="margin-top: 1rem;" aria-label="Role tokens">
            <div class="prism-swatch" style="background: var(--field); color: var(--on-ground);"><span class="ds-swatch-label">field<small>ground</small></span></div>
            <div class="prism-swatch" style="background: var(--surface);"><span class="ds-swatch-label">surface<small>raised</small></span></div>
            <div class="prism-swatch" style="background: var(--ink); color: var(--surface);"><span class="ds-swatch-label">ink<small>text</small></span></div>
            <div class="prism-swatch" style="background: var(--dense); color: var(--on-dense);"><span class="ds-swatch-label">dense<small>immovable</small></span></div>
          </div>
          <div class="ds-row-actions" style="margin-top: 1.25rem;" aria-label="Semantic badges">
            <span class="prism-badge prism-badge--ok">✓ Approved · 152°</span>
            <span class="prism-badge prism-badge--no">✕ Rejected · 27°</span>
            <span class="prism-badge prism-badge--warn">! Pending · 75°</span>
            <span class="prism-badge prism-badge--info">i Info · anchor</span>
          </div>
        </section>

        <section class="ds-section" aria-labelledby="ds-type">
          <header>
            <span class="ds-law">LAW 20 · TYPE</span>
            <h3 id="ds-type">Seven roles, line work on top</h3>
            <p>Use Tilt Prism only at 40px or larger, and Instrument Sans 600 below that. Day fills display type; night outlines it.</p>
          </header>
          <div class="prism-card ds-type-stack" style="box-shadow: var(--elev-dense);">
            <div><span class="ds-type-meta">display · Tilt Prism · ≥40px</span><p class="prism-display">Refraction</p></div>
            <div><span class="ds-type-meta">headline · Instrument Sans 600</span><p class="prism-headline">Light splits into spectra at the boundary.</p></div>
            <div><span class="ds-type-meta">body · Sans 400</span><p class="prism-body">The reading ground stays quiet. Color concentrates at edges, status, and dense actions.</p></div>
            <div><span class="ds-type-meta">data · Spline Sans Mono</span><p class="prism-data">--h: 185 → --hr: 129 · q = 40ms · AA ≥ 4.5:1</p></div>
            <div><span class="ds-type-meta">ui · Sans 500 · 13.5px</span><p class="prism-ui">Inspect release · Save changes</p></div>
            <div><span class="ds-type-meta">eyebrow · Mono · 12px</span><p class="prism-eyebrow">04 / Component family</p></div>
            <div><span class="ds-type-meta">aside · Instrument Serif italic · one phrase</span><p class="prism-aside">the human voice, used sparingly.</p></div>
          </div>
        </section>

        <section class="ds-section" aria-labelledby="ds-motion">
          <header>
            <span class="ds-law">LAW 8–15 · MOTION</span>
            <h3 id="ds-motion">Quantized, massless, causal</h3>
            <p>Brightness leads, form follows, and the shadow trails by 2q. Objects enter from the light. Unknown state is superposed, not gray.</p>
          </header>
          <div class="ds-grid ds-grid--3">
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
                <p class="prism-eyebrow">Stagger · 1q, cap 6</p>
                <button class="ds-replay" data-replay="stagger" type="button">Replay</button>
              </div>
              <div id="ds-stagger" class="prism-stagger ds-grid ds-grid--3" style="margin-top: 1rem;">
                <span class="prism-swatch" style="background: var(--anchor);"></span>
                <span class="prism-swatch" style="background: var(--near);"></span>
                <span class="prism-swatch" style="background: var(--far);"></span>
                <span class="prism-swatch" style="background: var(--counter);"></span>
                <span class="prism-swatch" style="background: var(--info-dense);"></span>
                <span class="prism-swatch" style="background: var(--dense);"></span>
              </div>
            </div>
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
                <p class="prism-eyebrow">Superposition · 5q</p>
                <button class="ds-replay" data-replay="collapse" type="button">Observe</button>
              </div>
              <div class="ds-stack" style="margin-top: 1rem;">
                <div class="prism-ghost" data-ghost style="height: 1.4rem;"></div>
                <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 80%;"></div>
                <div class="prism-ghost" data-ghost style="height: 1.4rem; width: 60%;"></div>
              </div>
              <p id="ds-collapsed" class="prism-data" hidden style="margin-top: 1rem;">↳ run 0xA2 · hue 150° · status ok</p>
            </div>
            <div class="prism-card" style="box-shadow: var(--elev-dense);">
              <div class="ds-row-actions" style="justify-content: space-between;">
