---
import { getCollection } from 'astro:content';
import Button from '../../components/acrylics/Button.astro';
import PaintMark from '../../components/acrylics/PaintMark.astro';
import FilterChip from '../../components/acrylics/FilterChip.astro';
import ProjectCard from '../../components/acrylics/ProjectCard.astro';
import Dialog from '../../components/acrylics/Dialog.astro';
const allProjects = await getCollection('projects');
const selection = [
  { id: 'thoughtful-app-co', category: 'Products', pigment: '#D63228', headline: 'Apps for humans.' },
  { id: 'humansonly-fm', category: 'Stories', pigment: '#E2B72D', headline: 'Still human.' },
  { id: 'void', category: 'Design', pigment: '#174C3C', headline: 'Less light. More depth.' },
  { id: 'prismatic', category: 'Design', pigment: '#285799', headline: 'A different spectrum.' },
  { id: 'entropy', category: 'Stories', pigment: '#D63228', headline: 'Into the unknown.' },
  { id: 'nodetus-consultancy', category: 'Products', pigment: '#174C3C', headline: 'Make complex work.' },
];
const projects = selection.flatMap(item => {
  const project = allProjects.find(entry => entry.id === item.id);
  return project ? [{ ...item, project }] : [];
});
const author = (await getCollection('authors'))[0];
const title = 'Erikk Shupp — Acrylics';
const description = 'Products, stories, and digital experiences by Erikk Shupp. A human approach to making things, expressed in Acrylics.';
---
<!doctype html>
<html lang="en" class="ac-site">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F3EEDF" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <link rel="canonical" href="https://shupp.dev/design/acrylics" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://shupp.dev/design/acrylics" />
  <meta property="og:image" content="https://shupp.dev/images/projects/acrylics-paint.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Hind Madurai came from Fontjoy's observed Montserrat/Lora/Hind Madurai pairing.
       Anton is an independent adaptation for the requested tall billboard headings. -->
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Hind+Madurai:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/acrylics/site.css" />
  <script type="module" src="/acrylics/site.mjs" is:inline></script>
</head>
<body>
  <a class="skip-link" href="#work">Skip to selected work</a>
  <div class="site-wrap">
    <header class="site-header">
      <a class="wordmark" href="/design/acrylics" aria-label="Acrylics by Erikk Shupp home"><span class="brand-blot" aria-hidden="true">a</span><span>ACRYLICS<small>by Erikk Shupp</small></span></a>
      <nav class="main-nav" aria-label="Main navigation"><a href="#work" class="nav-current" aria-current="location">The work</a><a href="#about">The human</a><a href="#contact">Say hello <span aria-hidden="true">↗</span></a></nav>
      <Button variant="cream" class="collection-trigger" data-open="collection-dialog" hidden><span class="collection-dot" aria-hidden="true"></span>My collection <span data-saved-count>0</span></Button>
    </header>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="tiny-cross" aria-hidden="true">✳</span> Product thinking. Human feeling.</p>
          <h1 id="hero-title">MAKE<br>SOMETHING<br><span class="hero-human">HUMAN.<PaintMark /></span></h1>
          <div class="hero-intro"><p>I'm Erikk. I turn tangled ideas into products,<br class="desktop-break"> stories, and things people want to use.</p><Button href="#work" variant="ink">Find your kind of work <span aria-hidden="true">↘</span></Button></div>
        </div>
        <div class="hero-composition">
          <PaintMark color="#D63228" class="hero-red" />
          <PaintMark color="#174C3C" class="hero-green" />
          <PaintMark color="#E2B72D" shape="blot" class="hero-yellow" />
          <span class="hero-scribble" aria-hidden="true">↙</span>
          <a class="hero-feature" href="/portfolio/thoughtful-app-co">
            <div class="feature-top"><span class="status-pill">IN GOOD COMPANY</span><span aria-hidden="true">↗</span></div>
            <div class="feature-type">THOUGHT<span>FUL.</span><i aria-hidden="true">*</i></div>
            <p>Technology with a little<br>more humanity.</p>
            <div class="feature-bottom"><span>Thoughtful App Co.</span><span>01 / SELECTED WORK</span></div>
          </a>
          <div class="hero-stamp"><span>MADE OF</span><strong>MANY<br>THINGS.</strong><span>AND STILL BECOMING</span></div>
          <p class="composition-note">A little product. A little story.<br>A whole lot of overlap.</p>
        </div>
      </section>
      <div class="discipline-strip" aria-label="Areas of practice"><span>PRODUCT + ENGINEERING</span><b aria-hidden="true">✳</b><span>DESIGN + FEELING</span><b aria-hidden="true">✳</b><span>STORIES + SOFTWARE</span><b aria-hidden="true">✳</b><span>HUMANS FIRST</span></div>
      <section id="work" class="work-section" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">01 / A few things I've put into the world</p><h2 id="work-title">GOOD THINGS<br>COME IN <span class="underline-paint">LAYERS.</span></h2></div><p>Different mediums. Same curiosity.<br>Pick a thread—or save a few pieces<br>to talk about together.</p></div>
        <div class="work-toolbar" hidden>
          <div class="filter-group" role="group" aria-label="Filter projects"><FilterChip value="all" label="All work" count={projects.length} active />{['Products', 'Design', 'Stories'].map(category => <FilterChip value={category} label={category} count={projects.filter(item => item.category === category).length} />)}</div>
          <label class="search-field"><span aria-hidden="true">⌕</span><span class="visually-hidden">Search projects</span><input type="search" id="project-search" placeholder="Find something…" autocomplete="off" /></label>
        </div>
        <p class="result-status eyebrow" id="result-status" role="status" hidden>{projects.length} projects / all work</p>
        <div id="project-grid" class="project-grid">{projects.map((item, index) => <ProjectCard {...item} index={index} />)}</div>
        <div id="empty-results" class="empty-results" hidden><PaintMark shape="blot" color="#E2B72D" /><h3>No marks here yet.</h3><p>Try another word or start with all the work.</p><Button variant="cream" id="reset-search">Clear filters</Button></div>
        <div class="work-foot"><span>There's more where this came from.</span><a class="text-link" href="/portfolio">The full archive <span aria-hidden="true">↗</span></a></div>
      </section>
      <section id="about" class="about-section" aria-labelledby="about-title">
        <div class="about-portrait"><PaintMark color="#285799" /><img src={author.data.avatar} alt={author.data.name} width="360" height="420" loading="lazy" /><span class="portrait-label">THE HUMAN BEHIND THE PIXELS ↗</span></div>
        <div class="about-copy"><p class="eyebrow">02 / Arlington, Virginia & the internet</p><h2 id="about-title">A STORYTELLER.<br>WHO BUILDS.</h2><p class="about-lead">The storytelling came first.<br>The technical skills followed.</p><p>Creative writing. Product thinking. Software engineering. I work where these things overlap, making technology that respects people's time and attention.</p><div class="about-tags"><span>Product manager</span><span>Software engineer</span><span>Fractional founder</span></div><a class="text-link" href="/about">A little more about me <span aria-hidden="true">↗</span></a></div>
      </section>
      <section id="contact" class="contact-section" aria-labelledby="contact-title">
        <div class="contact-copy"><p class="eyebrow">03 / Start with the interesting bit</p><h2 id="contact-title">WHAT ARE<br>YOU <span>MAKING?</span></h2><p>A half-formed idea is a perfectly good place to start.</p><a href="mailto:erikk@shupp.dev" class="text-link">erikk@shupp.dev <span aria-hidden="true">↗</span></a><PaintMark color="#174C3C" shape="blot" class="contact-blot" /></div>
        <form id="brief-form" class="brief-form" hidden>
          <fieldset><legend>I'd like to talk about…</legend><div class="interest-options">{['A product', 'A website', 'A story', 'Something else'].map((label, index) => <label class="interest-chip"><input type="radio" name="interest" value={label} checked={index === 0} /><span>{label}</span></label>)}</div></fieldset>
          <div class="form-row"><label>Your name<input name="name" autocomplete="name" required maxlength="80" placeholder="How should I call you?" /></label><label>Your email<input name="email" type="email" autocomplete="email" required maxlength="160" placeholder="you@somewhere.good" /></label></div>
          <label>The interesting bit<textarea name="idea" rows="3" required maxlength="3000" placeholder="What would you like to put into the world?"></textarea></label>
          <p class="brief-saved-note"><span data-saved-count>0</span> saved projects will be included as references.</p>
          <div class="form-bottom"><Button type="submit" variant="paint">Put it together <span aria-hidden="true">↗</span></Button><small>Prepare a draft, then open your email.<br>Nothing is sent from this page.</small></div>
        </form>
        <noscript><p>Have an idea? Email <a href="mailto:erikk@shupp.dev">erikk@shupp.dev</a> to start a conversation.</p></noscript>
      </section>
    </main>
    <footer class="site-footer"><a class="footer-wordmark" href="/design/acrylics">ACRYLICS<span aria-hidden="true">✳</span></a><div class="footer-bottom"><span>© {new Date().getUTCFullYear()} Erikk Shupp. Still making things.</span><nav aria-label="Elsewhere"><a href="/design/acrylics/materials">Material workshop ↗</a><a href={author.data.socialLinks.github}>GitHub ↗</a><a href="/">shupp.dev ↗</a></nav><span>LEAVE A LITTLE TEXTURE.</span></div></footer>
  </div>
  <Dialog id="project-dialog" title="Project details"><div id="project-dialog-content"></div></Dialog>
  <Dialog id="collection-dialog" title="Your kind of work." class="collection-dialog"><p>Keep the pieces that speak to you. Bring them into the conversation.</p><div class="collection-mix"><PaintMark shape="blot" color="var(--collection-pigment, #E2B72D)" /><div><strong id="collection-summary">A fresh start.</strong><p id="collection-mixture">Save a project to begin your collection.</p></div></div><ul id="saved-projects" class="saved-projects"></ul><p class="collection-local" id="storage-note">Saved in this browser. Yours to clear.</p><div class="dialog-actions"><Button id="collection-to-brief" variant="paint">Bring these to a conversation ↗</Button><button class="text-button" id="clear-collection">Clear collection</button></div></Dialog>
  <Dialog id="brief-dialog" title="An idea, taking shape."><p>Review your draft. Open it in your email app when you're ready.</p><label class="visually-hidden" for="brief-preview">Your prepared message</label><textarea id="brief-preview" rows="12" readonly></textarea><div class="dialog-actions"><Button href="mailto:erikk@shupp.dev" id="email-draft" variant="paint">Open email draft ↗</Button><Button id="copy-brief" variant="cream">Copy draft</Button></div><p id="copy-status" role="status"></p><small>Your email app handles sending. You can also copy this draft into any email service.</small></Dialog>
  <div class="save-notice" id="save-notice" role="status" aria-live="polite"></div>
</body>
</html>
