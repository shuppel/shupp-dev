---
import VoidSprite from '../../components/VoidSprite.astro';

// VOID — design-system showcase (standalone document).
// Self-contained: own <html>, own single-mode cascade. It does NOT use the site
// Layout because VOID owns the whole viewport and its own material model.
// Authoritative tokens: /void/void.tokens.json. Drop-in layer: /void/void.css.
const title = 'VOID — Boundary-Depth Design System';
const description =
  'VOID: a dark, single-mode design system where depth is carried entirely by the boundary of an object — one absolute-black hairline with an asymmetric gradient pair. Built by Erikk Shupp.';

// The set. Stroke-only, 24×24, drawn once into a sprite below.
const iconSet = [
  'discover', 'radar', 'capture', 'pipeline', 'profile', 'agency', 'calendar',
  'clock', 'bell', 'filter', 'flag', 'track', 'target', 'trend', 'check',
  'close', 'plus', 'chevron-right', 'chevron-left', 'chevron-down', 'external',
  'download', 'refresh', 'sliders', 'lock', 'warning', 'info', 'more',
];

// §5 — one token, every size. Each row is rendered as disc + badge + dot + word.
const statuses: { key: string; label: string; rgb: string; note: string; v: string }[] = [
  { key: 'success', label: 'healthy', rgb: '122 214 160', note: 'lift 0.42', v: '4' },
  { key: 'warning', label: 'degraded', rgb: '236 194 106', note: 'lift 0.42', v: '1' },
  { key: 'danger', label: 'failed', rgb: '240 138 128', note: 'lift 0.42', v: '1' },
  { key: 'info', label: 'running', rgb: '138 180 240', note: 'lift 0.42', v: '2' },
  { key: 'idle', label: 'paused', rgb: '255 255 255', note: 'lift 0.10', v: '—' },
];

// §3 — the whole ladder. There is no fifth value.
const surfaces = [
  { name: '--s0', night: '#101118', day: '#e6e8ee', role: 'page' },
  { name: '--s1', night: '#16181f', day: '#eef0f5', role: 'panel · well · nav' },
  { name: '--s2', night: '#1c1e26', day: '#f7f8fb', role: 'component' },
  { name: '--s3', night: '#23262f', day: '#ffffff', role: 'raised part' },
];

const antiPatterns: [string, string][] = [
  ['Give the hairline a colour to show status', 'Breaks I1 and I5. Status goes inside the hairline.'],
  ['Scale the hairline with element size', 'It is a boundary marker, not a stroke weight. Scaling turns the language from “flat with an edge” into “outlined”.'],
  ['Make the page background black', 'Absolute black must be darker than its surround (I2).'],
  ['Use symmetric blur on both sides of the edge', 'Cancels the illusion; looks merely blurry.'],
  ['Add a gradient to a fill', 'All variation lives in box-shadow (I6).'],
  ['Track the cursor with the light', 'Ambient motion during reading (I7).'],
  ['Translate or scale a button on press', 'Layout shift. The system changes material instead.'],
  ['Add a fifth surface value', 'Use a different depth preset.'],
  ['Raise status saturation for clarity', 'Blooms on OLED. Raise --lift instead.'],
  ['Ship the default preset without dither', 'Visible banding on OLED.'],
  ['Mount a WebGL context per component', 'Context limits and mobile context loss. One per page.'],
  ['Use emoji or icon fonts for status', 'The ring and the dot are the status vocabulary.'],
  ['Fade or scale a panel open', 'A scaled hairline is not 1.5px and a faded one was never there. The panel is an object: grow it.'],
  ['Animate a wrapper instead of the object', 'The shadow detaches from the shape. Size the element that carries the depth preset.'],
];

const acceptance = [
  'Two objects with identical fill, one with the lift pair and one with the hairline alone, are perceptibly different materials.',
  'A colour picker sampling the centre of every disc on the page returns the same value.',
  'Moving the pointer across the page, without clicking, produces no visual change whatsoever.',
  'Clicking a control shifts the whole page’s lighting and settles within ~400ms.',
  'The rAF loop is cancelled at rest — zero scripting activity between interactions.',
  'Every saturated pixel on screen belongs to a status ring or a dot.',
  'Screenshotting in greyscale leaves all status still legible.',
  'The determinate loader’s head visibly changes speed around the ring, with no easing function in the source.',
  'No banding on an OLED display at full brightness.',
  'A pressed control has the same bounding box as a resting one — the material changed and nothing else.',
  'A menu or fold that is opening has a correct 1.5px hairline around its real shape at every intermediate frame.',
  'At 375px, every interactive target is ≥ 44px.',
  'Under prefers-reduced-motion nothing moves, and the design still reads correctly.',
];

// Activity well (§8 · log)
const activity: [string, string, string][] = [
  ['14:22', 'ok', 'ingest scaled to 24 tasks'],
  ['14:19', 'warn', 'ingest p95 above 500ms threshold'],
  ['14:04', '', 'search reindex complete — 4.1M docs'],
  ['13:51', 'err', 'billing health check failed (3/3)'],
  ['13:32', 'ok', 'auth deployed — 8f2c91a'],
  ['12:57', 'ok', 'api-gateway deployed — 3d10bb4'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#101118" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://shupp.dev/design/void" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://shupp.dev/design/void" />
    <meta property="og:image" content="https://shupp.dev/images/projects/void.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://shupp.dev/images/projects/void.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- VOID drop-in layer (self-imports its own fonts) -->
    <link rel="stylesheet" href="/void/void.css" />

    <style is:global>
      /* =====================================================================
         Showcase-only chrome (ds-*). Reads VOID tokens; mints no new
         surface value and no new shadow. Every framed object below is one of
         the four presets plus layout — including the specimens.
         ===================================================================== */

      html { scroll-behavior: smooth; }
      body { padding-bottom: 5rem; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }

      .ds-skip {
        position: absolute; left: -999px; top: 0; z-index: 100;
        background: var(--s2); color: var(--ink);
        padding: 0.6rem 1rem; border-radius: var(--r-sm);
      }
      .ds-skip:focus { left: 0.5rem; top: 0.5rem; }

      /* ---- sticky control bar ------------------------------------------- */
      .ds-bar { position: sticky; top: 0; z-index: 80; }

      /* The page rail is a readout that is always on screen, so it takes no
         hue — I5 reserves tint for state, and "how far down am I" is not one. */
      .ds-rail { height: 6px; border-radius: 0; }
      .ds-rail i { border-radius: 0; box-shadow: 0 0 0 1.5px var(--edge); }

      .ds-controls {
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem;
        padding: 0.7rem clamp(0.9rem, 4vw, 3rem);
        background: var(--s1);
        border-bottom: 1.5px solid var(--edge);
      }
      .ds-brand {
        display: inline-flex; align-items: center; gap: 0.55rem;
        font: 500 12px/1 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--ink-3); text-decoration: none; margin-right: auto;
      }
      .ds-brand:hover { color: var(--ink-2); }

      .ds-lightctl { display: flex; align-items: center; gap: 0.7rem; }
      .ds-lightctl label {
        font: 500 11px/1 var(--font-ui); letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--ink-3);
      }
      /* The track is a sunk well and the thumb is a ceramic disc — the slider
         is not a special case, it is two presets. The well is drawn on the
         wrapper so the input itself can be a 44px hit target at 10px of ink. */
      .ds-track {
        position: relative; display: flex; align-items: center;
        height: 44px; width: clamp(110px, 18vw, 190px);
      }
      .ds-track::before {
        content: ''; position: absolute; left: 0; right: 0; top: 50%;
        height: 10px; margin-top: -5px; border-radius: 5px;
        background: var(--s1); pointer-events: none;
        box-shadow:
          0 0 0 1.5px var(--edge),
          inset calc(var(--lx) * 3px) calc(var(--ly) * 3px) 10px -4px rgba(0, 0, 0, 0.9),
          inset calc(var(--lx) * -1.5px) calc(var(--ly) * -1.5px) 0 rgba(255, 255, 255, 0.09);
      }
      .ds-lightctl input[type='range'] {
        -webkit-appearance: none; appearance: none;
        position: relative; width: 100%; height: 44px; margin: 0;
        background: transparent; outline: none; border-radius: 5px;
      }
      .ds-lightctl input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none;
        width: 20px; height: 20px; border-radius: 50%; cursor: pointer;
        background: var(--s3);
        box-shadow: 0 0 0 1.5px var(--edge), inset 0 1.5px 0 rgba(255, 255, 255, 0.26);
      }
      .ds-lightctl input[type='range']::-moz-range-thumb {
        width: 20px; height: 20px; border-radius: 50%; cursor: pointer; border: 0;
        background: var(--s3);
        box-shadow: 0 0 0 1.5px var(--edge), inset 0 1.5px 0 rgba(255, 255, 255, 0.26);
      }
      .ds-lightctl input[type='range']:focus-visible {
        box-shadow: 0 0 0 1.5px var(--edge), inset 0 0 0 1.5px rgb(var(--hue-info) / 0.75);
      }
      .ds-brand { min-height: 44px; }

      .ds-readout {
        margin: 0; font: 400 12px/1 var(--font-mono); color: var(--ink-3);
        font-variant-numeric: tabular-nums; white-space: nowrap;
      }
      .ds-readout b { color: var(--ink-2); font-weight: 400; }

      /* ---- page ---------------------------------------------------------- */
      .ds-page { max-width: 1080px; margin: 0 auto; padding: 0 clamp(0.9rem, 4vw, 3rem); }

      .ds-hero { padding: clamp(2.2rem, 6vw, 4rem) 0 1.5rem; }
      .ds-hero .void-crumbs { margin-bottom: 1.1rem; }
      .ds-hero h1 { font-size: clamp(26px, 5vw, 44px); margin: 0.7rem 0 0; }
      .ds-aside {
        display: block; margin-top: 0.8rem;
        font: 200 italic 16px/1.4 var(--font-text); color: var(--ink-2);
      }
      .ds-intro { max-width: 62ch; margin-top: 1.1rem; }

      .ds-section { padding: 2.6rem 0 0; }
      .ds-section > header { margin-bottom: 1.3rem; padding-top: 2.2rem; border-top: 1.5px solid var(--edge); }
      .ds-section > header > .void-eyebrow { margin-bottom: 0.55rem; }
      .ds-section header p { max-width: 66ch; margin-top: 0.6rem; }
      .ds-section header p code, .ds-rule code, .ds-anti code {
        font: 400 0.92em/1 var(--font-mono); color: var(--ink);
      }

      .ds-grid { display: grid; gap: 14px; }
      .ds-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .ds-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .ds-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .ds-split { display: grid; gap: 14px; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }

      @media (max-width: 860px) {
        .ds-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .ds-grid--3, .ds-grid--2, .ds-split { grid-template-columns: minmax(0, 1fr); }
      }

      .ds-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
      .ds-stack { display: flex; flex-direction: column; gap: 10px; }
      .ds-spec { display: grid; gap: 10px; justify-items: center; text-align: center; }
      .ds-cap { font: 300 12px/1.4 var(--font-text); color: var(--ink-2); margin: 0; }
      .ds-note { margin-top: 0.7rem; }

      pre.ds-code {
        margin: 14px 0 0; padding: 15px 17px; border-radius: var(--r-sm);
        overflow-x: auto; font: 400 11.5px/1.7 var(--font-mono); color: var(--ink-2);
        overscroll-behavior-x: contain;
      }

      /* ---- numbered rules / anti-pattern table ---------------------------- */
      .ds-rule, .ds-anti {
        display: flex; gap: 14px; align-items: flex-start;
        padding: 12px 0; border-bottom: 1px solid rgb(var(--wash) / calc(var(--wash-a) + 0.02));
      }
      .ds-rule:last-child, .ds-anti:last-child { border-bottom: 0; }
      .ds-rule .n { font: 400 11px/1.6 var(--font-mono); color: var(--ink-3); width: 26px; flex: 0 0 auto; }
      .ds-rule p, .ds-anti p { margin: 0; font: 300 13.5px/1.55 var(--font-text); color: var(--ink); }
      .ds-rule p b, .ds-anti p b { font: 500 13.5px/1.55 var(--font-ui); display: block; }
      .ds-anti .x { flex: 0 0 auto; margin-top: 2px; }
      .ds-anti p span { color: var(--ink-2); }

      /* ---- §1 boundary A/B ------------------------------------------------ */
      .ds-ab { display: flex; flex-wrap: wrap; gap: 26px; align-items: flex-end; }
      .ds-slab {
        width: 132px; height: 132px; border-radius: 50%;
        display: grid; place-items: center;
      }
      /* the control: same fill, hairline alone, no pair */
      .ds-bare { background: var(--s2); box-shadow: 0 0 0 1.5px var(--edge); }
      .ds-swatch-hex { font: 400 11px/1 var(--font-mono); color: var(--ink-3); }

      /* strip the pair — proves the fill is doing none of the work */
      body.ds-stripped .lit,
      body.ds-stripped .lit--ceramic,
      body.ds-stripped .lit--sunk,
      body.ds-stripped .lit--status { box-shadow: 0 0 0 1.5px var(--edge) !important; }
      body.ds-stripped .icon { filter: none !important; }

      /* greyscale audit — I8: hue is never the sole carrier of meaning */
      .ds-greyscale { filter: grayscale(1); }

      /* ---- §3 surfaces ---------------------------------------------------- */
      .ds-surface {
        min-height: 92px; border-radius: var(--r-md); padding: 12px 13px;
        display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
      }
      .ds-surface .nm { font: 400 12px/1 var(--font-mono); color: var(--ink); }
      .ds-surface .rl { font: 300 11.5px/1.3 var(--font-text); color: var(--ink-3); }

      /* ---- §6 light monitor ---------------------------------------------- */
      .ds-monitor p { margin: 0.3rem 0 0; }
      .ds-monitor b { color: var(--ink); font-weight: 400; }
      .ds-vector {
        width: 118px; height: 118px; border-radius: 50%;
        position: relative; display: grid; place-items: center; flex: 0 0 auto;
      }
      /* The needle pivots on the disc centre: it spans from 42px above the
         centre down to it, with its origin at the bottom end. */
      .ds-vector i {
        position: absolute; left: 50%; top: calc(50% - 42px);
        width: 2px; height: 42px;
        margin-left: -1px; border-radius: 1px; background: var(--edge);
        transform-origin: 50% 100%;
      }
      .ds-vector u {
        display: block; width: 9px; height: 9px; border-radius: 50%;
        background: var(--s3); box-shadow: 0 0 0 1.5px var(--edge); position: relative;
      }

      /* ---- §7 ring -------------------------------------------------------- */
      .ds-ring-wrap { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
      .ds-ring-meta { min-width: 0; flex: 1; }
      .ds-ring-meta .sha { font: 400 12px/1 var(--font-mono); color: var(--ink-3); }
      .ds-ring-meta .msg { font: 300 13.5px/1.45 var(--font-text); color: var(--ink); margin-top: 6px; }

      /* ---- §8 nav rail ---------------------------------------------------- */
      .ds-rail {
        display: flex; gap: 8px; overflow-x: auto; padding: 9px;
        border-radius: var(--r-md); scrollbar-width: none; overscroll-behavior-x: contain;
      }
      .ds-rail::-webkit-scrollbar { display: none; }
      .ds-chip {
        display: inline-flex; align-items: center; gap: 9px; flex: 0 0 auto;
        min-height: 40px; padding: 0 15px; border: 0; border-radius: 20px;
        background: transparent; color: var(--ink-2);
        font: 500 13px/1 var(--font-ui); cursor: pointer; white-space: nowrap;
      }
      .ds-chip[aria-current='true'] {
        color: var(--ink); background: var(--s2);
        box-shadow: 0 0 0 1.5px var(--edge), inset 0 1.5px 0 rgba(255, 255, 255, 0.14);
      }
      .ds-chip .tick {
        width: 6px; height: 6px; border-radius: 50%;
        background: rgb(var(--glow, var(--hue-neutral)) / 0.8);
        box-shadow: 0 0 0 1.5px var(--edge); flex: 0 0 auto;
      }

      /* ---- §9 icons ------------------------------------------------------- */
      .ds-set { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }
      .ds-cell {
        border-radius: var(--r-md); padding: 16px 8px 11px;
        display: grid; justify-items: center; gap: 11px;
      }
      .ds-cell .nm { font: 400 10px/1.3 var(--font-mono); color: var(--ink-3); text-align: center; word-break: break-word; }

      /* ---- §10 type ------------------------------------------------------- */
      .ds-type > div + div { margin-top: 1.2rem; }
      .ds-type .meta { font: 400 11px/1 var(--font-mono); color: var(--ink-3); }
      .ds-type p { margin: 0.45rem 0 0; }

      /* ---- footer --------------------------------------------------------- */
      .ds-footer {
        max-width: 1080px; margin: 3.5rem auto 0;
        padding: 2rem clamp(0.9rem, 4vw, 3rem) 0;
        border-top: 1.5px solid var(--edge);
      }
      .ds-footer a { color: var(--ink-2); }
      .ds-footer p { font: 400 12.5px/1.8 var(--font-mono); color: var(--ink-3); margin: 0; }
      /* the checklist sits in a well: an incision needs a surface to cut into,
         and the page floor is not one */
      .ds-check {
        list-style: none; margin: 1.2rem 0 0; padding: 14px 18px;
        max-width: 82ch; border-radius: var(--r-md);
      }
      .ds-check li {
        display: flex; gap: 11px; align-items: flex-start; padding: 6px 0;
        font: 300 13px/1.5 var(--font-text); color: var(--ink-2);
      }
      .ds-check .icon { margin-top: 3px; }

      /* ---- the size × style matrix -------------------------------------- */
      /* one row per style, one column per size, every cell centred on its
         row so the five sizes can be compared across a single baseline */
      .ds-matrix {
        display: grid;
        grid-template-columns: 62px repeat(5, minmax(0, 1fr));
        gap: 14px 12px;
        align-items: center;
        overflow-x: auto;
        min-width: 0;
      }

      .ds-matrix-cell { display: flex; align-items: center; }
      .ds-matrix-head { text-align: left; }

      .ds-matrix-label {
        font: 400 10.5px/1.3 var(--font-mono);
        color: var(--ink-3);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      .ds-scale-row {
        display: grid;
        grid-template-columns: 62px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: baseline;
      }

      .ds-scale-sizes { text-align: right; }

      .ds-tokens {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(196px, 1fr));
        gap: 10px 18px;
      }

      .ds-token {
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr) auto;
        grid-template-areas: 'chip name val' 'chip role val';
        gap: 0 10px;
        align-items: center;
      }

      .ds-token-chip {
        grid-area: chip;
        width: 22px;
        height: 22px;
        border-radius: 50%;
      }

      .ds-token-name { grid-area: name; font: 400 11.5px/1.4 var(--font-mono); color: var(--ink); }
      .ds-token-role { grid-area: role; font: 300 11px/1.3 var(--font-text); color: var(--ink-3); }
      .ds-token-val {
        grid-area: val;
        font: 400 10px/1.4 var(--font-mono);
        color: var(--ink-3);
        text-align: right;
      }

      .ds-hex { font: 400 10px/1.3 var(--font-mono); opacity: 0.75; }

      @media (max-width: 720px) {
        .ds-controls { gap: 0.4rem 0.5rem; padding: 0.4rem clamp(0.9rem, 4vw, 3rem); }
        /* the live readout is duplicated by §6's monitor, and the label is
           carried by the input's aria-label — at this width the sticky bar
           is worth more than either duplicate. One 44px row, not three. */
        .ds-readout, .ds-brand-long, .ds-lightctl label { display: none; }
        .ds-track { width: 84px; }
        .ds-lightctl { gap: 0; }
        .ds-slab { width: 106px; height: 106px; }
        .ds-ab { gap: 18px; }
      }
    </style>
  </head>

  <body>
    <!-- Dither. Mandatory: untreated, the default preset rings on OLED. -->
    <div class="void-dither" aria-hidden="true"></div>

    <a class="ds-skip" href="#ds-main">Skip to content</a>

    <!-- =========================================================
         SPRITE — 24×24 viewBox, stroke only, round terminals,
         angles at 0/45/90 with arcs otherwise.
    ========================================================== -->
    <VoidSprite />

    <!-- ===================== STICKY CONTROL BAR ========================= -->
    <div class="ds-bar">
    <div class="ds-controls" role="region" aria-label="VOID controls">
      <a class="ds-brand" href="/portfolio">
        <svg class="icon icon--xs icon--mark" aria-hidden="true"><use href="#i-chevron-left" /></svg>
        <span class="ds-brand-long">shupp.dev / </span>portfolio
      </a>

      <div class="ds-lightctl">
        <label for="ds-azimuth">Light</label>
        <span class="ds-track">
          <input
            id="ds-azimuth" type="range" min="0" max="359" step="1" value="347"
            aria-label="Resting azimuth of the global light, in degrees clockwise from overhead"
          />
        </span>
      </div>

      <p class="ds-readout" aria-live="off">
        --lx <b id="ds-lx">-0.220</b> · --ly <b id="ds-ly">-0.975</b> · loop <b id="ds-loop">asleep</b>
      </p>

      <button id="ds-strip" class="void-pill void-pill--ghost" type="button" aria-pressed="false">
        Strip the pair
      </button>
    </div>

    <!-- read position: a readout, not a decoration -->
    <div class="ds-rail void-rail lit lit--sunk" data-rail aria-hidden="true"><i></i></div>
    </div>

    <main id="ds-main" class="ds-page">
      <!-- =========================== HERO =============================== -->
      <header class="ds-hero">
        <nav class="void-crumbs" aria-label="Breadcrumb">
          <a href="/">shupp.dev</a>
          <svg class="icon icon--xs icon--mark" aria-hidden="true"><use href="#i-chevron-right" /></svg>
          <a href="/portfolio">Design</a>
          <svg class="icon icon--xs icon--mark" aria-hidden="true"><use href="#i-chevron-right" /></svg>
          <span aria-current="page">Void</span>
        </nav>

        <p class="void-eyebrow">VOID · v1.1 · CERAMIC MATERIAL</p>
        <h1 class="void-display">Void</h1>
        <span class="ds-aside">Depth lives at the edge of a thing, never inside it.</span>
        <p class="void-text ds-intro">
          A dark, single-mode system built on one perceptual trick. Every object is drawn with a 1.5px hairline of absolute black; a hard, short light gradient
          sits immediately inside it and a soft, long dark one immediately outside.
          The asymmetry drives lateral inhibition harder than a real edge would, so a
          face that is one flat colour edge to edge reads as glazed, lifted material.
          Two objects filled with the same hex can be two different substances.
          Press <span style="color: var(--ink)">Strip the pair</span> above to take the
          gradients away and watch the page fall flat — the fill never changes.
        </p>
      </header>

      <!-- ========================= 1 · BOUNDARY ========================== -->
      <section class="ds-section" aria-labelledby="ds-boundary">
        <header>
          <p class="void-eyebrow">INVARIANTS I1–I3 · THE BOUNDARY</p>
          <h2 id="ds-boundary" class="void-h2">One hairline, two unequal gradients</h2>
          <p class="void-text">
            The mechanism is the Cornsweet illusion. All three discs below are filled
            with exactly <code>--s2</code> — sample the centre of each with a colour
            picker and you get the same value. Only the twelve pixels either side of
            their edge differ.
          </p>
        </header>

        <div class="ds-ab">
          <div class="ds-spec">
            <div class="ds-slab ds-bare"></div>
            <p class="ds-cap">hairline alone<br /><span class="ds-swatch-hex" data-token="--s2"></span></p>
          </div>
          <div class="ds-spec">
            <div class="ds-slab lit lit--sz-sm"></div>
            <p class="ds-cap">.lit — pair + decay<br /><span class="ds-swatch-hex" data-token="--s2"></span></p>
          </div>
          <div class="ds-spec">
            <div class="ds-slab lit lit--ceramic"></div>
            <p class="ds-cap">.lit--ceramic — decay 0<br /><span class="ds-swatch-hex" data-token="--s2"></span></p>
          </div>
          <div class="ds-spec">
            <div class="ds-slab lit lit--sunk"></div>
            <p class="ds-cap">.lit--sunk — pair inverted<br /><span class="ds-swatch-hex" data-token="--s1"></span></p>
          </div>
        </div>

        <div class="void-card lit" style="margin-top: 22px">
          <div class="ds-rule">
            <span class="n">I1</span>
            <p><b>The hairline is #000000, 1.5px, always</b>On every object, at every size. It never scales, never takes a colour, never becomes a border-width token. It is a boundary marker, not a stroke weight.</p>
          </div>
          <div class="ds-rule">
            <span class="n">I2</span>
            <p><b>The page is never black</b>Absolute black has to be darker than its surround, or the hairline stops reading as a void and starts reading as fill. The page floor is <code>--s0</code>, #101118.</p>
          </div>
          <div class="ds-rule">
            <span class="n">I3</span>
            <p><b>The pair is asymmetric</b>Inside: hard and short — 1.5px offset, zero blur. Outside: soft and long — 7 to 9px offset, 12 to 16px blur. Symmetric decay cancels the illusion and leaves you with something merely blurry.</p>
          </div>
          <div class="ds-rule">
            <span class="n">I6</span>
            <p><b>Fills are flat</b>A component has one background value. All variation lives in <code>box-shadow</code>. There is no gradient anywhere in this system that is not a shadow.</p>
          </div>
        </div>
      </section>

      <!-- ========================= 2 · SURFACES ========================== -->
      <section class="ds-section" aria-labelledby="ds-surfaces">
        <header>
          <p class="void-eyebrow">§3 · SURFACE LADDER</p>
          <h2 id="ds-surfaces" class="void-h2">Four values, lightest object on darkest page</h2>
          <p class="void-text">
            Each step is roughly +6 per channel. Four surfaces is the whole ladder — a
            design that appears to need a fifth needs a different depth preset instead.
            Status hues sit at low chroma deliberately: a 1.5px band at 42% alpha against
            <code>--s2</code> is already near the perceptual limit, and saturated hue
            blooms on near-black panels. To make a state clearer, raise
            <code>--lift</code>, never the saturation.
          </p>
        </header>

        <div class="ds-grid ds-grid--4">
          {surfaces.map((s) => (
            <div class="ds-surface lit lit--ceramic" style={`background: var(${s.name})`}>
              <span class="nm">{s.name}</span>
              <span class="rl">{s.role}</span>
              <span class="rl ds-hex" data-token={s.name}></span>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== 3 · DEPTH =========================== -->
      <section class="ds-section" aria-labelledby="ds-depth">
        <header>
          <p class="void-eyebrow">§4 · THE DEPTH PRIMITIVE</p>
          <h2 id="ds-depth" class="void-h2">Three presets over one shadow structure</h2>
          <p class="void-text">
            Material light is directional and always white (I4) — it describes what an
            object is made of, never what it is doing. <code>--decay</code> and
            <code>--bleed</code> are relative and scale with the object; the hairline is
            absolute and does not. Below 80px the decay band has no room to resolve, so
            switch to ceramic rather than continuing to compress it.
          </p>
        </header>

        <div class="ds-grid ds-grid--3">
          <div class="void-card lit">
            <h3>.lit</h3>
            <p class="void-text">The default. Four layers: black bleed, hairline, hard contact light, soft inward decay. Everything rectangular that is not an input.</p>
            <pre class="ds-code">{`--lift: 0.19;
--bleed: 12px;
--decay: 15px;
background: var(--s2);`}</pre>
          </div>
          <div class="void-card lit lit--ceramic">
            <h3>.lit--ceramic</h3>
            <p class="void-text">Decay zero. No interior information at all — the purest form of the thesis, the cheapest to draw, and the only preset that cannot band.</p>
            <pre class="ds-code">{`--lift: 0.26;
--bleed: 16px;
/* no decay layer */`}</pre>
          </div>
          <div class="void-card lit lit--sunk">
            <h3>.lit--sunk</h3>
            <p class="void-text">The pair inverted. One flip supplies the entire input vocabulary: field wells, toggle tracks, progress channels, log panels, pressed buttons.</p>
            <pre class="ds-code">{`background: var(--s1);
inset (dark) · inside
inset (light) · outside`}</pre>
          </div>
        </div>

        <div class="void-card lit ds-note">
          <div class="ds-rule">
            <span class="n">↕</span>
            <p><b>Scale rule</b>decay ≈ 0.07 × min(w, h) · bleed ≈ 0.06 × min(w, h) · lift = clamp(0.19 + 0.14 × (1 − size/200), 0.19, 0.34). Small objects get a shorter, brighter band.</p>
          </div>
          <div class="ds-rule">
            <span class="n">◫</span>
            <p><b>Dither is not optional polish</b>A gradient from #000 to #14151a crosses about twenty 8-bit levels over hundreds of pixels; untreated, <code>.lit</code> shows concentric rings on OLED. This page carries one fixed <code>feTurbulence</code> overlay at 2.8%, and the WebGL ring dithers in-shader at ±0.5/255.</p>
          </div>
        </div>
      </section>

      <!-- ========================== 4 · STATUS =========================== -->
      <section class="ds-section" aria-labelledby="ds-status">
        <header>
          <p class="void-eyebrow">§5 · THE STATUS PRIMITIVE</p>
          <h2 id="ds-status" class="void-h2">State light is omnidirectional and tinted</h2>
          <p class="void-text">
            <code>inset 0 0 0 1.5px</code> — no offset, no blur. A complete, even ring is
            something no light position could ever produce, which is precisely why hue can
            never be misread as lighting (I5). Status is a token, not a component, so the
            same signal works at a 6px dot and a 116px disc with no second implementation.
            Note that <code>--lift</code> is 0.42 here against 0.19 for neutral: that is
            matched <em>luminance</em>, not matched alpha.
          </p>
        </header>

        <div id="ds-status-demo">
          <div class="ds-grid ds-grid--4">
            {statuses.map((s) => (
              <div class="void-card lit ds-stack">
                <div class="ds-row" style="gap: 12px">
