---
import SaasGameUI from '../../components/design/SaasGameUI/SaasGameUI';
import { isFeatureEnabled } from '../../config/features';

// Standalone character-and-object interaction study with local Inter typography.
if (!isFeatureEnabled('enableSaasGameUI')) return Astro.redirect('/portfolio');

const title = 'SaaS Game UI — Your character, your work | shupp.dev';
const description = 'A character-driven SaaS interface: walk to objects, discover contextual actions, and change the app. A smooth illustrated 2D study with configurable objects.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <link rel="canonical" href="https://shupp.dev/design/saas-game-ui" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/saas-game-ui/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/saas-game-ui/saas-game-ui.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://shupp.dev/design/saas-game-ui" />
    <meta property="og:image" content="https://shupp.dev/images/projects/saas-game-ui.png" />
    <meta property="og:image:alt" content="An illustrated workroom where a character interacts with an archive, a writing desk, and a review stand." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="sg-document">
    <SaasGameUI client:load />
    <noscript><p class="sg-noscript">JavaScript is off. Enable it to move your character, interact with objects, and configure the sample room.</p></noscript>
  </body>
</html>
