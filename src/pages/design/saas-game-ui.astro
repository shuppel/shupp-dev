---
import SaasGameUI from '../../components/design/SaasGameUI/SaasGameUI';
import { isFeatureEnabled } from '../../config/features';

// Standalone playable 2D harness encounter with local Inter typography.
if (!isFeatureEnabled('enableSaasGameUI')) return Astro.redirect('/portfolio');

const title = 'SaaS Game UI — Play the AI harness | shupp.dev';
const description = 'A playable 2D RPG interface for an AI harness. Walk, collect context, equip your party, target commands, recover a patch, and verify the result.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="canonical" href="https://shupp.dev/design/saas-game-ui" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/saas-game-ui/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/saas-game-ui/saas-game-ui.css" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://shupp.dev/design/saas-game-ui" />
    <meta property="og:image" content="https://shupp.dev/images/projects/saas-game-ui.png" />
    <meta property="og:image:alt" content="A playable illustrated 2D field with an operator, two agents, context objects, a task target, and JRPG command menus." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="sg-document">
    <SaasGameUI client:load />
    <noscript><p class="sg-noscript">JavaScript is off. Enable it to play the encounter: move your character, collect context, equip agents, target commands, and verify the patch.</p></noscript>
  </body>
</html>
