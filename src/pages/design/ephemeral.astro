---
const title = 'Ephemeral — a system for the moment';
const description = 'Intent fields, adaptive briefs, social cards, conversation threads, and quiet endings. A flat interface system in black, white, and neon canary.';
const icons: Record<string, string> = {
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  search: 'M10 17a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 6 6',
  sliders: 'M4 7h9m4 0h3M4 17h3m4 0h9M13 4v6M7 14v6',
  save: 'M6 3h12v18l-6-4-6 4V3Z',
  check: 'm5 12 4 4L19 6',
  thread: 'M4 4h16v12H9l-5 4V4Zm4 4h8m-8 4h5',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1',
  half: 'M3 17h18M5 14a7 7 0 0 1 14 0M12 2v3M3 6l2 2m16-2-2 2',
  moon: 'M20 15A9 9 0 0 1 9 4a9 9 0 1 0 11 11Z',
  layers: 'm12 3 10 5-10 5L2 8l10-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  close: 'm6 6 12 12M6 18 18 6',
  home: 'm3 10 9-7 9 7v11H3V10Zm6 11v-8h6v8',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 4v5l3 2',
  spark: 'm12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" /><meta name="theme-color" content="#f4ff00" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href="https://shupp.dev/design/ephemeral/" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
    <meta property="og:url" content="https://shupp.dev/design/ephemeral/" />
    <link rel="icon" href="/favicon.svg" /><link rel="preload" href="/ephemeral/fonts/martel-regular.woff" as="font" type="font/woff" crossorigin />
    <link rel="stylesheet" href="/ephemeral/ephemeral.css" />
  </head>
  <body>
    <svg class="icon-sprite" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>{Object.entries(icons).map(([name, d]) => <symbol id={`ep-${name}`} viewBox="0 0 24 24"><path d={d} /></symbol>)}</defs></svg>
    <a class="skip-link" href="#components">Skip to components</a>
    <header class="site-header wrap">
      <a class="wordmark" href="#"><span class="brand-mark">e.</span> ephemeral</a>
      <nav aria-label="Page"><a href="#foundations">Foundations</a><a href="#components">Components</a><a href="#experience">In use ↗</a></nav>
      <a class="site-origin" href="/portfolio">shupp.dev ↗</a>
    </header>
    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Design system / 02</p><h1 id="hero-title">Small pieces.<br /><em>For right now.</em></h1><p>Components that gather around an intent.<br />Useful for a moment. Easy to leave.</p><a class="solid-button" href="#components">Explore the kit <svg class="icon" aria-hidden="true"><use href="#ep-arrow" /></svg></a></div>
        <div class="hero-composition" aria-label="Example: a request becomes a brief and a saved item">
          <div class="floating-query"><svg class="icon" aria-hidden="true"><use href="#ep-spark" /></svg><span>Catch me up. Three minutes.</span><span class="key-cap">↵</span></div>
          <div class="hero-brief"><div class="mini-toolbar"><span class="tag yellow">Your quick brief</span><svg class="icon" aria-hidden="true"><use href="#ep-sun" /></svg></div><h2>A little less<br />to catch up on.</h2><div class="mini-story"><span>01</span><span>Fold opens its beta</span><span>↗</span></div><div class="mini-story"><span>02</span><span>Room for unfinished ideas</span><span>↗</span></div><div class="mini-foot"><span class="avatar-stack"><span>MC</span><span>IR</span><span>LN</span></span><span>From people you follow</span></div></div>
          <div class="floating-saved"><span class="round-icon yellow"><svg class="icon" aria-hidden="true"><use href="#ep-save" /></svg></span><div><strong>One for later.</strong><span>The thought stays. The view goes.</span></div><svg class="icon" aria-hidden="true"><use href="#ep-check" /></svg></div>
        </div>
      </section>

      <section class="foundations wrap" id="foundations" aria-labelledby="foundation-title">
        <div class="section-label"><h2 id="foundation-title">The essentials</h2><a class="token-link" href="/ephemeral/ephemeral.tokens.json">Design tokens ↗</a></div>
        <div class="foundation-grid">
          <article class="foundation-item"><h3>01 / Color</h3><div class="swatches"><div><span class="swatch ink"></span><span>Ink<br /><code>#000000</code></span></div><div><span class="swatch paper"></span><span>Paper<br /><code>#FFFFFF</code></span></div><div><span class="swatch canary"></span><span>Canary<br /><code>#F4FF00</code></span></div></div><p>Yellow marks intention, selection, and action.</p></article>
          <article class="foundation-item"><h3>02 / Type</h3><div class="type-samples"><div><span class="serif-sample">Aa</span><span>Martel / expression</span></div><div><span class="sans-sample">Aa</span><span>Nunito Sans / interface</span></div></div><p>One expressive voice. One familiar interface.</p></article>
          <article class="foundation-item"><h3>03 / Form</h3><div class="form-samples"><div><span class="shape border-shape"></span><span>1 px line</span></div><div><span class="shape radius-shape"></span><span>12 px corner</span></div><div><span class="shape pill-shape"></span><span>Full pill</span></div></div><p>Flat fills. No shadows. An 8 px spacing base.</p></article>
        </div>
      </section>

      <section class="components wrap" id="components" aria-labelledby="components-title">
        <div class="section-heading"><div><p class="eyebrow">02 / The component kit</p><h2 id="components-title">Familiar pieces.<br />Flexible company.</h2></div><span class="tag">Try the controls ↓</span></div>
        <div class="specimen-grid">
          <article class="specimen specimen-intent"><header class="specimen-label"><h3>Intent field</h3><span>01 / Ask → compose</span></header><div class="specimen-body">
            <form id="specimen-form"><label class="eyebrow" for="specimen-query">Make room for what you need</label><div class="specimen-query"><svg class="icon" aria-hidden="true"><use href="#ep-spark" /></svg><input id="specimen-query" value="Catch me up" aria-describedby="specimen-hint" maxlength="120" /><button type="submit" class="icon-button yellow" aria-label="Compose sample brief"><svg class="icon" aria-hidden="true"><use href="#ep-arrow" /></svg></button></div></form>
            <div class="chip-row" role="group" aria-label="Example brief size"><button type="button" data-spec-query="Catch me up" aria-pressed="true">Three things</button><button type="button" data-spec-query="One thing, please" aria-pressed="false">Just one</button></div>
            <p id="specimen-hint" class="micro">Try “catch me up” or “one thing.”</p><div id="specimen-results" class="mini-results" aria-live="polite"><span><i>01</i> Fold beta</span><span><i>02</i> Less interface</span><span><i>03</i> Open studio</span></div>
          </div><footer>One request changes the number of pieces.</footer></article>
          <article class="specimen"><header class="specimen-label"><h3>Preference switches</h3><span>02 / Refine</span></header><div class="specimen-body preference-specimen"><div class="switch-heading"><svg class="icon" aria-hidden="true"><use href="#ep-sliders" /></svg><strong>A little more you.</strong></div><label class="switch-row"><span>Keep it short<small>One thought at a time</small></span><input class="switch" type="checkbox" id="specimen-short" checked /></label><label class="switch-row"><span>Design &amp; tools<small>Leave everything else out</small></span><input class="switch" type="checkbox" id="specimen-design" /></label><div class="preference-preview" id="preference-preview" aria-live="polite"><span class="tag yellow">Brief</span><span>All interests · 3 pieces</span></div></div><footer>Preferences change the composition.</footer></article>
          <article class="specimen"><header class="specimen-label"><h3>Social post</h3><span>03 / A familiar anchor</span></header><div class="specimen-body"><div class="sample-post"><header><span class="avatar">MC</span><div><strong>Mara Chen</strong><span>@marac · 07:10</span></div><span class="tag">Following</span></header><p>Less interface takes more editorial work.</p><div class="post-attachment"><span class="attachment-glyph" aria-hidden="true">Aa</span><div><strong>The space we left</strong><span>A note on removing half the labels.</span></div><svg class="icon" aria-hidden="true"><use href="#ep-arrow" /></svg></div><div class="sample-actions"><span><svg class="icon" aria-hidden="true"><use href="#ep-thread" /></svg> A thought worth keeping</span><button class="icon-button" type="button" id="specimen-save" aria-label="Save example post" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#ep-save" /></svg></button></div><p class="micro" id="specimen-save-status" role="status">Save for this page visit.</p></div></div><footer>Identity, content, source, and one next action.</footer></article>
          <article class="specimen"><header class="specimen-label"><h3>Conversation thread</h3><span>04 / Find the context</span></header><div class="specimen-body"><div class="thread-sample"><div class="thread-row"><span class="avatar dark">F</span><div class="message"><strong>Fold team <span>07:00</span></strong><p>Comments now live beside the prototype.</p></div></div><div class="thread-row reply"><span class="avatar">IR</span><div class="message"><strong>Ivo Reed <span>07:30</span></strong><p>One fewer screenshot to paste.</p></div></div></div><details class="sample-source"><summary><svg class="icon" aria-hidden="true"><use href="#ep-layers" /></svg> See the original posts <span>+</span></summary><p>Fold beta lets a team leave comments on a shared prototype. Ivo reports that the comments stay attached to the scene under review.</p></details></div><footer>Connection stays visible. Evidence opens on demand.</footer></article>
          <article class="specimen"><header class="specimen-label"><h3>Reading card</h3><span>05 / Slow down</span></header><div class="specimen-body reading-specimen"><div class="reading-cover" aria-hidden="true"><span class="cover-orbit"></span><span class="cover-window"></span><span class="cover-label">ROOM<br />TO WANDER.</span><span class="cover-index">E / 05</span></div><div class="reading-caption"><div><span class="eyebrow">Niko Vale / A short read</span><h4>A little room to wander.</h4></div><details class="sample-source"><summary>Read <span>↗</span></summary><p>The nicest part of a bookshop is finding something I did not arrive looking for. I am trying to leave that kind of room in a digital collection.</p></details></div></div><footer>A distinct format for a different pace.</footer></article>
          <article class="specimen"><header class="specimen-label"><h3>Completion state</h3><span>06 / Release</span></header><div class="specimen-body release-specimen"><div id="specimen-complete"><span class="completion-glyph"><svg class="icon" aria-hidden="true"><use href="#ep-check" /></svg></span><h4>You’re caught up.</h4><p>Keep the thought. Close the view.</p><button class="solid-button" type="button" id="specimen-dismiss">Done for now <svg class="icon" aria-hidden="true"><use href="#ep-arrow" /></svg></button></div><div id="specimen-empty" hidden><span class="empty-glyph" aria-hidden="true">○</span><h4>Room for what’s next.</h4><p id="specimen-kept">Your preferences stay.</p><button class="outline-button" type="button" id="specimen-restore">Bring it back ↺</button></div><span class="sr-only" id="specimen-release-status" role="status"></span></div><footer>A real ending, with something worth keeping.</footer></article>
        </div>
      </section>

      <section class="study wrap" id="experience" aria-labelledby="study-title">
        <div class="section-heading"><div><p class="eyebrow">03 / Components in use</p><h2 id="study-title">One feed.<br />Three ways to be here.</h2></div><p>Same posts. Different intent.<br /><span class="micro">Fictional examples · no inference</span></p></div>
        <div class="day-picker" role="group" aria-label="Sample visit">
          <button type="button" data-visit="morning" aria-pressed="true"><svg class="icon" aria-hidden="true"><use href="#ep-sun" /></svg><strong>Morning</strong><span>08:00</span></button>
          <button type="button" data-visit="afternoon" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#ep-half" /></svg><strong>Afternoon</strong><span>13:00</span></button>
          <button type="button" data-visit="evening" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#ep-moon" /></svg><strong>Evening</strong><span>20:30</span></button>
        </div>
        <div class="visit-context"><p id="visit-context">A few minutes before the day begins.</p><p id="snapshot-label">6 sample posts</p></div>
        <div class="comparison" role="group" aria-label="Interface to compare"><button type="button" data-mode="feed" aria-pressed="false">Regular feed <span>Control</span></button><button type="button" data-mode="ephemeral" aria-pressed="true">Ephemeral <span>Intent-led</span></button></div>
        <div class="app" id="commonplace">
          <header class="app-header"><span class="app-name"><span class="app-symbol" aria-hidden="true">c.</span> commonplace</span><div class="app-actions"><button type="button" id="saved-toggle" aria-expanded="false" aria-controls="saved-panel"><svg class="icon" aria-hidden="true"><use href="#ep-save" /></svg> Saved <span id="saved-count">0</span></button><button type="button" id="preferences-toggle" aria-expanded="false" aria-controls="preferences-panel"><svg class="icon" aria-hidden="true"><use href="#ep-sliders" /></svg> Preferences</button></div></header>
          <div id="preferences-panel" class="preferences" hidden><p class="eyebrow">Shape this visit</p><label><input class="switch" id="design-only" type="checkbox" /> Only design &amp; tools</label><label><input class="switch" id="short-brief" type="checkbox" checked /> Keep my brief short</label><label><input class="switch" id="reading-first" type="checkbox" /> Longer reads first</label></div>
          <section id="saved-panel" class="saved-panel" aria-labelledby="saved-heading" hidden><h3 id="saved-heading">Kept for later</h3><div id="saved-content"></div></section>
          <div class="intent-area" id="intent-area"><form id="intent-form"><label class="eyebrow" for="intent-query">What are you here for?</label><div class="query-line"><svg class="icon" aria-hidden="true"><use href="#ep-spark" /></svg><input id="intent-query" type="text" value="Catch me up. I have three minutes." maxlength="180" autocomplete="off" aria-describedby="query-help" /><button type="submit" aria-label="Apply your intent"><svg class="icon" aria-hidden="true"><use href="#ep-arrow" /></svg></button></div></form><div class="intent-choices" role="group" aria-label="Try an intent at any time"><button type="button" data-intent="brief" aria-pressed="true">Catch me up</button><button type="button" data-intent="focus" aria-pressed="false">Understand Fold</button><button type="button" data-intent="browse" aria-pressed="false">Let me browse</button></div><p id="query-help" class="query-help">Try an intent. Add “only design,” “one minute,” or “longer reads.”</p></div>
          <div id="scene" class="scene"></div><p id="announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
          <footer class="app-footer"><p id="format-note"></p><button type="button" id="why-toggle" aria-expanded="false" aria-controls="why-panel">Why this view? <span>+</span></button></footer><div id="why-panel" class="why-panel" hidden></div>
          <noscript><p class="no-script">Enable JavaScript to use the scripted examples. The component specimens remain visible above.</p></noscript>
        </div>
        <p id="benefit-note" class="study-note">Catch up. Keep something. Carry on.</p>
      </section>
      <section class="rules wrap" aria-label="Composition rules"><div><span>01</span><strong>Intent first.</strong><p>A request chooses the pieces.</p></div><div><span>02</span><strong>Anchors stay.</strong><p>Identity, preferences, saved items.</p></div><div><span>03</span><strong>A view can end.</strong><p>Release the layout. Keep the work.</p></div></section>
    </main>
    <footer class="site-footer wrap"><a href="/portfolio">Erikk Shupp ↗</a><span>Ephemeral / a system for the moment</span><details><summary>Type &amp; credits</summary><p>Martel + Nunito Sans, adapted from <a href="https://fontjoy.com/">Fontjoy</a>. <a href="/ephemeral/fonts/LICENSES.txt">Font licenses</a>. Sample content and responses are authored, not generated.</p></details></footer>
    <script is:inline type="module" src="/ephemeral/ephemeral.js"></script>
  </body>
</html>
