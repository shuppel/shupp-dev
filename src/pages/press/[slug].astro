---
// Every press entry renders as a standalone page (no site sidebar or nav),
// with a JSON twin at /press/<slug>.json. See docs/reading-pages.md.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PressReading from '../../components/Reading/PressReading.astro';

export async function getStaticPaths() {
  const entries = await getCollection('press');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'press'>;
}

const { entry } = Astro.props;
---

<PressReading entry={entry} />
