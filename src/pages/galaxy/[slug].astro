---
// Every galaxy note renders as a standalone reading page (no site sidebar or
// nav), and has a JSON twin at /galaxy/<slug>.json. See docs/reading-pages.md.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import GalaxyReading from '../../components/Reading/GalaxyReading.astro';

export async function getStaticPaths() {
  const entries = await getCollection('galaxy');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'galaxy'>;
}

const { entry } = Astro.props;
---

<GalaxyReading entry={entry} />
