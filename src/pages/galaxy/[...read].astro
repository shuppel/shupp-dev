---
// Galaxy notes on the standalone reading template (see src/lib/reading/galaxy.ts).
// A separate route from [slug].astro so the page ships only reading.css, not
// the site layout's styles. The two routes build disjoint sets of slugs.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import GalaxyReading from '../../components/Reading/GalaxyReading.astro';
import { usesReadingTemplate } from '../../lib/reading/galaxy';

export async function getStaticPaths() {
  const entries = await getCollection('galaxy');
  return entries
    .filter((entry) => usesReadingTemplate(entry.id))
    .map((entry) => ({ params: { read: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'galaxy'>;
}

const { entry } = Astro.props;
---

<GalaxyReading entry={entry} />
