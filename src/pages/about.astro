---
// About, as a standalone reading page with a JSON twin at /about.json.
// No photos: the page is the writing, the details and the ship.
import { getCollection } from 'astro:content';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import { siteConfig } from '../config/site';

const author = (await getCollection('authors'))[0].data;
const bio = author.longBio.split('\n\n').map((p) => p.trim()).filter(Boolean);
const philosophy = [
  ['Fitts optimizing', 'Make the important things easy to reach.'],
  ['Kotter × Parkinson’s law²', 'Create urgency to fill the day.'],
  ['Optimize for outcomes', 'Results over process, always.'],
  ['All meetings are f(x)', 'Every meeting has inputs and outputs.'],
  ['XML prompt chain shotting', 'Structured thinking for complex problems.'],
];
const channels = [
  ['GitHub', author.socialLinks.github ?? siteConfig.social.github],
  ['LinkedIn', author.socialLinks.linkedin ?? siteConfig.social.linkedin],
  ['Bluesky', author.socialLinks.bluesky ?? siteConfig.social.bluesky],
  ['X', author.socialLinks.twitter ?? siteConfig.social.twitter],
  ['Podcast', author.socialLinks.podcast],
].filter(([, u]) => u) as [string, string][];
const groups = [
  ['Technical skills', author.skills ?? []],
  ['Soft skills', author.softSkills ?? []],
  ['Interests', author.interests ?? []],
] as [string, string[]][];
---

<ReadingLayout title="About" description={author.shortBio} terminal="Captain's Quarters" type="website" jsonLdType="person" jsonHref="/about.json" author={author.name}>
  <article>
    <section class="read-hero wrap">
      <div>
        <p class="eyebrow"><span class="status-dot"></span> About / {author.location}</p>
        <h1 class="read-title">{author.name}</h1>
        <p class="read-lede">{author.shortBio}</p>
        <div class="read-meta">
          <a class="solid-button" href="/portfolio/">See the work</a>
          <a class="outline-button" href="/resume">Resume ↗</a>
          <a class="outline-button" href={`mailto:${siteConfig.email}`}>Send a message ↗</a>
        </div>
      </div>
      <figure class="cover panel">
        <header><h2><img src="/atlas/assets/props/logbook.png" alt="" class="px" width="16" height="16" /> Captain's log</h2><span>{author.title}</span></header>
        <div class="cover-art">
          <img src="/atlas/assets/ui/star_map/chart.png" alt="" class="px" width="640" height="360" />
          <img src="/atlas/assets/ships/crescent/exterior.png" alt="The Crescent, the ship this site flies" class="cover-planet" style="width: 62%" width="768" height="448" />
          <span class="cover-label">The Crescent</span>
        </div>
        <footer>{author.location}</footer>
      </figure>
    </section>

    <div class="read-grid read-grid--two wrap">
      <div class="read-body">
        <h2 id="story">The story</h2>
        {bio.map((p) => <p>{p}</p>)}
        <h2 id="philosophy">How I work</h2>
        <ul>
          {philosophy.map(([k, v]) => <li><strong>{k}</strong>. {v}</li>)}
        </ul>
      </div>
      <aside class="read-aside" aria-label="Details">
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_status.png" alt="" class="px" width="16" height="16" /> Profile</h2><span>Crew</span></header>
          <div class="panel-body">
            <dl class="facts">
              <div><img src="/atlas/assets/ui/icon_credential.png" alt="" class="px" width="16" height="16" /><dt>Role</dt><dd>{author.title}</dd></div>
              <div><img src="/atlas/assets/ui/icon_map.png" alt="" class="px" width="16" height="16" /><dt>Based in</dt><dd>{author.location}</dd></div>
              <div><img src="/atlas/assets/props/comms.png" alt="" class="px" width="16" height="16" /><dt>Email</dt><dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd></div>
            </dl>
          </div>
          <footer><a href="/about.json">Read it as JSON ↗</a></footer>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/props/transmission.png" alt="" class="px" width="16" height="16" /> Channels</h2><span>{channels.length}</span></header>
          <div class="panel-body tag-cloud">{channels.map(([n, u]) => <a class="tag" href={u} target="_blank" rel="noopener">{n} ↗</a>)}</div>
        </section>
        {groups.filter(([, l]) => l.length).map(([g, l]) => (
          <section class="panel">
            <header><h2><img src="/atlas/assets/ui/icon_items.png" alt="" class="px" width="16" height="16" /> {g}</h2><span>{l.length}</span></header>
            <div class="panel-body tag-cloud">{l.map((s) => <span class="tag">{s}</span>)}</div>
          </section>
        ))}
      </aside>
    </div>

    <nav class="read-rules wrap" aria-label="Keep browsing">
      <a href="/" data-return><span>01</span><strong>Return to ship</strong><p>Close this page and pick up where you left off.</p></a>
      <a href="/portfolio/"><span>02</span><strong>Portfolio</strong><p>Design systems, apps, shows and sites.</p></a>
      <a href="/galaxy/"><span>03</span><strong>Scribe Galaxy</strong><p>Writing, newest first.</p></a>
    </nav>
  </article>
</ReadingLayout>
