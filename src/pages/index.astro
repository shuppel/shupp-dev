---
// The Scattered Atlas: shupp.dev as a sprite JRPG, and the site's front door.
// The classic homepage (/home) is retired and redirects here.
//
// The page is only a full-screen canvas. Everything the visitor sees is drawn
// by the Bevy game in atlas/. The site content reaches the game as JSON from
// src/lib/atlas/registry.ts. If WebGL is missing or the game fails, a plain
// list of the same destinations appears so nobody is stranded.
import { getAtlasRegistry } from '../lib/atlas/registry';
import { siteConfig } from '../config/site';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

const atlas = await getAtlasRegistry();
const origin = Astro.site?.origin ?? siteConfig.siteUrl;
const canonical = new URL('/', origin).href;
const shareImage = new URL('/og/atlas-box.jpg', origin).href;
const shareAlt = `${atlas.ship.name}, boxed like a retail game on a store shelf: Erikk and the ship Atlier on the cover, with a Play Free sticker.`;
const twitterHandle = `@${new URL(siteConfig.social.twitter).pathname.split('/').filter(Boolean).at(-1)}`;
const description = `${atlas.ship.name}: shupp.dev as a small sprite JRPG. Walk the ship, talk to the crew, read the quest log.`;
// Cache-bust the game files: a phone holding yesterday's JS glue with today's
// wasm fails silently, so both URLs carry a hash of the build.
const wasmBytes = readFileSync('public/atlas/pkg/scattered_atlas_bg.wasm');
const v = createHash('sha1').update(wasmBytes).digest('hex').slice(0, 10);
// The raw size, because a compressed response's content-length undercounts.
const wasmSize = wasmBytes.length;
const wasmUrl = `/atlas/pkg/scattered_atlas_bg.wasm?v=${v}`;
const json = JSON.stringify(atlas).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
  <title>{atlas.ship.name} · shupp.dev</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#000000" />
  <meta property="og:title" content={atlas.ship.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="shupp.dev" />
  <!-- Share card: the game as a boxed release on a shelf. Source and render
       script live in scripts/og/; X, Bluesky, Slack and iMessage all read these. -->
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={shareAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={twitterHandle} />
  <meta name="twitter:creator" content={twitterHandle} />
  <meta name="twitter:title" content={atlas.ship.name} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={shareAlt} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={wasmUrl} as="fetch" type="application/wasm" crossorigin />
</head>
<body>
  <canvas id="atlas-canvas" data-v={v} data-size={wasmSize} tabindex="0" aria-label={`${atlas.ship.name}. A sprite game version of shupp.dev. The same pages are listed below the game for screen readers.`}></canvas>

  <!-- Terminal helpers laid over the canvas: a live thumbnail of the selected page, and a real text input for phone keyboards. -->
  <div class="term-preview" id="term-preview" hidden aria-hidden="true"><iframe id="term-frame" title="Page preview" tabindex="-1" sandbox="allow-same-origin" loading="eager"></iframe></div>
  <input class="term-search" id="term-search" type="search" enterkeyhint="done" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search" aria-label="Search the terminal" hidden />

  <p class="build-stamp" aria-hidden="true">build {v}</p>
  <div class="boot" id="boot" role="status">
    <p class="boot-title">{atlas.ship.name}</p>
    <div class="boot-bar"><span id="boot-fill"></span></div>
    <p class="boot-text" id="boot-text">Boarding…</p>
  </div>

  <!-- Phones: the menu and terminals as one scrolling sheet over the paused game. -->
  <section class="sheet" id="sheet" hidden aria-modal="true" role="dialog" aria-labelledby="sheet-title">
    <header class="sheet-head">
      <h2 id="sheet-title">Menu</h2>
      <button type="button" class="sheet-close" id="sheet-close" aria-label="Close">×</button>
    </header>
    <nav class="sheet-tabs" id="sheet-tabs" aria-label="Menu sections"></nav>
    <div class="sheet-body" id="sheet-body"></div>
  </section>

  <!-- Screen readers, no-WebGL devices and search engines get the plain version. -->
  <nav class="fallback" id="fallback" aria-label="Site">
    <h1>{atlas.ship.name}</h1>
    <p id="fallback-note">The game needs WebGL2. Here is the same ship as a list.</p>
    <ul>
      {atlas.destinations.map((d) => (
        <li>
          <a href={d.href}>{d.name} <span>({d.label})</span></a>
          <p>{d.preview}</p>
        </li>
      ))}
      <li><a href="/resume">Resume</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </nav>

  <script type="application/json" id="atlas-registry" set:html={json}></script>

  <script>
    import { createAudio } from '../lib/atlas/audio';
    type Game = {
      default: (opts?: unknown) => Promise<unknown>;
      start: (canvas: string, registry: string, start: string, visited: string, dpr: number) => void;
      go: (id: string) => void;
      set_paused: (p: boolean) => void;
      set_dialogue_font: (mana: boolean) => void;
      set_menu_theme: (name: string) => void;
      set_touch: (touch: boolean) => void;
      set_html_menus: (on: boolean) => void;
      set_sound: (on: boolean) => void;
      tap: (x: number, y: number, touch: boolean) => void;
      search: (text: string) => void;
    };
    let game: Game | null = null;

    // The game's 640x360 frame is contain-fitted and centred in the canvas.
    // These boxes match SEARCH and PREVIEW in atlas/src/ui.rs (logical pixels).
    const SEARCH = { x: 40, y: 62, w: 308, h: 18 };
    const PREVIEW = { x: 364, y: 62, w: 232, h: 148 };
    function place(el: HTMLElement, b: { x: number; y: number; w: number; h: number }) {
      const s = Math.min(innerWidth / 640, innerHeight / 360);
      const ox = (innerWidth - 640 * s) / 2, oy = (innerHeight - 360 * s) / 2;
      Object.assign(el.style, { left: `${ox + b.x * s}px`, top: `${oy + b.y * s}px`, width: `${b.w * s}px`, height: `${b.h * s}px` });
      return s;
    }
    let terminalOpen = false;
    let previewHref = '';
    let previewTimer = 0;
    function layoutPreview() {
      const box = $('term-preview');
      const s = place(box, PREVIEW);
      // Render the page at desktop width, then shrink it into the box.
      const frame = $('term-frame') as HTMLIFrameElement;
      const k = (PREVIEW.w * s) / 1280;
      // zoom (not transform) so the iframe's layout box shrinks with it.
      Object.assign(frame.style, { width: '1280px', height: `${(PREVIEW.h * s) / k}px`, zoom: String(k) });
    }
    function showPreview(href: string) {
      previewHref = href;
      clearTimeout(previewTimer);
      const box = $('term-preview');
      const frame = $('term-frame') as HTMLIFrameElement;
      if (!href.startsWith('/')) { box.hidden = true; return; }
      // Wait for the cursor to settle before loading a page.
      previewTimer = window.setTimeout(() => {
        if (previewHref !== href) return;
        box.classList.remove('ready');
        layoutPreview();
        box.hidden = false;
        frame.onload = () => box.classList.add('ready');
        frame.src = href;
      }, 220);
    }
    function closeSearch() {
      const input = $('term-search') as HTMLInputElement;
      if (input.hidden) return;
      input.hidden = true;
      input.blur();
      $('atlas-canvas').focus();
    }

    const $ = (id: string) => document.getElementById(id)!;
    const store = {
      get(k: string) { try { return localStorage.getItem(k) ?? ''; } catch { return ''; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
    };
    const visited = new Set(store.get('atlas:visited').split(',').filter(Boolean));
    const audio = createAudio(store);

    function fallback(note?: string) {
      if (note) $('fallback-note').textContent = note;
      document.body.classList.add('no-game');
    }

    // The game calls back into the page through this hook.
    (window as unknown as { __atlasEmit: (k: string, v: string) => void }).__atlasEmit = (kind, value) => {
      if (kind === 'open') {
        if (value.startsWith('mailto:')) location.href = value;
        else window.open(value, '_blank', 'noopener');
      } else if (kind === 'visited') {
        visited.add(value);
        store.set('atlas:visited', [...visited].join(','));
      } else if (kind === 'theme') {
        store.set('atlas:theme', value);
      } else if (kind === 'scene') {
        document.title = `${value} · The Scattered Atlas`;
      } else if (kind === 'terminal') {
        terminalOpen = value === 'open';
        if (!terminalOpen) { closeSearch(); showPreview(''); (($('term-search')) as HTMLInputElement).value = ''; }
      } else if (kind === 'preview') {
        showPreview(value);
      } else if (kind === 'loading') {
        // The art for the first room, the cast and the menus: the last 30% of the bar.
        const [done, total] = value.split('/').map(Number);
        if (total) $('boot-fill').style.width = `${70 + 30 * (done / total)}%`;
        if (total) $('boot-text').textContent = `Unpacking the ship… ${done} / ${total}`;
        lastProgress = Date.now();
      } else if (kind === 'ready') {
        reveal();
      } else if (kind === 'sheet') {
        openSheet(value);
      } else if (kind === 'music') {
        audio.music(value);
      } else if (kind === 'sfx') {
        audio.sfx(value);
      } else if (kind === 'sound') {
        audio.setOn(value === 'on');
      }
    };

    // ---- Phone sheets: the menu and terminals as scrolling HTML -------------
    type Card = { name: string; suit: string; mastery: number; feeds: string; flavor: string };
    type KeyItem = { name: string; from: string; note: string; kind: string; type?: string; rarity: string; year?: number; bonus: string };
    type Dest = { id: string; name: string; label: string; preview: string; href: string; items: { title: string; description?: string; href: string; meta?: string }[] };
    const registry = JSON.parse($('atlas-registry').textContent || '{}');
    const stats = registry.player?.stats ?? {};
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const TIER: Record<string, number> = { common: 0, uncommon: 1, rare: 2, unique: 3, legendary: 4 };
    // Same picks as item_image / card_image in atlas/src/ui.rs.
    const icon = (row: number, col: number) => `<span class="ticon" style="background-position:${-col * 40}px ${-row * 40}px" aria-hidden="true"></span>`;
    const itemIcon = (it: KeyItem) => {
      const col = it.type === 'scroll' || it.type === 'codex' ? 0 : /DEV/.test(it.bonus) ? 1 : /PRO|GTM/.test(it.bonus) ? 2 : 3;
      return icon(TIER[it.rarity] ?? 0, col);
    };
    const cardIcon = (c: Card) => icon(c.mastery >= 5 ? 4 : c.mastery === 4 ? 2 : c.mastery === 3 ? 1 : 0, c.suit === 'discipline' ? 2 : c.suit === 'special' ? 3 : 1);
    const SUITS: [string, string][] = [['skill', 'Proficiencies'], ['discipline', 'Disciplines'], ['special', 'Philosophies'], ['equipment', 'Skills']];
    const TABS = ['Status', 'Items', 'Skills', 'Quests'];
    let hatch = false;

    function statusHtml() {
      const profile: Card[] = (stats.cards ?? []).filter((c: Card) => c.suit === 'profile');
      const type = profile.find((c) => !c.name.includes('·'));
      const strengths = profile.filter((c) => c.name.includes('·'));
      const current = (stats.questLog ?? []).find((q: { current: boolean }) => q.current);
      return `
        <div class="s-hero"><img src="/atlas/assets/portraits/full_body.png" alt="" width="96" height="196" />
          <div><p class="s-name">${esc(stats.name)}</p><p class="s-class">Class · ${esc(stats.title)}</p><p class="s-muted">${esc(stats.location)}</p><p class="s-lv">LV <b>${esc(stats.level)}</b></p></div></div>
        <h3>Attributes</h3>
        <dl class="s-attrs">${(stats.attributes ?? []).map((a: { label: string; value: number; note: string }) => `<div><dt>${esc(a.label)}</dt><dd>${esc(a.value)}</dd><p>${esc(a.note)}</p></div>`).join('')}</dl>
        <h3>Competencies</h3>
        <ul class="s-bars">${(stats.radar ?? []).map((a: { label: string; value: number; note: string }) => `<li><span>${esc(a.label)}</span><i style="width:${Math.min(100, a.value * 10)}%"></i><b>${Math.round(a.value)}</b></li>`).join('')}</ul>
        ${type ? `<h3>Alignment</h3><div class="s-align">${icon(3, 2)}<p><b>${esc(type.name)}</b> · The Visionary</p></div>
          <ul class="s-strengths">${strengths.map((c, i) => `<li>${icon(5, i % 4)}${esc(c.name.replace(' · ', ' '))}</li>`).join('')}</ul>` : ''}
        ${current ? `<h3>Current quest</h3><p class="s-quest"><b>${esc(current.title)}</b><br><span>${esc(current.place)} · ${esc(current.years)}</span></p>` : ''}`;
    }
    function itemsHtml() {
      const items: KeyItem[] = [...(stats.inventory?.keyItems ?? [])];
      if (hatch) items.push({ name: "Dave's Socket Wrench", from: 'Engine room hatch', note: 'Brass, heavy, stamped "D." on the handle. Dave says he lost it years ago. He didn\'t.', kind: 'relic', type: 'relic', rarity: 'legendary', bonus: '+1 LCK' });
      return `<ul class="s-items">${items.map((it) => `
        <li class="r-${esc(it.rarity)}">${itemIcon(it)}<div><p class="s-iname">${esc(it.name)}</p>
          <p class="s-meta">${esc(it.rarity)} · ${esc(it.from)}${it.year ? ` · ${it.year}` : ''} · ${esc(it.bonus)}</p><p>${esc(it.note)}</p></div></li>`).join('')}</ul>`;
    }
    function skillsHtml() {
      const cards: Card[] = stats.cards ?? [];
      return SUITS.map(([suit, label]) => {
        const deck = cards.filter((c) => c.suit === suit);
        if (!deck.length) return '';
        return `<h3>${label}</h3><ul class="s-cards">${deck.map((c) => `
          <li>${cardIcon(c)}<div><p class="s-iname">${esc(c.name)}</p><p class="s-meta">Mastery ${c.mastery} / 5 · +${Math.ceil(c.mastery / 2)} ${esc(c.feeds)}</p><p>${esc(c.flavor)}</p></div></li>`).join('')}</ul>`;
      }).join('');
    }
    function questsHtml() {
      const quests = stats.questLog ?? [];
      return `${quests.map((q: { title: string; place: string; years: string; current: boolean; summary: string; feats: string[]; tech: string[] }) => `
        <article class="s-q${q.current ? ' now' : ''}"><p class="s-iname">${esc(q.title)}</p><p class="s-meta">${esc(q.place)} · ${esc(q.years)}${q.current ? ' · active' : ''}</p>
          <p>${esc(q.summary)}</p>${q.feats?.length ? `<ul>${q.feats.map((f) => `<li>${esc(f)}</li>`).join('')}</ul>` : ''}
          ${q.tech?.length ? `<p class="s-tech">${q.tech.map((t) => `<span>${esc(t)}</span>`).join('')}</p>` : ''}</article>`).join('')}
        ${(stats.training ?? []).length ? `<h3>Training</h3><ul class="s-train">${stats.training.map((t: { title: string; place: string; years: string }) => `<li><b>${esc(t.title)}</b><br><span>${esc(t.place)} · ${esc(t.years)}</span></li>`).join('')}</ul>` : ''}
        <p><a class="s-btn" href="/resume">Open the full resume</a></p>`;
    }
    // Terminals on phones: a full-screen list; tapping an entry opens a second
    // screen with its preview (the page at phone width) and an Open button.
    const external = (href: string) => (/^https?:/.test(href) ? ' target="_blank" rel="noopener"' : '');
    let termDest: Dest | null = null;
    let termQuery = '';
    let termScroll = 0;
    function termMatches(d: Dest) {
      const q = termQuery.trim().toLowerCase();
      return d.items.map((it, k) => ({ it, k })).filter(({ it }) => !q || `${it.title} ${it.meta ?? ''} ${it.description ?? ''}`.toLowerCase().includes(q));
    }
    function termRows(d: Dest) {
      const rows = termMatches(d);
      return rows.length
        ? rows.map(({ it, k }) => `<li><button type="button" data-k="${k}"><b>${esc(it.title)}</b>${it.meta ? `<span class="s-meta">${esc(it.meta)}</span>` : ''}</button></li>`).join('')
        : '<li class="s-muted">Nothing matches.</li>';
    }
    function showTermList() {
      const d = termDest!;
      $('sheet-title').textContent = d.name;
      $('sheet-body').innerHTML = `<p class="s-muted">${esc(d.preview)}</p>
        <input class="s-find" id="s-find" type="search" placeholder="Find" aria-label="Find in ${esc(d.label)}" value="${esc(termQuery)}" />
        <p class="s-count" id="s-count">${termMatches(d).length} of ${d.items.length}</p>
        <ul class="s-links" id="s-rows">${termRows(d)}</ul>
        <p><a class="s-btn" href="${esc(d.href)}">Open ${esc(d.label)}</a></p>`;
      const find = $('s-find') as HTMLInputElement;
      find.addEventListener('input', () => {
        termQuery = find.value;
        $('s-rows').innerHTML = termRows(d);
        $('s-count').textContent = `${termMatches(d).length} of ${d.items.length}`;
      });
      $('sheet-body').scrollTop = termScroll;
    }
    function showTermItem(k: number) {
      const d = termDest!;
      const it = d.items[k];
      termScroll = $('sheet-body').scrollTop;
      audio.sfx('ui_confirm');
      $('sheet-body').innerHTML = `<button type="button" class="s-back" id="s-back">‹ All of ${esc(d.label)}</button>
        <h3 class="s-title">${esc(it.title)}</h3>
        ${it.meta ? `<p class="s-meta">${esc(it.meta)}</p>` : ''}
        ${it.description ? `<p>${esc(it.description)}</p>` : ''}
        ${it.href.startsWith('/') ? `<div class="s-preview"><iframe src="${esc(it.href)}" title="Preview of ${esc(it.title)}" loading="lazy" tabindex="-1"></iframe></div>` : ''}
        <p class="s-actions"><a class="s-btn" href="${esc(it.href)}"${external(it.href)}>Open page ›</a></p>`;
      $('s-back').addEventListener('click', () => { audio.sfx('ui_cancel'); showTermList(); });
      $('sheet-body').scrollTop = 0;
    }
    $('sheet-body').addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('#s-rows button') as HTMLElement | null;
      if (b && termDest) showTermItem(Number(b.dataset.k));
    });
    function showTab(i: number) {
      $('sheet-title').textContent = TABS[i];
      $('sheet-tabs').querySelectorAll('button').forEach((b, j) => b.setAttribute('aria-current', String(i === j)));
      $('sheet-body').innerHTML = [statusHtml, itemsHtml, skillsHtml, questsHtml][i]();
      $('sheet-body').scrollTop = 0;
    }
    function openSheet(value: string) {
      const [what, flag] = value.split('|');
      hatch = flag === 'hatch';
      const tabs = $('sheet-tabs');
      if (what.startsWith('terminal:')) {
        const d: Dest | undefined = (registry.destinations ?? []).find((x: Dest) => x.id === what.slice(9));
        tabs.hidden = true;
        termDest = d ?? null;
        termQuery = '';
        termScroll = 0;
        if (d) showTermList();
        else { $('sheet-title').textContent = 'Terminal'; $('sheet-body').innerHTML = ''; }
      } else {
        tabs.hidden = false;
        termDest = null;
        tabs.innerHTML = TABS.map((t, i) => `<button type="button" data-i="${i}">${t}</button>`).join('');
        tabs.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { audio.sfx('ui_tab_switch'); showTab(Number((b as HTMLElement).dataset.i)); }));
        showTab(Math.min(Number(what) || 0, TABS.length - 1));
      }
      $('sheet').hidden = false;
      audio.sfx(what.startsWith('terminal:') ? 'fx_console_activate' : 'ui_menu_open');
      $('sheet-close').focus();
    }
    function closeSheet() {
      if ($('sheet').hidden) return;
      $('sheet').hidden = true;
      audio.sfx('ui_menu_close');
      game?.set_paused(false);
      $('atlas-canvas').focus();
    }
    $('sheet-close').addEventListener('click', closeSheet);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });

    let revealed = false;
    let lastProgress = Date.now();
    function reveal() {
      if (revealed) return;
      revealed = true;
      $('boot-fill').style.width = '100%';
      $('boot').classList.add('done');
      $('atlas-canvas').focus();
    }

    // An open tab keeps running the game it loaded. When it comes back into
    // view (or is restored from the back/forward cache), check for a newer
    // build and reload, so old code never runs against new art.
    async function checkVersion() {
      try {
        const res = await fetch('/atlas/version.json', { cache: 'no-store' });
        const { v } = await res.json();
        const mine = $('atlas-canvas').dataset.v;
        if (v && mine && v !== mine) location.reload();
      } catch { /* offline: keep playing */ }
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) checkVersion(); });
    window.addEventListener('pageshow', (e) => { if (e.persisted) checkVersion(); });
    setInterval(checkVersion, 5 * 60 * 1000);

    async function boot() {
      if (!document.createElement('canvas').getContext('webgl2')) {
        fallback();
        return;
      }
      const fill = $('boot-fill');
      const label = $('boot-text');
      try {
        // Stream the wasm so the loading bar means something.
        const v = $('atlas-canvas').dataset.v ?? '';
        const res = await fetch(`/atlas/pkg/scattered_atlas_bg.wasm?v=${v}`);
        const total = Number($('atlas-canvas').dataset.size) || 0;
        const reader = res.body!.getReader();
        const chunks: Uint8Array[] = [];
        let got = 0;
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          got += value.length;
          // The download is the first 70% of the bar; unpacking art is the rest.
          fill.style.width = total ? `${Math.min(70, (got / total) * 70)}%` : `${Math.min(65, got / 300000)}%`;
        }
        const bytes = new Uint8Array(got);
        let at = 0;
        for (const c of chunks) { bytes.set(c, at); at += c.length; }
        label.textContent = 'Starting engines…';

        // A plain runtime import keeps Vite from rewriting a /public file.
        const load = new Function('u', 'return import(u)') as (u: string) => Promise<Game>;
        game = await load(`/atlas/pkg/scattered_atlas.js?v=${v}`);
        await game.default({ module_or_path: bytes });

        window.addEventListener('error', (e) => {
          if (/RuntimeError|unreachable|wasm|wgpu/i.test(`${e.message}`)) fallback('The game stopped unexpectedly. Here is the same ship as a list.');
        });
        window.addEventListener('hashchange', () => {
          const id = location.hash.slice(1);
          if (id) game!.go(id);
        });
        document.addEventListener('visibilitychange', () => game!.set_paused(document.hidden || !$('sheet').hidden));
        // Clicks and taps go straight to the game; winit loses them in some browsers.
        const canvas = $('atlas-canvas');
        const search = $('term-search') as HTMLInputElement;
        canvas.addEventListener('pointerup', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          const r = canvas.getBoundingClientRect();
          // A finger on the terminal's search box gets a real input, focused
          // inside the tap so the phone keyboard opens.
          if (terminalOpen && e.pointerType !== 'mouse') {
            const s = Math.min(r.width / 640, r.height / 360);
            const lx = (e.clientX - r.left - (r.width - 640 * s) / 2) / s;
            const ly = (e.clientY - r.top - (r.height - 360 * s) / 2) / s;
            if (lx >= SEARCH.x && lx <= SEARCH.x + SEARCH.w && ly >= SEARCH.y && ly <= SEARCH.y + SEARCH.h) {
              place(search, SEARCH);
              search.hidden = false;
              search.focus();
              return;
            }
          }
          closeSearch();
          game!.tap((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height, e.pointerType !== 'mouse');
        });
        search.addEventListener('input', () => game!.search(search.value));
        search.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === 'Escape') closeSearch(); });
        search.addEventListener('blur', () => { search.hidden = true; });
        window.addEventListener('resize', () => {
          if (!$('term-preview').hidden) layoutPreview();
          if (!search.hidden) place(search, SEARCH);
        });

        const start = location.hash.slice(1);
        try {
          game.start('atlas-canvas', $('atlas-registry').textContent ?? '{}', start, [...visited].join(','), Math.min(devicePixelRatio || 1, 3));
        } catch (err) {
          // winit leaves its event loop by throwing on the web; that one is expected.
          if (!String(err).includes('Using exceptions for control flow')) throw err;
        }
        if (new URLSearchParams(location.search).get('font') === 'body') game.set_dialogue_font(false);
        // Character menu theme: ?theme= wins, then the player's last pick.
        const theme = new URLSearchParams(location.search).get('theme') || store.get('atlas:theme');
        if (theme) game.set_menu_theme(theme);
        if (matchMedia('(pointer: coarse)').matches) game.set_touch(true);
        game.set_sound(audio.on);
        // Phones get the scrolling sheets; tablets and desktops keep the game menus.
        // Narrow or tall screens get the scrolling sheets instead of a shrunken
        // widescreen menu: phones, and desktop windows sized like one.
        const syncSheets = () => game!.set_html_menus(
          innerWidth < 720 || innerHeight > innerWidth * 1.05 || (matchMedia('(pointer: coarse)').matches && Math.min(innerWidth, innerHeight) < 600),
        );
        syncSheets();
        window.addEventListener('resize', syncSheets);
        if (start === 'about' || start === 'contact') game.go(start);
        label.textContent = 'Unpacking the ship…';
        // Never strand someone on the loading screen if an asset hangs, but
        // keep waiting while art is still arriving (phones on slow networks
        // otherwise got the HUD over an empty room).
        lastProgress = Date.now();
        const watchdog = window.setInterval(() => {
          if (revealed) { clearInterval(watchdog); return; }
          if (Date.now() - lastProgress > 25000) { clearInterval(watchdog); reveal(); }
        }, 1000);
      } catch (err) {
        console.error('[atlas]', err);
        fallback('The game could not start on this device. Here is the same ship as a list.');
      }
    }
    boot();
  </script>
</body>
</html>

