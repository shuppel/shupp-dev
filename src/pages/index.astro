---
// The Scattered Atlas: shupp.dev as a sprite JRPG, and the site's front door.
// The classic homepage (/home) is retired and redirects here.
//
// The page is only a full-screen canvas. Everything the visitor sees is drawn
// by the Bevy game in atlas/. The site content reaches the game as JSON from
// src/lib/atlas/registry.ts. If WebGL is missing or the game fails, a plain
// list of the same destinations appears so nobody is stranded.
import { getAtlasRegistry } from '../lib/atlas/registry';
import { siteConfig } from '../config/site';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

const atlas = await getAtlasRegistry();
const origin = Astro.site?.origin ?? siteConfig.siteUrl;
const canonical = new URL('/', origin).href;
const shareImage = new URL('/og/atlas-box.jpg', origin).href;
const shareAlt = `${atlas.ship.name}, boxed like a retail game on a store shelf: Erikk and the ship Atlier on the cover, with a Play Free sticker.`;
const twitterHandle = `@${new URL(siteConfig.social.twitter).pathname.split('/').filter(Boolean).at(-1)}`;
const description = `${atlas.ship.name}: shupp.dev as a small sprite JRPG. Walk the ship, talk to the crew, read the quest log.`;
// Cache-bust the game files: a phone holding yesterday's JS glue with today's
// wasm fails silently, so both URLs carry a hash of the build.
const wasmBytes = readFileSync('public/atlas/pkg/scattered_atlas_bg.wasm');
const v = createHash('sha1').update(wasmBytes).digest('hex').slice(0, 10);
// The raw size, because a compressed response's content-length undercounts.
const wasmSize = wasmBytes.length;
const wasmUrl = `/atlas/pkg/scattered_atlas_bg.wasm?v=${v}`;
const json = JSON.stringify(atlas).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no" />
  <title>{atlas.ship.name} · shupp.dev</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#000000" />
  <meta property="og:title" content={atlas.ship.name} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="shupp.dev" />
  <!-- Share card: the game as a boxed release on a shelf. Source and render
       script live in scripts/og/; X, Bluesky, Slack and iMessage all read these. -->
  <meta property="og:image" content={shareImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={shareAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={twitterHandle} />
  <meta name="twitter:creator" content={twitterHandle} />
  <meta name="twitter:title" content={atlas.ship.name} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImage} />
  <meta name="twitter:image:alt" content={shareAlt} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={wasmUrl} as="fetch" type="application/wasm" crossorigin />
</head>
<body>
  <canvas id="atlas-canvas" data-v={v} data-size={wasmSize} tabindex="0" aria-label={`${atlas.ship.name}. A sprite game version of shupp.dev. The same pages are listed below the game for screen readers.`}></canvas>

  <!-- Terminal helpers laid over the canvas: a live thumbnail of the selected page, and a real text input for phone keyboards. -->
  <div class="term-preview" id="term-preview" hidden aria-hidden="true"><iframe id="term-frame" title="Page preview" tabindex="-1" sandbox="allow-same-origin" loading="eager"></iframe></div>
  <input class="term-search" id="term-search" type="search" enterkeyhint="done" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Search" aria-label="Search the terminal" hidden />

  <p class="build-stamp" aria-hidden="true">build {v}</p>
  <div class="boot" id="boot" role="status">
    <p class="boot-title">{atlas.ship.name}</p>
    <div class="boot-bar"><span id="boot-fill"></span></div>
    <p class="boot-text" id="boot-text">Boarding…</p>
  </div>

  <div class="rotate" id="rotate" hidden>
    <p>Turn your phone sideways for the full ship.</p>
    <button type="button" id="rotate-dismiss">Play anyway</button>
  </div>

  <!-- Screen readers, no-WebGL devices and search engines get the plain version. -->
  <nav class="fallback" id="fallback" aria-label="Site">
    <h1>{atlas.ship.name}</h1>
    <p id="fallback-note">The game needs WebGL2. Here is the same ship as a list.</p>
    <ul>
      {atlas.destinations.map((d) => (
        <li>
          <a href={d.href}>{d.name} <span>({d.label})</span></a>
          <p>{d.preview}</p>
        </li>
      ))}
      <li><a href="/resume">Resume</a></li>
      <li><a href="/about/">About</a></li>
    </ul>
  </nav>

  <script type="application/json" id="atlas-registry" set:html={json}></script>

  <script>
    type Game = {
      default: (opts?: unknown) => Promise<unknown>;
      start: (canvas: string, registry: string, start: string, visited: string, dpr: number) => void;
      go: (id: string) => void;
      set_paused: (p: boolean) => void;
      set_dialogue_font: (mana: boolean) => void;
      tap: (x: number, y: number, touch: boolean) => void;
      search: (text: string) => void;
    };
    let game: Game | null = null;

    // The game's 640x360 frame is contain-fitted and centred in the canvas.
    // These boxes match SEARCH and PREVIEW in atlas/src/ui.rs (logical pixels).
    const SEARCH = { x: 40, y: 62, w: 308, h: 18 };
    const PREVIEW = { x: 364, y: 62, w: 232, h: 148 };
    function place(el: HTMLElement, b: { x: number; y: number; w: number; h: number }) {
      const s = Math.min(innerWidth / 640, innerHeight / 360);
      const ox = (innerWidth - 640 * s) / 2, oy = (innerHeight - 360 * s) / 2;
      Object.assign(el.style, { left: `${ox + b.x * s}px`, top: `${oy + b.y * s}px`, width: `${b.w * s}px`, height: `${b.h * s}px` });
      return s;
    }
    let terminalOpen = false;
    let previewHref = '';
    let previewTimer = 0;
    function layoutPreview() {
      const box = $('term-preview');
      const s = place(box, PREVIEW);
      // Render the page at desktop width, then shrink it into the box.
      const frame = $('term-frame') as HTMLIFrameElement;
      const k = (PREVIEW.w * s) / 1280;
      // zoom (not transform) so the iframe's layout box shrinks with it.
      Object.assign(frame.style, { width: '1280px', height: `${(PREVIEW.h * s) / k}px`, zoom: String(k) });
    }
    function showPreview(href: string) {
      previewHref = href;
      clearTimeout(previewTimer);
      const box = $('term-preview');
      const frame = $('term-frame') as HTMLIFrameElement;
      if (!href.startsWith('/')) { box.hidden = true; return; }
      // Wait for the cursor to settle before loading a page.
      previewTimer = window.setTimeout(() => {
        if (previewHref !== href) return;
        box.classList.remove('ready');
        layoutPreview();
        box.hidden = false;
        frame.onload = () => box.classList.add('ready');
        frame.src = href;
      }, 220);
    }
    function closeSearch() {
      const input = $('term-search') as HTMLInputElement;
      if (input.hidden) return;
      input.hidden = true;
      input.blur();
      $('atlas-canvas').focus();
    }

    const $ = (id: string) => document.getElementById(id)!;
    const store = {
      get(k: string) { try { return localStorage.getItem(k) ?? ''; } catch { return ''; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
    };
    const visited = new Set(store.get('atlas:visited').split(',').filter(Boolean));

    function fallback(note?: string) {
      if (note) $('fallback-note').textContent = note;
      document.body.classList.add('no-game');
    }

    // The game calls back into the page through this hook.
    (window as unknown as { __atlasEmit: (k: string, v: string) => void }).__atlasEmit = (kind, value) => {
      if (kind === 'open') {
        if (value.startsWith('mailto:')) location.href = value;
        else window.open(value, '_blank', 'noopener');
      } else if (kind === 'visited') {
        visited.add(value);
        store.set('atlas:visited', [...visited].join(','));
      } else if (kind === 'scene') {
        document.title = `${value} · The Scattered Atlas`;
      } else if (kind === 'terminal') {
        terminalOpen = value === 'open';
        if (!terminalOpen) { closeSearch(); showPreview(''); (($('term-search')) as HTMLInputElement).value = ''; }
      } else if (kind === 'preview') {
        showPreview(value);
      } else if (kind === 'loading') {
        // The art for the first room, the cast and the menus: the last 30% of the bar.
        const [done, total] = value.split('/').map(Number);
        if (total) $('boot-fill').style.width = `${70 + 30 * (done / total)}%`;
      } else if (kind === 'ready') {
        reveal();
      }
    };

    // Portrait phones: suggest landscape, but never block.
    const portrait = matchMedia('(orientation: portrait) and (max-width: 700px)');
    let dismissed = false;
    const syncRotate = () => { $('rotate').hidden = dismissed || !portrait.matches; };
    portrait.addEventListener('change', syncRotate);
    $('rotate-dismiss').addEventListener('click', () => { dismissed = true; syncRotate(); });
    syncRotate();

    let revealed = false;
    function reveal() {
      if (revealed) return;
      revealed = true;
      $('boot-fill').style.width = '100%';
      $('boot').classList.add('done');
      $('atlas-canvas').focus();
    }

    // An open tab keeps running the game it loaded. When it comes back into
    // view (or is restored from the back/forward cache), check for a newer
    // build and reload, so old code never runs against new art.
    async function checkVersion() {
      try {
        const res = await fetch('/atlas/version.json', { cache: 'no-store' });
        const { v } = await res.json();
        const mine = $('atlas-canvas').dataset.v;
        if (v && mine && v !== mine) location.reload();
      } catch { /* offline: keep playing */ }
    }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) checkVersion(); });
    window.addEventListener('pageshow', (e) => { if (e.persisted) checkVersion(); });
    setInterval(checkVersion, 5 * 60 * 1000);

    async function boot() {
      if (!document.createElement('canvas').getContext('webgl2')) {
        fallback();
        return;
      }
      const fill = $('boot-fill');
      const label = $('boot-text');
      try {
        // Stream the wasm so the loading bar means something.
        const v = $('atlas-canvas').dataset.v ?? '';
        const res = await fetch(`/atlas/pkg/scattered_atlas_bg.wasm?v=${v}`);
        const total = Number($('atlas-canvas').dataset.size) || 0;
        const reader = res.body!.getReader();
        const chunks: Uint8Array[] = [];
        let got = 0;
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          got += value.length;
          // The download is the first 70% of the bar; unpacking art is the rest.
          fill.style.width = total ? `${Math.min(70, (got / total) * 70)}%` : `${Math.min(65, got / 300000)}%`;
        }
        const bytes = new Uint8Array(got);
        let at = 0;
        for (const c of chunks) { bytes.set(c, at); at += c.length; }
        label.textContent = 'Starting engines…';

        // A plain runtime import keeps Vite from rewriting a /public file.
        const load = new Function('u', 'return import(u)') as (u: string) => Promise<Game>;
        game = await load(`/atlas/pkg/scattered_atlas.js?v=${v}`);
        await game.default({ module_or_path: bytes });

        window.addEventListener('error', (e) => {
          if (/RuntimeError|unreachable|wasm|wgpu/i.test(`${e.message}`)) fallback('The game stopped unexpectedly. Here is the same ship as a list.');
        });
        window.addEventListener('hashchange', () => {
          const id = location.hash.slice(1);
          if (id) game!.go(id);
        });
        document.addEventListener('visibilitychange', () => game!.set_paused(document.hidden));
        // Clicks and taps go straight to the game; winit loses them in some browsers.
        const canvas = $('atlas-canvas');
        const search = $('term-search') as HTMLInputElement;
        canvas.addEventListener('pointerup', (e) => {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          const r = canvas.getBoundingClientRect();
          // A finger on the terminal's search box gets a real input, focused
          // inside the tap so the phone keyboard opens.
          if (terminalOpen && e.pointerType !== 'mouse') {
            const s = Math.min(r.width / 640, r.height / 360);
            const lx = (e.clientX - r.left - (r.width - 640 * s) / 2) / s;
            const ly = (e.clientY - r.top - (r.height - 360 * s) / 2) / s;
            if (lx >= SEARCH.x && lx <= SEARCH.x + SEARCH.w && ly >= SEARCH.y && ly <= SEARCH.y + SEARCH.h) {
              place(search, SEARCH);
              search.hidden = false;
              search.focus();
              return;
            }
          }
          closeSearch();
          game!.tap((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height, e.pointerType !== 'mouse');
        });
        search.addEventListener('input', () => game!.search(search.value));
        search.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === 'Escape') closeSearch(); });
        search.addEventListener('blur', () => { search.hidden = true; });
        window.addEventListener('resize', () => {
          if (!$('term-preview').hidden) layoutPreview();
          if (!search.hidden) place(search, SEARCH);
        });

        const start = location.hash.slice(1);
        try {
          game.start('atlas-canvas', $('atlas-registry').textContent ?? '{}', start, [...visited].join(','), Math.min(devicePixelRatio || 1, 3));
        } catch (err) {
          // winit leaves its event loop by throwing on the web; that one is expected.
          if (!String(err).includes('Using exceptions for control flow')) throw err;
        }
        if (new URLSearchParams(location.search).get('font') === 'body') game.set_dialogue_font(false);
        if (start === 'about' || start === 'contact') game.go(start);
        label.textContent = 'Unpacking the ship…';
        // Never strand someone on the loading screen if an asset hangs.
        setTimeout(reveal, 20000);
      } catch (err) {
        console.error('[atlas]', err);
        fallback('The game could not start on this device. Here is the same ship as a list.');
      }
    }
    boot();
  </script>
</body>
</html>

<style is:global>
  @font-face { font-family: 'Shupp'; src: url('/fonts/Shupp.otf') format('opentype'); font-display: swap; }
  html, body { margin: 0; height: 100%; background: #000; color: #f1eee6; overflow: hidden; }
  body { font: 16px/1.6 'Hind', system-ui, sans-serif; }
  #atlas-canvas { position: fixed; inset: 0; width: 100vw; height: 100dvh; display: block; outline: none; touch-action: none; image-rendering: pixelated; }

  .term-preview { position: fixed; z-index: 2; overflow: hidden; clip-path: inset(0 round 2px); contain: strict; border-radius: 2px; pointer-events: none; background: #f1eee6; opacity: 0; transition: opacity 0.25s; }
  .term-preview.ready { opacity: 1; }
  .term-preview[hidden] { display: none; }
  .term-preview iframe { display: block; border: 0; background: #fff; }
  .term-search { position: fixed; z-index: 3; box-sizing: border-box; margin: 0; padding: 0 8px; border: 1px solid #E9EB9E; border-radius: 2px;
    background: #14080e; color: #E9EB9E; font: 16px 'Hind', system-ui, sans-serif; outline: none; }
  .term-search[hidden] { display: none; }

  .boot { position: fixed; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px; background: #000; transition: opacity 0.6s; }
  .boot.done { opacity: 0; pointer-events: none; }
  .build-stamp { position: fixed; right: 6px; bottom: 4px; margin: 0; font: 10px/1 ui-monospace, monospace; color: #799496; opacity: 0.5; pointer-events: none; z-index: 1; }
  .boot-title { margin: 0; font: 2rem 'Shupp', cursive; color: #E9EB9E; }
  .boot-bar { width: min(260px, 70vw); height: 6px; border: 1px solid #cc8c4d; border-radius: 3px; overflow: hidden; }
  .boot-bar span { display: block; height: 100%; width: 0; background: #ee8c40; transition: width 0.2s; }
  .boot-text { margin: 0; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: #799496; }

  .rotate { position: fixed; inset: auto 12px 12px; z-index: 5; display: flex; gap: 12px; align-items: center; justify-content: space-between;
    padding: 10px 14px; border: 1px solid #cc8c4d; border-radius: 4px; background: rgba(20, 8, 14, 0.94); font-size: 0.85rem; }
  .rotate[hidden] { display: none; }
  .rotate p { margin: 0; }
  .rotate button { min-height: 44px; padding: 0 14px; border: 1px solid #E9EB9E; border-radius: 4px; background: none; color: #E9EB9E; font: inherit; }

  /* Visually hidden while the game runs; shown if it can't. */
  .fallback { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .no-game { overflow: auto; }
  .no-game #atlas-canvas, .no-game .boot, .no-game .rotate { display: none; }
  .no-game .fallback { position: static; width: auto; height: auto; clip: auto; max-width: 640px; margin: 0 auto; padding: 32px 16px; }
  .fallback h1 { font: 2.2rem 'Shupp', cursive; color: #E9EB9E; margin: 0 0 8px; }
  .fallback ul { list-style: none; padding: 0; }
  .fallback li { padding: 12px 0; border-bottom: 1px solid rgba(204, 140, 77, 0.35); }
  .fallback a { color: #E9EB9E; font-weight: 600; }
  .fallback a span { color: #799496; font-weight: 400; }
  .fallback li p { margin: 4px 0 0; color: #b9b6ad; }
</style>
