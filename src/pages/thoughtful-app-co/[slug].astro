---
// A Thoughtful App Co. concept as a standalone reading page, with a JSON twin
// at /thoughtful-app-co/<id>.json.
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import PixelGlyph from '../../components/Reading/PixelGlyph.astro';
import { APP_STATUS, RATINGS, appJsonUrl, appScore, appUrl } from '../../lib/reading/apps';
import { siteConfig } from '../../config/site';
import { isFeatureEnabled } from '../../config/features';

export async function getStaticPaths() {
  return (await getCollection('thoughtful-apps')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'thoughtful-apps'>;
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const showTLDraw = isFeatureEnabled('enableTLDraw');
const fmt = (date: Date) => date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
const url = new URL(appUrl(entry.id), Astro.site).href;

const all = (await getCollection('thoughtful-apps')).sort((a, b) => appScore(b) - appScore(a));
const at = all.findIndex((a) => a.id === entry.id);
const next = all[(at + 1) % all.length];

const ratings = (Object.keys(RATINGS) as (keyof typeof RATINGS)[]).map((k) => ({
  name: k.charAt(0).toUpperCase() + k.slice(1),
  score: d[k],
  label: RATINGS[k][d[k] - 1],
}));
const tech = d.technicalArchitecture;
const outline = [
  ['problem', 'The problem'],
  ['story', 'The story'],
  ['features', 'Key features'],
  ['journey', 'User journey'],
  ['architecture', 'Architecture'],
  ['moonshots', 'Moonshots'],
  ['market', 'Market'],
  ['questions', 'Open questions'],
  ...(d.resources?.length ? [['resources', 'Resources']] : []),
];

const jsonLdData = {
  article: {
    title: d.title,
    description: d.oneLiner,
    image: new URL(d.ogImage || '/og-reading.png', Astro.site).href,
    url,
    pubDate: d.lastUpdated.toISOString(),
    updatedDate: d.lastUpdated.toISOString(),
    author: siteConfig.author.name,
    categories: [d.category],
  },
  breadcrumbs: [
    { name: 'Home', url: 'https://shupp.dev/' },
    { name: 'Thoughtful App Co.', url: 'https://shupp.dev/thoughtful-app-co/' },
    { name: d.title, url },
  ],
};
---

<ReadingLayout
  title={`${d.title} - Thoughtful App Co.`}
  description={d.oneLiner}
  terminal="The Workbench"
  image={d.ogImage}
  modifiedTime={d.lastUpdated.toISOString()}
  canonicalUrl={url}
  jsonHref={appJsonUrl(entry.id)}
  jsonLdData={jsonLdData}
>
  <article>
    <section class="read-hero wrap">
      <div>
        <p class="eyebrow"><span class="status-dot"></span> {APP_STATUS[d.status]} / {d.category}</p>
        <h1 class="read-title">{d.title}</h1>
        <p class="read-lede">{d.oneLiner}</p>
        <ul class="read-meta">
          <li class="tag"><img src="/atlas/assets/ui/icon_quests.png" alt="" class="px" width="16" height="16" /> Updated <time datetime={d.lastUpdated.toISOString().slice(0, 10)}>{fmt(d.lastUpdated)}</time></li>
          {d.githubUrl && <li><a class="outline-button" href={d.githubUrl} target="_blank" rel="noopener">GitHub ↗</a></li>}
        </ul>
      </div>
      <figure class="cover panel">
        <header><h2><img src="/atlas/assets/ui/icon_status.png" alt="" class="px" width="16" height="16" /> Readout</h2><span>{APP_STATUS[d.status]}</span></header>
        {d.ogImage ? (
          <div class="cover-art"><img src={d.ogImage} alt="" width="1200" height="630" decoding="async" /></div>
        ) : (
          <div class="panel-body">
            <dl class="facts">
              {ratings.map((r) => (
                <div><PixelGlyph name="star" size={16} /><dt>{r.name}</dt><dd><span class="pips" aria-label={`${r.score} of 5`}>{[1, 2, 3, 4, 5].map((i) => <i class={i <= r.score ? 'on' : ''} />)}</span> {r.label}</dd></div>
              ))}
            </dl>
          </div>
        )}
        <footer>{d.features.length} features, {d.openQuestions.length} open questions.</footer>
      </figure>
    </section>

    <div class="read-grid wrap">
      <nav class="read-rail" aria-labelledby="outline-title">
        <p class="eyebrow" id="outline-title">On this page</p>
        <ol class="outline">{outline.map(([id, text]) => <li><a href={`#${id}`}>{text}</a></li>)}</ol>
      </nav>

      <div class="read-body">
        <h2 id="problem">The problem</h2>
        <p class="read-pull">{d.problem}</p>

        <h2 id="story">The story</h2>
        <Content />

        {d.mainMockup && showTLDraw && <iframe src={d.mainMockup} class="read-embed" title="Main app mockup" loading="lazy" allowfullscreen></iframe>}

        <h2 id="features">Key features</h2>
        {d.features.map((f) => (
          <>
            <h3>{f.name}</h3>
            <p><strong>What.</strong> {f.what}</p>
            <p><strong>Why.</strong> {f.why}</p>
            {f.mockup && showTLDraw && <iframe src={f.mockup} class="read-embed" title={`${f.name} mockup`} loading="lazy" allowfullscreen></iframe>}
          </>
        ))}

        <h2 id="journey">User journey</h2>
        <ol>{d.userJourney.map((s) => <li>{s}</li>)}</ol>

        <h2 id="architecture">Architecture</h2>
        <dl class="read-defs">
          <dt>Frontend</dt><dd>{tech.frontend}</dd>
          <dt>Backend</dt><dd>{tech.backend}</dd>
          <dt>Data</dt><dd>{tech.data}</dd>
          <dt>APIs</dt><dd>{tech.apis.join(', ')}</dd>
          <dt>Hosting</dt><dd>{tech.hosting}</dd>
        </dl>

        <h2 id="moonshots">Moonshots for v2</h2>
        <ul>{d.moonshotFeatures.map((m) => <li>{m}</li>)}</ul>

        <h2 id="market">Market</h2>
        <p><strong>Similar to.</strong> {d.marketResearch.similarTo.join(', ')}</p>
        <p><strong>Different because.</strong> {d.marketResearch.differentBecause}</p>
        <p><strong>Who it's for.</strong> {d.marketResearch.targetUsers}</p>

        <h2 id="questions">Open questions</h2>
        <ul>{d.openQuestions.map((q) => <li>{q}</li>)}</ul>

        {d.resources && d.resources.length > 0 && (
          <>
            <h2 id="resources">Resources and inspiration</h2>
            <ul>{d.resources.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.title}</a></li>)}</ul>
          </>
        )}
      </div>

      <aside class="read-aside" aria-label="About this concept">
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_quest_active.png" alt="" class="px" width="16" height="16" /> Concept log</h2><span>Log</span></header>
          <div class="panel-body">
            <dl class="facts">
              <div><img src="/atlas/assets/ui/icon_status.png" alt="" class="px" width="16" height="16" /><dt>Status</dt><dd>{APP_STATUS[d.status]}</dd></div>
              <div><img src="/atlas/assets/ui/icon_map.png" alt="" class="px" width="16" height="16" /><dt>Category</dt><dd>{d.category}</dd></div>
              <div><img src="/atlas/assets/ui/icon_quests.png" alt="" class="px" width="16" height="16" /><dt>Updated</dt><dd>{fmt(d.lastUpdated)}</dd></div>
              {d.ogImage && ratings.map((r) => (
                <div><PixelGlyph name="star" size={16} /><dt>{r.name}</dt><dd><span class="pips" aria-label={`${r.score} of 5`}>{[1, 2, 3, 4, 5].map((i) => <i class={i <= r.score ? 'on' : ''} />)}</span> {r.label}</dd></div>
              ))}
            </dl>
          </div>
          <footer><a href={appJsonUrl(entry.id)}>Read it as JSON ↗</a></footer>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/props/comms.png" alt="" class="px" width="16" height="16" /> {d.githubUrl ? 'Build it with me' : 'Want this built?'}</h2><span>Crew</span></header>
          <div class="panel-body">
            <p style="margin: 0 0 12px">{d.githubUrl ? 'This one is being built in the open. Issues and pull requests are welcome.' : 'If you would use this, or could help build it, say so.'}</p>
            <div class="tag-cloud">
              {d.githubUrl && <a class="solid-button" href={d.githubUrl} target="_blank" rel="noopener">Repository ↗</a>}
              {d.githubUrl && <a class="outline-button" href={`${d.githubUrl}/issues`} target="_blank" rel="noopener">Issues ↗</a>}
              <a class={d.githubUrl ? 'outline-button' : 'solid-button'} href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(`About ${d.title}`)}`}>Write to me ↗</a>
            </div>
          </div>
        </section>
      </aside>
    </div>

    <nav class="read-rules wrap" aria-label="Keep reading">
      <a href="/" data-return><span>01</span><strong>Return to ship</strong><p>Close this page and pick up where you left off.</p></a>
      <a href="/thoughtful-app-co/"><span>02</span><strong>All concepts</strong><p>Every app idea, most promising first.</p></a>
      {next && next.id !== entry.id && <a href={appUrl(next.id)}><span>03</span><strong>{next.data.title}</strong><p>Next concept</p></a>}
    </nav>
  </article>
</ReadingLayout>
