---
// Every project renders as a standalone page (no site sidebar or nav), with a
// JSON twin at /portfolio/<slug>.json. See docs/reading-pages.md.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectReading from '../../components/Reading/ProjectReading.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
---

<ProjectReading entry={entry} />
