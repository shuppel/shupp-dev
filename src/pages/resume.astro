---
// The resume as a standalone reading page, with a JSON twin at /resume.json.
// It prints cleanly: the header, side panels and end row drop away.
import ReadingLayout from '../layouts/ReadingLayout.astro';
import PixelGlyph from '../components/Reading/PixelGlyph.astro';
import {
  certifications, contactItems, coreCompetencies, education, experiences,
  otherExperience, renderEmphasis, resumeHeadline as h, specializations, techStack,
} from '../lib/reading/resume';

const current = experiences.filter((e) => e.isCurrent);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<ReadingLayout
  title={`Resume - ${h.name}`}
  description={`${h.name}, ${h.role}. ${h.focus.join(', ')}.`}
  terminal="Captain's Quarters"
  type="website"
  jsonLdType="person"
  jsonHref="/resume.json"
  author={h.name}
>
  <article class="resume">
    <section class="read-hero wrap">
      <div>
        <p class="eyebrow"><span class="status-dot"></span> Resume / {h.focus.join(' / ')}</p>
        <h1 class="read-title">{h.name}</h1>
        <p class="read-lede" set:html={renderEmphasis(h.summary)} />
        <ul class="read-meta">
          {contactItems.map((c) => (
            <li class="tag">{c.href ? <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{c.label}</a> : c.label}</li>
          ))}
        </ul>
      </div>
      <figure class="cover panel">
        <header><h2><img src="/atlas/assets/ui/icon_credential.png" alt="" class="px" width="16" height="16" /> Crew record</h2><span>{h.role}</span></header>
        <div class="panel-body">
          <dl class="facts">
            <div><img src="/atlas/assets/ui/icon_status.png" alt="" class="px" width="16" height="16" /><dt>Role</dt><dd>{h.role}</dd></div>
            {current.map((e) => (
              <div><img src="/atlas/assets/ui/icon_quest_active.png" alt="" class="px" width="16" height="16" /><dt>Now</dt><dd>{e.title}, {e.company}</dd></div>
            ))}
            <div><img src="/atlas/assets/ui/icon_quests.png" alt="" class="px" width="16" height="16" /><dt>Roles held</dt><dd>{experiences.length + otherExperience.length}</dd></div>
            <div><img src="/atlas/assets/ui/icon_items.png" alt="" class="px" width="16" height="16" /><dt>Credentials</dt><dd>{certifications.length} certifications, {specializations.length} specializations</dd></div>
          </dl>
        </div>
        <footer class="resume-actions">
          <button type="button" class="solid-button" onclick="window.print()">Print</button>
          <a class="outline-button" href="/resume.json"><PixelGlyph name="braces" size={14} /> JSON</a>
        </footer>
      </figure>
    </section>

    <div class="read-grid read-grid--two wrap">
      <div class="read-body">
        <h2 id="experience">Experience</h2>
        {experiences.map((job) => (
          <section class="job" id={slug(job.company)}>
            <h3>{job.title}</h3>
            <p class="job-meta">
              <strong>{job.company}</strong>
              <span>{job.startDate} to {job.endDate ?? 'present'}</span>
              <span>{job.employmentType}</span>
              <span>{job.location}</span>
            </p>
            {job.context && <p class="job-context" set:html={renderEmphasis(job.context)} />}
            {job.bullets && (
              <ul>{job.bullets.map((b) => <li set:html={renderEmphasis(b)} />)}</ul>
            )}
            {job.governance && (
              <p class="job-gov">{job.governance.map((g) => <span class="tag">{g}</span>)}</p>
            )}
          </section>
        ))}

        <h2 id="earlier">Earlier roles</h2>
        <ul>
          {otherExperience.map((o) => <li><strong>{o.title}</strong>, {o.company} ({o.dates})</li>)}
        </ul>

        <h2 id="specializations">Specializations</h2>
        <ul class="spec-list">
          {specializations.map((s) => <li><strong>{s.title}</strong> <span>{s.org}</span></li>)}
        </ul>
      </div>

      <aside class="read-aside" aria-label="Skills and credentials">
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_quest_active.png" alt="" class="px" width="16" height="16" /> Core</h2><span>{coreCompetencies.length}</span></header>
          <div class="panel-body tag-cloud">{coreCompetencies.map((c) => <span class="tag citron">{c}</span>)}</div>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_items.png" alt="" class="px" width="16" height="16" /> Toolkit</h2><span>{techStack.length}</span></header>
          <div class="panel-body tag-cloud">{techStack.map((t) => <span class="tag">{t}</span>)}</div>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/props/logbook.png" alt="" class="px" width="16" height="16" /> Education</h2><span>{education.length}</span></header>
          <div class="panel-body">
            <dl class="facts">
              {education.map((e) => (
                <div><img src="/atlas/assets/ui/icon_credential.png" alt="" class="px" width="16" height="16" /><dt>{e.school}</dt><dd>{e.degree}<br /><small>{e.detail}</small></dd></div>
              ))}
            </dl>
          </div>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_credential.png" alt="" class="px" width="16" height="16" /> Certifications</h2><span>{certifications.length}</span></header>
          <div class="panel-body">
            <ul class="links plain">{certifications.map((c) => <li><PixelGlyph name="diamond" size={12} /> {c}</li>)}</ul>
          </div>
          <footer><a href="/resume.json">Read it as JSON ↗</a></footer>
        </section>
      </aside>
    </div>

    <nav class="read-rules wrap" aria-label="Keep browsing">
      <a href="/" data-return><span>01</span><strong>Return to ship</strong><p>Close this page and pick up where you left off.</p></a>
      <a href="/about/"><span>02</span><strong>About</strong><p>The story and how I work.</p></a>
      <a href="/portfolio/"><span>03</span><strong>Portfolio</strong><p>Design systems, apps, shows and sites.</p></a>
    </nav>
  </article>
</ReadingLayout>

<script is:inline>
  // /api/resume.pdf lands here with ?print=true.
  if (new URLSearchParams(location.search).get('print') === 'true') window.addEventListener('load', function () { window.print(); });
</script>
