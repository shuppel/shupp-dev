---
// Brain Gate, the browser extension, as a reading page.
import ReadingLayout from '../../layouts/ReadingLayout.astro';

const app = 'https://app.thoughtfulapp.co/braingate';
const features = [
  ['Progressive friction', 'Puzzles, time delays, and typing challenges add just enough friction to break automatic browsing habits.'],
  ['Customizable categories', 'Block social media, timewaster sites, adult content, or create your own custom categories.'],
  ['Smart scheduling', 'Set different blocking levels for work hours, evenings, and weekends.'],
  ['Privacy-first', 'All blocking happens locally. We never see your browsing history or the sites you visit.'],
];
const plans = [
  ['Monthly', '$3/mo', 'Full access to all features'],
  ['Yearly', '$28/yr', 'Save 22% with annual billing. Best value.'],
  ['TACo Club', 'Free', 'Included with TACo Club or Lifetime membership'],
];
---

<ReadingLayout
  title="Brain Gate"
  description="Block distractions and build better habits with Brain Gate browser extension. Progressive friction helps you reclaim your focus."
  terminal="The Workbench"
  type="website"
  jsonLdType="website"
>
  <article>
    <section class="read-hero wrap">
      <div>
        <p class="eyebrow"><span class="status-dot"></span> Browser extension / Thoughtful App Co.</p>
        <h1 class="read-title">Brain Gate</h1>
        <p class="read-lede">Block distractions. Build better habits. Instead of hard blocks you'll just disable, Brain Gate makes distracting sites slightly harder to reach, building your self-control muscle over time.</p>
        <div class="read-meta">
          <a class="solid-button" href={app}>Get Brain Gate ↗</a>
          <a class="outline-button" href="/brain-gate/privacy/">Privacy policy</a>
        </div>
      </div>
      <figure class="cover panel">
        <header><h2><img src="/atlas/assets/ui/icon_credential.png" alt="" class="px" width="16" height="16" /> Pricing</h2><span>Simple</span></header>
        <div class="panel-body">
          <dl class="facts">
            {plans.map(([k, price, note]) => (
              <div><img src="/atlas/assets/ui/icon_items.png" alt="" class="px" width="16" height="16" /><dt>{k}</dt><dd><strong>{price}</strong><br /><small>{note}</small></dd></div>
            ))}
          </dl>
        </div>
        <footer>Manage your account at <a href={app}>app.thoughtfulapp.co/braingate</a></footer>
      </figure>
    </section>

    <div class="read-grid read-grid--two wrap">
      <div class="read-body">
        <p>Brain Gate is a browser extension that helps you break free from addictive websites using progressive friction. Hard blocks fail because the off switch is one click away. A small, honest obstacle works better: it interrupts the habit without starting a fight with yourself.</p>
        <h2 id="how-it-works">How it works</h2>
        {features.map(([name, text]) => (<><h3>{name}</h3><p>{text}</p></>))}
        <h2 id="download">Download</h2>
        <p>Brain Gate is coming to the Chrome Web Store and Firefox Add-ons. Until then, you can manage your account and subscription at <a href={app}>app.thoughtfulapp.co/braingate</a>.</p>
      </div>
      <aside class="read-aside" aria-label="Get it">
        <section class="panel">
          <header><h2><img src="/atlas/assets/props/transmission.png" alt="" class="px" width="16" height="16" /> Stores</h2><span>Soon</span></header>
          <div class="panel-body tag-cloud">
            <span class="tag">Chrome Web Store, coming soon</span>
            <span class="tag">Firefox Add-ons, coming soon</span>
          </div>
        </section>
        <section class="panel">
          <header><h2><img src="/atlas/assets/ui/icon_quest_active.png" alt="" class="px" width="16" height="16" /> Your data</h2><span>Local</span></header>
          <div class="panel-body"><p style="margin: 0">Blocking happens on your device. We never see the sites you visit.</p></div>
          <footer><a href="/brain-gate/privacy/">Read the privacy policy ↗</a></footer>
        </section>
      </aside>
    </div>

    <nav class="read-rules wrap" aria-label="Keep browsing">
      <a href="/" data-return><span>01</span><strong>Return to ship</strong><p>Close this page and pick up where you left off.</p></a>
      <a href="/thoughtful-app-co/"><span>02</span><strong>Thoughtful App Co.</strong><p>More apps for humans.</p></a>
      <a href="/portfolio/"><span>03</span><strong>Portfolio</strong><p>Design systems, apps, shows and sites.</p></a>
    </nav>
  </article>
</ReadingLayout>
