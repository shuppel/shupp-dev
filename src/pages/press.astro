---
// The press index as a standalone page: the relay's broadcasts, newest first,
// with a JSON twin at /press.json. The game's Relay terminal is where people
// browse; this is the crawlable list behind it.
import { getCollection } from 'astro:content';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import PixelGlyph from '../components/Reading/PixelGlyph.astro';
import { PRESS_TYPE, pressUrl, youtube } from '../lib/reading/press';

const items = (await getCollection('press')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const byYear = new Map<number, typeof items>();
for (const n of items) byYear.set(n.data.pubDate.getUTCFullYear(), [...(byYear.get(n.data.pubDate.getUTCFullYear()) ?? []), n]);
const day = (d: Date) => d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });
const thumb = (n: (typeof items)[number]) => {
  const yt = youtube(n);
  return n.data.coverImage ?? (yt ? `https://i.ytimg.com/vi/${yt.id}/hqdefault.jpg` : null);
};
---

<ReadingLayout title="Press and broadcasts" description="Podcasts, videos, shorts and articles by Erikk Shupp, newest first." terminal="The Relay" type="website" jsonLdType="website" jsonHref="/press.json">
  <section class="index-hero wrap">
    <div>
      <p class="eyebrow"><span class="status-dot"></span> The Relay / {items.length} broadcasts</p>
      <h1 class="read-title">Press and broadcasts</h1>
    </div>
    <p>Episodes, videos, shorts and articles, picked up by the ship's relay. Each one opens on its own screen.</p>
  </section>

  <div class="wrap">
    {[...byYear].map(([year, list]) => (
      <section aria-labelledby={`y${year}`}>
        <h2 class="index-year" id={`y${year}`}>{year}</h2>
        <div class="index-grid">
          {list.map((n) => {
            const t = thumb(n);
            return (
              <a class="index-card panel" href={pressUrl(n.id)}>
                <header><h3 style="font: 600 13px/1.3 var(--sans); letter-spacing: 0"><img src="/atlas/assets/props/transmission.png" alt="" class="px" width="16" height="16" /> {PRESS_TYPE[n.data.type]?.label ?? n.data.type}</h3><span>{day(n.data.pubDate)}</span></header>
                {t && <div class="index-thumb"><img src={t} alt="" loading="lazy" decoding="async" /><span class="screen-scan" aria-hidden="true"></span>{youtube(n) && <span class="index-play" aria-hidden="true"><PixelGlyph name="arrow" size={14} /></span>}</div>}
                <div class="panel-body">
                  <h3>{n.data.title}</h3>
                  {!t && <p>{n.data.description}</p>}
                </div>
                <footer><span>{n.data.outlet ?? 'shupp.dev'}</span><PixelGlyph name="arrow" size={12} /></footer>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</ReadingLayout>
