# Feature Flags
# Enable TLDraw mockup embeds (default: false)
ENABLE_TLDRAW=false

# Screenshot Machine API
SCREENSHOT_MACHINE_API_KEY=your_api_key_here

# Spotify Podcast RSS Feed
# Get this from your Spotify for Podcasters dashboard
# Format: https://anchor.fm/s/XXXXXX/podcast/rss
SPOTIFY_RSS_URL=

# Social Feeds (powers /feed via scripts/sync-social-rss.ts)
# Bluesky has a native RSS feed and works out of the box (defaults to shupp.dev).
# X (Twitter) and TikTok have NO public RSS — point these at a third-party RSS
# bridge (e.g. rss.app, Nitter, RSSHub) for @KimJungUzi and @thoughtfulappco.
X_RSS_URL=
TIKTOK_RSS_URL=
BLUESKY_RSS_URL=https://bsky.app/profile/shupp.dev/rss